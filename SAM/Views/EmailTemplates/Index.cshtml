@model SAM.ViewModels.EmailTemplates.EmailTemplatesPageViewModel
@{
    ViewData["Title"] = "Email Templates";
    ViewData["PageSubtitle"] = "Manage HTML email templates and placeholders";
}

<div class="card">
    <div class="card-body">
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="list-group email-template-tabs">
                    @foreach (var template in Model.Templates)
                    {
                        var activeClass = template.TemplateKey == Model.TemplateEditor.TemplateKey ? "active" : string.Empty;
                        <a asp-action="Index"
                           asp-route-templateKey="@template.TemplateKey"
                           class="list-group-item list-group-item-action @activeClass">
                            <div class="fw-semibold">@template.DisplayName</div>
                            <small class="d-block @(activeClass == "active" ? "text-white-50" : "text-muted")">@template.Description</small>
                        </a>
                    }
                </div>
            </div>

            <div class="col-lg-8">
                <form asp-action="UpdateTemplate" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="TemplateEditor.TemplateKey" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-section">
                        <div class="form-section-title text-primary">
                            <i class="bi bi-pencil-square me-2"></i>@Model.TemplateEditor.DisplayName
                        </div>

                        <div class="mb-3">
                            <div class="form-text mt-0">@Model.TemplateEditor.Description</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TemplateEditor.SubjectTemplate" class="form-label required">Subject</label>
                            <input asp-for="TemplateEditor.SubjectTemplate" class="form-control" />
                            <span asp-validation-for="TemplateEditor.SubjectTemplate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TemplateEditor.BodyTemplate" class="form-label required">Body (HTML allowed)</label>
                            <textarea asp-for="TemplateEditor.BodyTemplate" class="form-control font-monospace" rows="20"></textarea>
                            <span asp-validation-for="TemplateEditor.BodyTemplate" class="text-danger"></span>
                        </div>

                        @if (Model.TemplateEditor.AllowedTokens.Any())
                        {
                            <div class="mb-3">
                                <label class="form-label">Available placeholders:</label>
                                <div class="email-template-placeholders">
                                    @string.Join(", ", Model.TemplateEditor.AllowedTokens)
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" id="previewTemplateBtn">
                            <i class="bi bi-eye me-1"></i>Preview
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>Save Template
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="emailTemplatePreviewModal" tabindex="-1" aria-labelledby="emailTemplatePreviewLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="emailTemplatePreviewLabel"><i class="bi bi-envelope-paper me-2"></i>Email Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Subject</label>
                    <div id="emailPreviewSubject" class="form-control bg-light"></div>
                </div>
                <div>
                    <label class="form-label fw-semibold">Body</label>
                    <iframe id="emailPreviewFrame" class="w-100 border rounded ui-min-h-460"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const previewBtn = document.getElementById('previewTemplateBtn');
            const modalElement = document.getElementById('emailTemplatePreviewModal');
            const subjectInput = document.getElementById('TemplateEditor_SubjectTemplate');
            const bodyInput = document.getElementById('TemplateEditor_BodyTemplate');
            const keyInput = document.getElementById('TemplateEditor_TemplateKey');
            const previewSubject = document.getElementById('emailPreviewSubject');
            const previewFrame = document.getElementById('emailPreviewFrame');

            if (!previewBtn || !modalElement || !subjectInput || !bodyInput || !keyInput || !previewSubject || !previewFrame) {
                return;
            }

            function getSampleTokens(templateKey) {
                switch (templateKey) {
                    case 'password_reset':
                        return {
                            AppName: 'SAM',
                            ResetLink: 'https://sam.local/Account/ResetPassword?token=sample-token',
                            RecipientEmail: 'user@example.com'
                        };
                    case 'user_credentials':
                        return {
                            AppName: 'SAM',
                            RecipientEmail: 'new.user@example.com',
                            TemporaryPassword: 'TempPass!123',
                            CompanyName: 'Acme Environmental',
                            RoleName: 'Operator'
                        };
                    case 'smtp_test':
                        return {
                            AppName: 'SAM',
                            RecipientEmail: 'admin@example.com',
                            SentAtUtc: new Date().toISOString()
                        };
                    case 'company_request_approved':
                        return {
                            AppName: 'SAM',
                            RecipientEmail: 'admin@example.com',
                            CompanyName: 'Acme Environmental',
                            TemporaryPassword: 'TempPass!123',
                            RoleName: 'Company Administrator'
                        };
                    case 'company_request_rejected':
                        return {
                            AppName: 'SAM',
                            RecipientEmail: 'admin@example.com',
                            CompanyName: 'Acme Environmental',
                            RejectionReason: 'Incomplete documentation provided.'
                        };
                    case 'user_request_rejected':
                        return {
                            AppName: 'SAM',
                            RecipientEmail: 'user@example.com',
                            CompanyName: 'Acme Environmental',
                            RejectionReason: 'Request does not meet access criteria.'
                        };
                    default:
                        return { AppName: 'SAM' };
                }
            }

            function applyTokens(content, tokenMap) {
                return (content || '').replace(/\{\{([A-Za-z0-9_]+)\}\}/g, function (match, tokenName) {
                    return Object.prototype.hasOwnProperty.call(tokenMap, tokenName)
                        ? tokenMap[tokenName]
                        : match;
                });
            }

            previewBtn.addEventListener('click', function () {
                const tokens = getSampleTokens(keyInput.value);
                const renderedSubject = applyTokens(subjectInput.value, tokens);
                const renderedBody = applyTokens(bodyInput.value, tokens);

                previewSubject.textContent = renderedSubject || '(No subject)';
                previewFrame.srcdoc = renderedBody || '<p>No body content.</p>';

                const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.show();
            });
        })();
    </script>
}
