@model SAM.ViewModels.SystemSettings.SmtpSettingsViewModel
@{
    ViewData["Title"] = "System Settings";
    ViewData["PageSubtitle"] = "Manage global SMTP configuration";
}

@section PageTitleExtra {
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
}

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-envelope-gear me-2"></i>SMTP Settings</h5>
            </div>
            <div class="card-body">
                <form asp-action="Settings" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-section">

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="Host" class="form-label required"></label>
                                <input asp-for="Host" class="form-control" placeholder="smtp.example.com" />
                                <span asp-validation-for="Host" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Port" class="form-label required"></label>
                                <input asp-for="Port" class="form-control" />
                                <span asp-validation-for="Port" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label"></label>
                                <input asp-for="Username" class="form-control" />
                                <span asp-validation-for="Username" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FromEmail" class="form-label required"></label>
                                <input asp-for="FromEmail" class="form-control" />
                                <span asp-validation-for="FromEmail" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                                @if (Model.HasPasswordConfigured)
                                {
                                    <div class="form-text">Leave blank to keep the existing SMTP password.</div>
                                }
                                else
                                {
                                    <div class="form-text">Password is required for first-time SMTP setup.</div>
                                }
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="EnableSsl" class="form-check-input" />
                                    <label asp-for="EnableSsl" class="form-check-label"></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i>Save Settings
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-send-check me-2"></i>SMTP Test Email</h5>
            </div>
            <div class="card-body">
                <form asp-action="SendTestEmail" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-section">
                        <label class="form-label required" for="testEmail">Test Recipient Email</label>
                        <div class="row g-2 align-items-center">
                            <div class="col-md-12 col-xl-12">
                                <input type="email" id="testEmail" name="testEmail" class="form-control" placeholder="name@example.com" required />
                            </div>
                            <div class="col-md-6 col-xl-6 d-grid">
                                <button type="submit" class="btn btn-outline-primary">
                                    <i class="bi bi-send me-1"></i>Send Test Email
                                </button>
                            </div>
                        </div>
                        <div class="form-text mt-2">A test message will be sent using the currently saved SMTP settings.</div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
