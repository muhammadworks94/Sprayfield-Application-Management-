@model SAM.ViewModels.SystemSettings.SmtpSettingsViewModel
@{
    ViewData["Title"] = "System Settings";
    ViewData["PageSubtitle"] = "Manage global SMTP configuration";
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-envelope-gear me-2"></i>SMTP Settings</h5>
    </div>
    <div class="card-body">
        <form asp-action="Email" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-8">
                    <label asp-for="Host" class="form-label required"></label>
                    <input asp-for="Host" class="form-control" placeholder="smtp.example.com" />
                    <span asp-validation-for="Host" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Port" class="form-label required"></label>
                    <input asp-for="Port" class="form-control" />
                    <span asp-validation-for="Port" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FromEmail" class="form-label required"></label>
                    <input asp-for="FromEmail" class="form-control" />
                    <span asp-validation-for="FromEmail" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-8">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    @if (Model.HasPasswordConfigured)
                    {
                        <div class="form-text">Leave blank to keep the existing SMTP password.</div>
                    }
                    else
                    {
                        <div class="form-text">Password is required for first-time SMTP setup.</div>
                    }
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check form-switch mb-2">
                        <input asp-for="EnableSsl" class="form-check-input" />
                        <label asp-for="EnableSsl" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1"></i>Save Settings
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
