@model SAM.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var isGlobalAdmin = Model.IsGlobalAdmin;
    var canManageUsers = Model.CanManageUsers;
    var roleViewLabel = Model.RoleViewLabel;
    var selectedCompanyName = Model.SelectedCompanyName;
    var complianceTotal = Model.IrrigationCompliance.CompliantCount + Model.IrrigationCompliance.UnderReviewCount + Model.IrrigationCompliance.NonCompliantCount;
    var hasComplianceData = complianceTotal > 0;
    var hasOperationalData = Model.OperationalEfficiencyByDate.Any();
    var hasWastewaterData = Model.WastewaterTrends.Any();
    var hasGroundwaterChartData = Model.GroundwaterOverview.ByWell.Any(x => x.PH.HasValue);
}



@section PageTitleExtra {
    @if (!string.IsNullOrEmpty(roleViewLabel))
    {
        <a asp-controller="Dashboard" asp-action="Index" class="text-primary small text-decoration-none">@roleViewLabel</a>
    }
}

<div class="dashboard-modern">
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        @if (canManageUsers && Model.PendingUserRequests > 0)
        {
            <a asp-controller="UserManagement" asp-action="UserRequests" class="btn btn-warning">
                <i class="bi bi-exclamation-circle"></i> @Model.PendingUserRequests Pending User Request(s)
            </a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100 border-0 rounded-3 dashboard-kpi-card dashboard-animate-in">
            <div class="card-body">
                <div class="dashboard-kpi-icon bg-primary bg-opacity-10 rounded-3 p-2">
                    <i class="bi bi-building fs-5 text-primary"></i>
                </div>
                <div class="stat-label">Facilities</div>
                <div class="stat-value">@Model.TotalFacilities</div>
                <div class="stat-desc">Active treatment facilities</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100 border-0 rounded-3 dashboard-kpi-card dashboard-animate-in">
            <div class="card-body">
                <div class="dashboard-kpi-icon bg-success bg-opacity-10 rounded-3 p-2">
                    <i class="bi bi-grid-3x3-gap fs-5 text-success"></i>
                </div>
                <div class="stat-label">Sprayfields</div>
                <div class="stat-value">@Model.TotalSprayfields</div>
                <div class="stat-desc">@Model.TotalSprayfieldAcres.ToString("F1") total acres</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100 border-0 rounded-3 dashboard-kpi-card dashboard-animate-in">
            <div class="card-body">
                <div class="dashboard-kpi-icon bg-info bg-opacity-10 rounded-3 p-2">
                    <i class="bi bi-geo-alt fs-5 text-info"></i>
                </div>
                <div class="stat-label">Monitoring Wells</div>
                <div class="stat-value">@Model.TotalMonitoringWells</div>
                <div class="stat-desc">Groundwater monitoring points</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100 border-0 rounded-3 dashboard-kpi-card dashboard-animate-in">
            <div class="card-body">
                <div class="dashboard-kpi-icon bg-warning bg-opacity-10 rounded-3 p-2">
                    <i class="bi bi-calendar3 fs-5 text-warning"></i>
                </div>
                <div class="stat-label">Recent Activity</div>
                <div class="stat-value">@Model.RecentActivityCount</div>
                <div class="stat-desc">Irrigation events (last 10)</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card dashboard-chart-card h-100 dashboard-animate-in">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-droplet me-2"></i>Wastewater Monitoring Trends
                </h5>
                @if (hasWastewaterData)
                {
                    <div class="dashboard-chart-wrap">
                        <canvas id="chartWastewaterTrends"></canvas>
                    </div>
                    <div class="mt-2 d-flex flex-wrap gap-3 small">
                        <span class="d-inline-flex align-items-center gap-1">
                            <i class="bi bi-diamond text-danger"></i> Avg BOD5 (mg/L)
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <i class="bi bi-circle-fill text-primary"></i> Avg TSS (mg/L)
                        </span>
                    </div>
                }
                else
                {
                    <div class="dashboard-empty-state">
                        <i class="bi bi-inbox me-2"></i>No wastewater monitoring data available.
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card dashboard-chart-card h-100 dashboard-animate-in">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-funnel me-2"></i>Groundwater Quality Overview
                </h5>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="dashboard-metric-box dashboard-metric-box-blue rounded-3 p-3">
                            <div class="text-muted small">Average pH</div>
                            <div class="fw-bold fs-4 text-primary">@(Model.GroundwaterOverview.AvgPH?.ToString("F2") ?? "N/A")</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="dashboard-metric-box dashboard-metric-box-green rounded-3 p-3">
                            <div class="text-muted small">Avg Conductivity (uS/cm)</div>
                            <div class="fw-bold fs-4 text-success">@(Model.GroundwaterOverview.AvgConductivity?.ToString("F0") ?? "N/A")</div>
                        </div>
                    </div>
                </div>
                @if (hasGroundwaterChartData)
                {
                    <div class="dashboard-chart-wrap">
                        <canvas id="chartGroundwaterOverview"></canvas>
                    </div>
                }
                else
                {
                    <div class="dashboard-empty-state">
                        <i class="bi bi-inbox me-2"></i>No groundwater readings available.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card dashboard-chart-card h-100 dashboard-animate-in">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-check-circle text-success me-2"></i>Irrigation Compliance Status
                </h5>
                @if (hasComplianceData)
                {
                    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between">
                        <div class="dashboard-chart-wrap d-flex align-items-center justify-content-center flex-shrink-0">
                            <div class="position-relative ui-chart-ring-180">
                                <canvas id="chartIrrigationCompliance" width="180" height="180"></canvas>
                                <div id="complianceCenterLabel" class="position-absolute top-50 start-50 translate-middle text-center compliance-center-label">
                                    <span class="fw-bold fs-6 ui-accent-teal">Compliant @Model.IrrigationCompliance.CompliantPercent.ToString("F0")%</span>
                                </div>
                            </div>
                        </div>
                        <div class="dashboard-summary-box p-3 text-center ms-md-3 mt-3 mt-md-0">
                            <div class="text-muted small">Compliant</div>
                            <div class="fw-bold fs-4">@Model.IrrigationCompliance.CompliantCount</div>
                            <div class="text-muted small">(@Model.IrrigationCompliance.CompliantPercent.ToString("F0")%)</div>
                        </div>
                    </div>
                    <div class="mt-3 d-flex align-items-center gap-2">
                        <span class="d-inline-block rounded-1 dashboard-legend-normal ui-square-12"></span>
                        <span class="small">Compliant</span>
                    </div>
                }
                else
                {
                    <div class="dashboard-empty-state">
                        <i class="bi bi-inbox me-2"></i>No irrigation compliance reports in the last 30 days.
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card dashboard-chart-card h-100 dashboard-animate-in">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-graph-up-arrow me-2"></i>Operational Efficiency Indicators
                </h5>
                <div class="dashboard-uptime-strip p-3 mb-3">
                    <div class="text-muted small">System Uptime</div>
                    <div class="fw-bold fs-4 ui-accent-teal">@Model.SystemUptimePercent.ToString("F1")%</div>
                    <div class="text-muted small">Based on normal operational status</div>
                </div>
                @if (hasOperationalData)
                {
                    <div class="dashboard-chart-wrap dashboard-chart-wrap-tall">
                        <canvas id="chartOperationalEfficiency"></canvas>
                    </div>
                    <div class="mt-2 d-flex flex-wrap gap-3 small">
                        <span class="d-inline-flex align-items-center gap-1">
                            <span class="rounded-1 dashboard-legend-normal ui-square-10"></span> Normal
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <span class="rounded-1 bg-warning ui-square-10"></span> Alert
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <span class="rounded-1 bg-info ui-square-10"></span> Maintenance
                        </span>
                    </div>
                }
                else
                {
                    <div class="dashboard-empty-state">
                        <i class="bi bi-inbox me-2"></i>No operational efficiency trend data available.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card dashboard-chart-card h-100 dashboard-animate-in">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-journal-text me-2"></i>Recent Activity
                </h5>
                @if (Model.RecentActivities.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var activity in Model.RecentActivities)
                        {
                            <li class="d-flex justify-content-between align-items-start py-2 @(activity != Model.RecentActivities.Last() ? "border-bottom border-light" : "")">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold text-dark">@activity.Description</div>
                                    <div class="small text-muted mt-1">@activity.Date.ToString("dd/MM/yyyy")</div>
                                </div>
                                <span class="dashboard-status-tag dashboard-status-tag-dark rounded px-2 py-1 small ms-2 flex-shrink-0">Completed</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small mb-0">No recent activity.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card dashboard-chart-card h-100 dashboard-animate-in">
            <div class="card-body">
                <h5 class="fw-semibold mb-3">
                    <i class="bi bi-exclamation-triangle text-warning me-2"></i>System Status
                </h5>
                @if (Model.SystemStatuses.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var sys in Model.SystemStatuses)
                        {
                            <li class="d-flex justify-content-between align-items-center py-2 @(sys != Model.SystemStatuses.Last() ? "border-bottom border-light" : "")">
                                <span class="text-dark">@sys.SystemName</span>
                                <span class="@(sys.IsNormalOrOperational ? "dashboard-status-tag-dark" : "dashboard-status-tag-light") dashboard-status-tag rounded px-2 py-1 small flex-shrink-0 ms-2">@sys.Status</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="dashboard-empty-state">
                        <i class="bi bi-inbox me-2"></i>No system status data available.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function() {
            const primaryColor = '#2563eb';
            const dangerColor = '#dc3545';
            const warningColor = '#fd7e14';
            const greenTeal = '#14b8a6';
            const complianceCenterLabel = document.getElementById('complianceCenterLabel');

            if (window.Chart?.Tooltip?.positioners && !window.Chart.Tooltip.positioners.donutOutside) {
                window.Chart.Tooltip.positioners.donutOutside = function(items) {
                    if (!items || items.length === 0) {
                        return false;
                    }

                    const firstItem = items[0];
                    const point = firstItem.element?.tooltipPosition?.();
                    if (!point) {
                        return false;
                    }

                    const chart = firstItem.chart;
                    const chartArea = chart?.chartArea;
                    const centerX = chartArea ? (chartArea.left + chartArea.right) / 2 : point.x;
                    const centerY = chartArea ? (chartArea.top + chartArea.bottom) / 2 : point.y;

                    let dx = point.x - centerX;
                    let dy = point.y - centerY;
                    const distance = Math.hypot(dx, dy) || 1;
                    const offset = 44;

                    dx /= distance;
                    dy /= distance;

                    return {
                        x: point.x + dx * offset,
                        y: point.y + dy * offset
                    };
                };
            }

            document.addEventListener('DOMContentLoaded', function() {
                const compliantPercent = @Model.IrrigationCompliance.CompliantPercent;
                const underReviewPercent = @Model.IrrigationCompliance.UnderReviewPercent;
                const nonCompliantPercent = @Model.IrrigationCompliance.NonCompliantPercent;
                const totalPie = compliantPercent + underReviewPercent + nonCompliantPercent;
                const complianceChart = document.getElementById('chartIrrigationCompliance');

                if (complianceChart && totalPie > 0) {
                    const centerLabelVisibilityPlugin = {
                        id: 'centerLabelVisibilityPlugin',
                        afterEvent(chart) {
                            if (!complianceCenterLabel) {
                                return;
                            }

                            // Hide center label whenever a doughnut segment is actively hovered.
                            const hasActiveSegment = chart.getActiveElements().length > 0;
                            complianceCenterLabel.style.opacity = hasActiveSegment ? '0' : '1';
                        }
                    };

                    new Chart(complianceChart, {
                        type: 'doughnut',
                        data: {
                            labels: ['Compliant', 'Under Review', 'Non-Compliant'],
                            datasets: [{
                                data: [compliantPercent, underReviewPercent, nonCompliantPercent],
                                backgroundColor: [greenTeal, warningColor, dangerColor],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            cutout: '70%',
                            responsive: true,
                            maintainAspectRatio: true,
                            interaction: {
                                mode: 'nearest',
                                intersect: true
                            },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    position: 'donutOutside'
                                }
                            }
                        },
                        plugins: [centerLabelVisibilityPlugin]
                    });

                    // Ensure label always restores when pointer leaves chart area.
                    complianceChart.addEventListener('mouseleave', function() {
                        if (complianceCenterLabel) {
                            complianceCenterLabel.style.opacity = '1';
                        }
                    });
                }

                const effDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OperationalEfficiencyByDate?.Select(x => x.DateLabel).ToList() ?? new List<string>()));
                const effValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OperationalEfficiencyByDate?.Select(x => x.Value).ToList() ?? new List<double>()));
                const operationalChart = document.getElementById('chartOperationalEfficiency');
                if (operationalChart && effDates && effDates.length > 0) {
                    new Chart(operationalChart, {
                        type: 'bar',
                        data: {
                            labels: effDates,
                            datasets: [{
                                label: 'Uptime',
                                data: effValues,
                                backgroundColor: greenTeal,
                                borderWidth: 0
                            }]
                        },
                        options: {
                            indexAxis: 'x',
                            scales: {
                                y: {
                                    min: 0,
                                    max: 1,
                                    ticks: { stepSize: 0.25 },
                                    grid: { color: 'rgba(0,0,0,0.08)', borderDash: [4, 2] }
                                },
                                x: {
                                    grid: { display: true, color: 'rgba(0,0,0,0.08)', borderDash: [4, 2] }
                                }
                            },
                            plugins: { legend: { display: false } },
                            responsive: true,
                            maintainAspectRatio: false
                        }
                    });
                }

                const wwPeriods = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WastewaterTrends?.Select(x => x.PeriodLabel).ToList() ?? new List<string>()));
                const wwBod5 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WastewaterTrends?.Select(x => x.AvgBOD5 ?? 0m).ToList() ?? new List<decimal>()));
                const wwTss = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WastewaterTrends?.Select(x => x.AvgTSS ?? 0m).ToList() ?? new List<decimal>()));
                const wastewaterChart = document.getElementById('chartWastewaterTrends');
                if (wastewaterChart && wwPeriods && wwPeriods.length > 0) {
                    new Chart(wastewaterChart, {
                        type: 'line',
                        data: {
                            labels: wwPeriods,
                            datasets: [
                                { label: 'Avg BOD5 (mg/L)', data: wwBod5, borderColor: dangerColor, backgroundColor: 'transparent', pointStyle: 'diamond', pointRadius: 5, tension: 0.2 },
                                { label: 'Avg TSS (mg/L)', data: wwTss, borderColor: primaryColor, backgroundColor: 'transparent', pointStyle: 'circle', pointRadius: 5, tension: 0.2 }
                            ]
                        },
                        options: {
                            scales: {
                                y: { min: 0, suggestedMax: 16, grid: { color: 'rgba(0,0,0,0.06)' } },
                                x: { grid: { color: 'rgba(0,0,0,0.06)' } }
                            },
                            plugins: { legend: { display: false } },
                            responsive: true,
                            maintainAspectRatio: false
                        }
                    });
                }

                const gwWells = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GroundwaterOverview?.ByWell?.Where(x => x.PH.HasValue).Select(x => x.WellId).ToList() ?? new List<string>()));
                const gwPh = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GroundwaterOverview?.ByWell?.Where(x => x.PH.HasValue).Select(x => x.PH!.Value).ToList() ?? new List<decimal>()));
                const groundwaterChart = document.getElementById('chartGroundwaterOverview');
                if (groundwaterChart && gwWells && gwWells.length > 0) {
                    new Chart(groundwaterChart, {
                        type: 'bar',
                        data: {
                            labels: gwWells,
                            datasets: [{ label: 'pH', data: gwPh, backgroundColor: primaryColor, borderWidth: 0 }]
                        },
                        options: {
                            indexAxis: 'x',
                            scales: {
                                y: { min: 0, max: 8, ticks: { stepSize: 2 }, grid: { color: 'rgba(0,0,0,0.06)' } },
                                x: { grid: { display: false } }
                            },
                            plugins: { legend: { display: false } },
                            responsive: true,
                            maintainAspectRatio: false
                        }
                    });
                }
            });
        })();
    </script>
}


