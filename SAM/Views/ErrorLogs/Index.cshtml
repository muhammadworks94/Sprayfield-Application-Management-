@model SAM.ViewModels.ErrorLogs.ErrorLogsIndexViewModel
@{
    ViewData["Title"] = "Error Logs";
    ViewData["PageSubtitle"] = "Admin timeline for middleware-observed exceptions";
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">User</label>
                <select name="ActorUserId" class="form-select" asp-items="Model.Actors">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Module</label>
                <select name="Module" class="form-select" asp-items="Model.Modules">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Exception Type</label>
                <select name="ExceptionType" class="form-select" asp-items="Model.ExceptionTypes">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Status Code</label>
                <select name="StatusCode" class="form-select" asp-items="Model.StatusCodes">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input name="SearchTerm" class="form-control" value="@Model.Filter.SearchTerm" />
            </div>
            <div class="col-md-2">
                <label class="form-label">From (UTC)</label>
                <input type="date" name="FromUtc" class="form-control" value="@(Model.Filter.FromUtc?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label">To (UTC)</label>
                <input type="date" name="ToUtc" class="form-control" value="@(Model.Filter.ToUtc?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Page Size</label>
                <select name="PageSize" class="form-select">
                    @foreach (var size in new[] { 25, 50, 100, 200 })
                    {
                        if (Model.Filter.PageSize == size)
                        {
                            <option value="@size" selected>@size</option>
                        }
                        else
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">Apply</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
            <input type="hidden" name="Page" value="1" />
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Occurred (UTC)</th>
                        <th>Status</th>
                        <th>User</th>
                        <th>Company</th>
                        <th>Module / Path</th>
                        <th>Exception</th>
                        <th>Message</th>
                        <th>Request Id</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Logs.Items.Any())
                {
                    foreach (var log in Model.Logs.Items)
                    {
                        <tr>
                            <td>@log.OccurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><span class="badge bg-danger">@log.StatusCode</span></td>
                            <td>@(!string.IsNullOrWhiteSpace(log.ActorDisplayName) ? log.ActorDisplayName : (log.ActorEmail ?? "N/A"))</td>
                            <td>@log.CompanyName</td>
                            <td>
                                <div>@log.Module</div>
                                <small class="text-muted">@log.Path</small>
                            </td>
                            <td>@log.ExceptionType</td>
                            <td>@log.Message</td>
                            <td><code>@log.RequestId</code></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No error logs found.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    var totalPages = Model.Logs.TotalPages;
    var currentPage = Model.Logs.Page;
}

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@pageNumber"
                       asp-route-pageSize="@Model.Filter.PageSize"
                       asp-route-actorUserId="@Model.Filter.ActorUserId"
                       asp-route-module="@Model.Filter.Module"
                       asp-route-exceptionType="@Model.Filter.ExceptionType"
                       asp-route-statusCode="@Model.Filter.StatusCode"
                       asp-route-fromUtc="@Model.Filter.FromUtc?.ToString("o")"
                       asp-route-toUtc="@Model.Filter.ToUtc?.ToString("o")"
                       asp-route-searchTerm="@Model.Filter.SearchTerm">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}

