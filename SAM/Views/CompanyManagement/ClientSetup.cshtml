@model SAM.ViewModels.CompanyManagement.ClientSetupViewModel

@using System.Globalization

@{

    ViewData["Title"] = "Client Setup";

    ViewData["PageSubtitle"] = "Enter historical monthly loading (inches) for sprayfields before operational SAM data exists.";

    var effectiveCompanyId = ViewBag.EffectiveCompanyId as Guid?;

    var hasCompany = effectiveCompanyId.HasValue;

    string FormatLoadingInches(decimal? value) =>
        value.HasValue
            ? Math.Round(value.Value, 2, MidpointRounding.AwayFromZero).ToString("0.##", CultureInfo.InvariantCulture)
            : string.Empty;

}



@section PageTitleExtra {

    <a asp-action="Index" asp-route-tab="companies" class="btn btn-sm btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>Back to Companies

    </a>

}



@if (TempData["SuccessMessage"] != null)

{

    <div class="alert alert-success alert-dismissible fade show" role="alert">

        @TempData["SuccessMessage"]

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

    </div>

}

@if (TempData["ErrorMessage"] != null)

{

    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        @TempData["ErrorMessage"]

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

    </div>

}



@if (!hasCompany)

{

    <div class="alert alert-info mb-4">

        <i class="bi bi-building me-1"></i>

        Select a company from the header to load facilities.

    </div>

}



<div class="card mb-4">

    <div class="card-header">

        <h5 class="mb-0"><i class="bi bi-funnel"></i> Selection</h5>

    </div>

    <div class="card-body">

        <form asp-action="ClientSetup" method="get" class="row g-3 align-items-end">

            <div class="col-md-6">

                <label class="form-label">Facility</label>

                <select name="facilityId" id="clientSetupFacilityId" class="form-select" asp-items="ViewBag.Facilities" disabled="@(!hasCompany)">

                    <option value="">Select facility...</option>

                </select>

            </div>

            <div class="col-md-3">

                <label class="form-label">Through Year</label>

                <input type="number" name="throughYear" class="form-control" value="@Model.ThroughYear" min="2000" max="2100" />

            </div>

            <div class="col-md-3">

                <label class="form-label">Through Month</label>

                <select name="throughMonth" class="form-select" asp-items="ViewBag.Months"></select>

            </div>

            <div class="col-md-6">

                <button type="submit" class="btn btn-sm btn-primary" disabled="@(!hasCompany)">

                    <i class="bi bi-arrow-repeat"></i> Load Grid

                </button>

            </div>

        </form>

    </div>

</div>



@if (Model.FacilityId != Guid.Empty && Model.SprayfieldColumns.Count > 0)

{

    <div class="alert alert-info">

        <i class="bi bi-info-circle me-1"></i>

        Baseline values are used for rolling totals and NDAR reports until real operational data (<strong>VolumeGallons &gt; 0</strong>) is entered for a month.

        Cells with SAM data are read-only and cannot be overwritten.

    </div>



    <form asp-action="ClientSetup" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="CompanyId" />

        <input type="hidden" asp-for="FacilityId" />

        <input type="hidden" asp-for="ThroughYear" />

        <input type="hidden" asp-for="ThroughMonth" />



        <div class="card">

            <div class="card-header d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="bi bi-table"></i>

                    @Model.FacilityName

                    <span class="text-muted fw-normal">— 12 months through @Model.MonthRows.FirstOrDefault()?.Label</span>

                </h5>

            </div>

            <div class="card-body p-0">

                <div class="table-responsive responsive-table wide-data-table wwchar-daily-table-wrapper fixed-height-table-wrapper mb-0">

                    <table class="table table-bordered table-sm wwchar-daily-table" id="clientSetupBaselineTable">

                        <thead>

                            <tr>

                                <th>Month</th>

                                @for (var col = 0; col < Model.SprayfieldColumns.Count; col++)

                                {

                                    var column = Model.SprayfieldColumns[col];

                                    <th>

                                        <div class="fw-semibold">@column.FieldCode</div>

                                        @if (column.Acres.HasValue)

                                        {

                                            <div class="small text-muted fw-normal">@column.Acres.Value.ToString("0.##") ac</div>

                                        }

                                    </th>

                                }

                            </tr>

                        </thead>

                        <tbody>

                            @for (var row = 0; row < Model.MonthRows.Count; row++)

                            {

                                var monthRow = Model.MonthRows[row];

                                <tr>

                                    <th scope="row"><strong>@monthRow.Label</strong></th>

                                    @for (var col = 0; col < monthRow.Cells.Count; col++)

                                    {

                                        var cell = monthRow.Cells[col];

                                        <td class="client-setup-data-cell@(cell.IsReadOnly ? " client-setup-sam-cell" : "")">

                                            <input type="hidden" asp-for="MonthRows[row].Year" />

                                            <input type="hidden" asp-for="MonthRows[row].Month" />

                                            <input type="hidden" asp-for="MonthRows[row].Cells[col].SprayfieldId" />

                                            @if (cell.IsReadOnly)

                                            {

                                                <input type="hidden" asp-for="MonthRows[row].Cells[col].LoadingInches" />

                                                <div class="client-setup-sam-content">

                                                    <span class="client-setup-sam-value">@FormatLoadingInches(cell.LoadingInches)</span>

                                                    <span class="badge bg-success client-setup-sam-badge">SAM data</span>

                                                </div>

                                            }

                                            else

                                            {

                                                <input name="MonthRows[@row].Cells[@col].LoadingInches"

                                                       id="@Html.IdFor(m => m.MonthRows[row].Cells[col].LoadingInches)"

                                                       value="@FormatLoadingInches(cell.LoadingInches)"

                                                       class="form-control form-control-sm"

                                                       type="number"

                                                       step="0.01"

                                                       min="0"

                                                       title="@(cell.Source == "Baseline" ? "Saved baseline value" : null)" />

                                            }

                                        </td>

                                    }

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <div class="card-footer d-flex gap-2">

                <button type="submit" name="submitAction" value="save" class="btn btn-primary">

                    <i class="bi bi-save"></i> Save

                </button>

                <button type="submit" name="submitAction" value="saveAndRefresh" class="btn btn-outline-primary">

                    <i class="bi bi-arrow-clockwise"></i> Save and Refresh NDAR

                </button>

            </div>

        </div>

    </form>

}

else if (Model.FacilityId != Guid.Empty)

{

    <div class="alert alert-warning mb-0">

        <i class="bi bi-exclamation-triangle me-1"></i>

        No sprayfields found for this facility. Add sprayfields in System Administration first.

    </div>

}



@section Scripts {

    <script>

        (function () {

            const facilitySelect = document.getElementById('clientSetupFacilityId');

            if (!facilitySelect) return;



            const hasCompany = @hasCompany.ToString().ToLowerInvariant();

            const facilitiesUrl = '@Url.Action("GetFacilitiesForClientSetup", "CompanyManagement")';

            const selectedFacility = '@Model.FacilityId';

            const emptyGuid = '00000000-0000-0000-0000-000000000000';



            const setFacilityOptions = (facilities, preserveFacilityId) => {

                const currentValue = preserveFacilityId || facilitySelect.value;

                facilitySelect.innerHTML = '<option value="">Select facility...</option>';

                facilities.forEach(f => {

                    const option = document.createElement('option');

                    option.value = f.id;

                    option.textContent = f.name;

                    if (currentValue && currentValue.toLowerCase() === String(f.id).toLowerCase()) {

                        option.selected = true;

                    }

                    facilitySelect.appendChild(option);

                });

            };



            const loadFacilities = async (preserveFacilityId) => {

                if (!hasCompany) {

                    setFacilityOptions([]);

                    facilitySelect.disabled = true;

                    return;

                }



                facilitySelect.disabled = true;

                facilitySelect.innerHTML = '<option value="">Loading facilities...</option>';



                try {

                    const response = await fetch(facilitiesUrl);

                    if (!response.ok) {

                        throw new Error('Failed to load facilities');

                    }



                    const facilities = await response.json();

                    setFacilityOptions(facilities, preserveFacilityId);

                } catch {

                    facilitySelect.innerHTML = '<option value="">Unable to load facilities</option>';

                } finally {

                    facilitySelect.disabled = !hasCompany;

                }

            };



            const hasServerFacilities = facilitySelect.options.length > 1;

            if (!hasServerFacilities) {

                const preserveFacility = selectedFacility !== emptyGuid ? selectedFacility : null;

                loadFacilities(preserveFacility);

            } else if (selectedFacility !== emptyGuid) {

                facilitySelect.value = selectedFacility;

            }

        })();

    </script>

}

