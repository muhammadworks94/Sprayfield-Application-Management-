@model SAM.ViewModels.CompanyManagement.NewClientSetupPage1ViewModel
@{
    ViewData["Title"] = "New Client Setup";
    ViewData["PageSubtitle"] = "Step 1 of 2 — Create a new client company.";
}

@section PageTitleExtra {
    <a asp-action="Index" asp-route-tab="companies" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Manage Companies
    </a>
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<form asp-action="NewClientSetup" method="post" id="newClientSetupForm">
    @Html.AntiForgeryToken()

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-building me-1"></i>Company</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="CompanyName" class="form-label"></label>
                    <input asp-for="CompanyName" class="form-control" autocomplete="organization" />
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="FirstReportingMonth" class="form-label"></label>
                    <select asp-for="FirstReportingMonth" class="form-select" asp-items="ViewBag.Months"></select>
                    <span asp-validation-for="FirstReportingMonth" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="FirstReportingYear" class="form-label"></label>
                    <input asp-for="FirstReportingYear" class="form-control" type="number" min="2000" max="2100" />
                    <span asp-validation-for="FirstReportingYear" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="form-text">
                        The first month SAM will be used for reports. Historical loading is entered for the 11 months before and including this month (12 months total).
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-diagram-3 me-1"></i>Facilities &amp; Fields</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="FacilityCount" class="form-label"></label>
                    <select asp-for="FacilityCount" class="form-select" id="facilityCountSelect">
                        @for (var n = 1; n <= 10; n++)
                        {
                            <option value="@n" selected="@(Model.FacilityCount == n)">@n</option>
                        }
                    </select>
                    <span asp-validation-for="FacilityCount" class="text-danger"></span>
                </div>
            </div>

            <div id="facilitySections"></div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="submit" class="btn btn-primary" id="continueButton">
            <i class="bi bi-arrow-right-circle me-1"></i>Continue to Baseline Loading
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const facilitySections = document.getElementById('facilitySections');
            const facilityCountSelect = document.getElementById('facilityCountSelect');
            const form = document.getElementById('newClientSetupForm');
            const initialFacilities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Facilities));

            const buildFieldCountOptions = (selected) => {
                let html = '';
                for (let n = 1; n <= 150; n++) {
                    html += `<option value="${n}"${n === selected ? ' selected' : ''}>${n}</option>`;
                }
                return html;
            };

            const renderFacilities = () => {
                const count = parseInt(facilityCountSelect.value, 10) || 1;

                while (initialFacilities.length < count) {
                    const index = initialFacilities.length;
                    initialFacilities.push({
                        name: `Facility ${index + 1}`,
                        sprayfieldCount: 1
                    });
                }

                if (initialFacilities.length > count) {
                    initialFacilities.splice(count);
                }

                facilitySections.innerHTML = '';

                for (let i = 0; i < count; i++) {
                    const facility = initialFacilities[i];
                    const fieldCount = Math.min(150, Math.max(1, parseInt(facility.sprayfieldCount, 10) || 1));
                    facility.sprayfieldCount = fieldCount;

                    const section = document.createElement('div');
                    section.className = 'border rounded p-3 mb-3';
                    section.innerHTML = `
                        <h6 class="mb-3">Facility ${i + 1}</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="Facilities_${i}__Name">Facility Name</label>
                                <input class="form-control facility-name-input" id="Facilities_${i}__Name" name="Facilities[${i}].Name" value="${facility.name ?? ''}" data-index="${i}" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="Facilities_${i}__SprayfieldCount">Number of Fields</label>
                                <select class="form-select field-count-select" id="Facilities_${i}__SprayfieldCount" name="Facilities[${i}].SprayfieldCount" data-index="${i}">
                                    ${buildFieldCountOptions(fieldCount)}
                                </select>
                            </div>
                        </div>`;

                    facilitySections.appendChild(section);
                }

                bindSectionEvents();
            };

            const bindSectionEvents = () => {
                facilitySections.querySelectorAll('.facility-name-input').forEach(input => {
                    input.addEventListener('input', () => {
                        initialFacilities[input.dataset.index].name = input.value;
                    });
                });

                facilitySections.querySelectorAll('.field-count-select').forEach(select => {
                    select.addEventListener('change', () => {
                        const index = parseInt(select.dataset.index, 10);
                        initialFacilities[index].sprayfieldCount = parseInt(select.value, 10) || 1;
                    });
                });
            };

            facilityCountSelect.addEventListener('change', () => {
                const newCount = parseInt(facilityCountSelect.value, 10) || 1;
                const oldCount = initialFacilities.length;
                if (newCount < oldCount) {
                    const confirmed = window.confirm('Reducing facility count will discard names and field settings for removed facilities. Continue?');
                    if (!confirmed) {
                        facilityCountSelect.value = String(oldCount);
                        return;
                    }
                }
                renderFacilities();
            });

            form.addEventListener('submit', () => {
                renderFacilities();
                if (window.SAMLoading) {
                    window.SAMLoading.show('Creating company and facilities...');
                }
            });

            renderFacilities();
        })();
    </script>
}
