@model SAM.ViewModels.CompanyManagement.NewClientSetupBaselineViewModel

@{
    ViewData["Title"] = "New Client Setup — Baseline Loading";
    ViewData["PageSubtitle"] = $"Step 2 of 2 — Enter monthly loading (inches/acre) for {Model.CompanyName}.";
    ViewData["BaselineSaveUrl"] = Url.Action("SaveBaselineCell", "CompanyManagement");
    ViewData["BaselineFormAction"] = "FinishNewClientSetupBaseline";
    ViewData["BaselineFormController"] = "CompanyManagement";
    ViewData["BaselineDownloadUrl"] = Url.Action("DownloadBaselineLoadingTemplate", "CompanyManagement", new { companyId = Model.CompanyId });
    ViewData["BaselineImportUrl"] = Url.Action("ImportBaselineLoading", "CompanyManagement");
    ViewData["BaselineImportCompanyId"] = Model.CompanyId;
    ViewData["BaselineImportFacilityId"] = (Guid?)null;
}

@section PageTitleExtra {
    <div class="d-flex flex-wrap align-items-center gap-2">
        @await Html.PartialAsync("Partials/_BaselineLoadingExcelActions")
        <a asp-action="Index" asp-route-tab="companies" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Manage Companies
        </a>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@await Html.PartialAsync("Partials/_BaselineLoadingGrid", Model)
