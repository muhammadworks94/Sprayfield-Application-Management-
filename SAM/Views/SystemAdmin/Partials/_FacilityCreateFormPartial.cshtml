@model SAM.ViewModels.SystemAdmin.FacilityCreateViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    var companies = ViewBag.Companies as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var user = await UserManager.GetUserAsync(User);
    var isGlobalAdmin = user != null && await UserManager.IsInRoleAsync(user, "admin");
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="form-section">
    <div class="form-section-title">Company Information</div>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="CompanyId" class="form-label required"></label>
                @if (isGlobalAdmin && companies != null)
                {
                    <select asp-for="CompanyId" asp-items="companies" class="form-select">
                        <option value="">-- Select Company --</option>
                    </select>
                }
                else
                {
                    <input type="hidden" asp-for="CompanyId" />
                    <input type="text" class="form-control" value="@companies?.FirstOrDefault(c => c.Value == Model.CompanyId.ToString())?.Text" disabled />
                }
                <span asp-validation-for="CompanyId" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">Facility Information</div>
    <p class="text-muted small">Permit address, sprayfields, and lab options are configured after creation under Permit Versions and System Administration &gt; Lab Options.</p>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Name" class="form-label required"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Permittee" class="form-label required"></label>
                <input asp-for="Permittee" class="form-control" />
                <span asp-validation-for="Permittee" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="FacilityClass" class="form-label required"></label>
                <input asp-for="FacilityClass" class="form-control" />
                <span asp-validation-for="FacilityClass" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="PermitPhone" class="form-label"></label>
                <input asp-for="PermitPhone" class="form-control" />
                <span asp-validation-for="PermitPhone" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                <label asp-for="FacilityPhone" class="form-label"></label>
                <input asp-for="FacilityPhone" class="form-control" />
                <span asp-validation-for="FacilityPhone" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                <label asp-for="PersonsCollectingSamples" class="form-label"></label>
                <input asp-for="PersonsCollectingSamples" class="form-control" />
                <span asp-validation-for="PersonsCollectingSamples" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="FacilityContactPerson" class="form-label"></label>
                <input asp-for="FacilityContactPerson" class="form-control" />
                <span asp-validation-for="FacilityContactPerson" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="FacilityContactPersonPhone" class="form-label"></label>
                <input asp-for="FacilityContactPersonPhone" class="form-control" />
                <span asp-validation-for="FacilityContactPersonPhone" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                <label asp-for="LagoonBermHeightFeet" class="form-label"></label>
                <input asp-for="LagoonBermHeightFeet" type="number" step="0.01" class="form-control" />
                <div class="form-text">Used to calculate storage lagoon freeboard from daily water depth.</div>
                <span asp-validation-for="LagoonBermHeightFeet" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">Operator in Responsible Charge (ORC)</div>

    <div class="row">
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="OrcName" class="form-label"></label>
                <input asp-for="OrcName" class="form-control" />
                <span asp-validation-for="OrcName" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="OperatorGrade" class="form-label"></label>
                <input asp-for="OperatorGrade" class="form-control" />
                <span asp-validation-for="OperatorGrade" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="OperatorNumber" class="form-label"></label>
                <input asp-for="OperatorNumber" class="form-control" />
                <span asp-validation-for="OperatorNumber" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="OperatorPhone" class="form-label"></label>
                <input asp-for="OperatorPhone" class="form-control" />
                <span asp-validation-for="OperatorPhone" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="ChangeInOrc" type="checkbox" class="form-check-input" />
        <label asp-for="ChangeInOrc" class="form-check-label"></label>
    </div>
</div>

<div class="form-section">
    <div class="form-section-title">PAN Calculation Defaults</div>
    <p class="text-muted small">Used for PAN (Plant Available Nitrogen) calculation. Defaults are 40% and 50%.</p>
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="MineralizationRatePercent" class="form-label"></label>
                <input asp-for="MineralizationRatePercent" type="number" step="0.01" min="0" max="100" class="form-control" value="40" placeholder="40" />
                <span asp-validation-for="MineralizationRatePercent" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="VolatilizationRatePercent" class="form-label"></label>
                <input asp-for="VolatilizationRatePercent" type="number" step="0.01" min="0" max="100" class="form-control" value="50" placeholder="50" />
                <span asp-validation-for="VolatilizationRatePercent" class="text-danger"></span>
            </div>
        </div>
    </div>
</div>
