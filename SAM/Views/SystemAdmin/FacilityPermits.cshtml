@using SAM.Domain.Entities
@using SAM.Domain.Enums
@using SAM.Domain.Extensions
@{
    ViewData["Title"] = "Facility Permit Versions";
    var facility = ViewBag.Facility as Facility;
    var permits = ViewBag.Permits as List<FacilityPermit> ?? new();
    var activePermits = permits.Where(p => p.IsActive).OrderByDescending(p => p.EffectiveStartDate).ToList();
    var archivedPermits = permits.Where(p => !p.IsActive).OrderByDescending(p => p.EffectiveStartDate).ToList();
    var pcsCatalog = ViewBag.PcsCatalog as List<PcsParameterCatalog> ?? new();
    var sourceContext = ViewBag.SourceContext as string;
    var contextMonth = ViewBag.ContextMonth as int?;
    var contextYear = ViewBag.ContextYear as int?;
    var contextDate = (contextMonth.HasValue && contextYear.HasValue && contextMonth.Value >= 1 && contextMonth.Value <= 12 && contextYear.Value >= 2000 && contextYear.Value <= 2100)
        ? new DateTime(contextYear.Value, contextMonth.Value, 1)
        : (DateTime?)null;
    var addPermitError = TempData.Peek("ErrorMessage") as string;
    var addPermitExpanded = !ViewData.ModelState.IsValid
        || (!string.IsNullOrWhiteSpace(addPermitError) && addPermitError.Contains("permit", StringComparison.OrdinalIgnoreCase));
    var defaultEffectiveStart = contextDate?.ToString("yyyy-MM-dd") ?? string.Empty;
    var fromWwChar = string.Equals(sourceContext, "wwchar", StringComparison.OrdinalIgnoreCase);
    string Fmt(decimal? value) => value.HasValue ? value.Value.ToString("0.######") : "-";
    bool HasNotes(string? notes) => !string.IsNullOrWhiteSpace(notes);
    string NotesTitle(string? notes) => string.IsNullOrWhiteSpace(notes) ? "No notes." : notes;
    var wastewaterCount = activePermits.Sum(p => p.TemplateParameters.Count(x => (x.ReportTypes & PermitTemplateReportTypeEnum.Ndmr) != 0));
    var gw59Count = activePermits.Sum(p => p.TemplateParameters.Count(x => (x.ReportTypes & PermitTemplateReportTypeEnum.Gw59) != 0));
    var gw59ACount = activePermits.Sum(p => p.TemplateParameters.Count(x => (x.ReportTypes & PermitTemplateReportTypeEnum.Gw59A) != 0));
}

@functions {
    private static string ReportTypeLabel(PermitTemplateReportTypeEnum reportType)
    {
        if ((reportType & PermitTemplateReportTypeEnum.Gw59A) != 0) return "Groundwater (GW59A)";
        if ((reportType & PermitTemplateReportTypeEnum.Gw59) != 0) return "Groundwater (GW59)";
        return "Wastewater (NDMR)";
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><p class="text-muted mb-0">@facility?.Name</p></div>
    <div class="d-flex gap-2">
        <button type="button"
                class="btn btn-outline-primary js-collapse-toggle-state"
                data-bs-toggle="collapse"
                data-bs-target="#addPermitCollapse"
                data-open-label="Cancel"
                data-closed-label="Add Permit"
                data-open-icon="bi-x-circle"
                data-closed-icon="bi-plus-circle">
            <i class="bi bi-plus-circle me-1"></i><span>Add Permit</span>
        </button>
        <form asp-action="ImportPcsCatalogFromTsv" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="facilityId" value="@facility?.Id" />
            <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-database-down me-1"></i>Import PCS Catalog</button>
        </form>
        <a asp-action="FacilityDetails" asp-route-id="@facility?.Id" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

@if (fromWwChar && contextDate.HasValue)
{
    <div class="alert alert-info py-2">
        Opened from WWChar for <strong>@contextDate.Value.ToString("MMM yyyy")</strong>. Effective Start Date is prefilled for this period.
    </div>
}

<div id="addPermitCollapse" class="collapse @(addPermitExpanded ? "show" : "")">
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="mb-3">Add Permit Version</h5>
            <form asp-action="FacilityPermitCreate" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="facilityId" value="@facility?.Id" />
                <div class="row g-3">
                    <div class="col-md-3"><input name="permitNumber" class="form-control" placeholder="Permit Number" required /></div>
                    <div class="col-md-2"><input name="permitVersion" class="form-control" placeholder="Version (e.g. 4.1)" required /></div>
                    <div class="col-md-2"><input name="effectiveStartDate" type="date" class="form-control" required value="@defaultEffectiveStart" /></div>
                    <div class="col-md-2"><input name="effectiveEndDate" type="date" class="form-control" /></div>
                    <div class="col-md-3"><input name="permitPdf" type="file" class="form-control" accept=".pdf" /></div>
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="gwOperationLagoon" value="true" id="addPermitGwLagoon" checked />
                            <label class="form-check-label" for="addPermitGwLagoon">GW-59 Operation Type: Lagoon</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="gwOperationSprayField" value="true" id="addPermitGwSprayField" checked />
                            <label class="form-check-label" for="addPermitGwSprayField">GW-59 Operation Type: Spray Field</label>
                        </div>
                    </div>
                    <div class="col-12"><textarea name="notes" class="form-control" rows="2" placeholder="Notes (optional)"></textarea></div>
                    <div class="col-12"><button type="submit" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Permit</button></div>
                </div>
            </form>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-3" id="permitTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="wastewater-tab" data-bs-toggle="tab" data-bs-target="#wastewater-pane" type="button" role="tab" aria-controls="wastewater-pane" aria-selected="true">
            <i class="bi bi-droplet-half me-1"></i>Wastewater Monitoring (Attachment A) <span class="badge bg-secondary ms-1">@wastewaterCount</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="gw59-tab" data-bs-toggle="tab" data-bs-target="#gw59-pane" type="button" role="tab" aria-controls="gw59-pane" aria-selected="false">
            <i class="bi bi-moisture me-1"></i>Groundwater Monitoring (GW59) <span class="badge bg-secondary ms-1">@gw59Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="gw59a-tab" data-bs-toggle="tab" data-bs-target="#gw59a-pane" type="button" role="tab" aria-controls="gw59a-pane" aria-selected="false">
            <i class="bi bi-moisture me-1"></i>Groundwater Monitoring (GW59A) <span class="badge bg-secondary ms-1">@gw59ACount</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="archived-tab" data-bs-toggle="tab" data-bs-target="#archived-pane" type="button" role="tab" aria-controls="archived-pane" aria-selected="false">
            <i class="bi bi-archive me-1"></i>Archived Permits <span class="badge bg-secondary ms-1">@archivedPermits.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content" id="permitTabsContent">
    <div class="tab-pane fade show active" id="wastewater-pane" role="tabpanel" aria-labelledby="wastewater-tab">
        @if (!activePermits.Any())
        {
            <div class="alert alert-info">No active permit versions.</div>
        }
        else
        {
            @foreach (var permit in activePermits)
            {
                var rows = permit.TemplateParameters
                    .OrderBy(x => x.SortOrder)
                    .Select(x => new
                    {
                        Row = x,
                        Code = x.PcsParameterCatalog?.PcsCode ?? "",
                        Name = x.ParameterDisplayOverride ?? x.PcsParameterCatalog?.UserFriendlyName ?? x.PcsParameterCatalog?.OfficialParameterName ?? "",
                        Units = x.UnitsOverride ?? x.PcsParameterCatalog?.AcceptedUnits ?? ""
                    })
                    .ToList();
                var wwRows = rows.Where(r => (r.Row.ReportTypes & PermitTemplateReportTypeEnum.Ndmr) != 0).ToList();
                var reorderFormId = $"reorder_ww_{permit.Id:N}";
                var tableBodyId = $"tbody_ww_{permit.Id:N}";
                var editPermitCollapseId = $"edit_permit_ww_{permit.Id:N}";

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="mb-1">@permit.PermitNumber v@(permit.PermitVersion)</h5>
                                <div class="text-muted small">@permit.EffectiveStartDate.ToString("yyyy-MM-dd") to @(permit.EffectiveEndDate?.ToString("yyyy-MM-dd") ?? "open-ended")</div>
                            </div>
                            <div class="d-flex gap-2 align-items-center">
                                @if (!string.IsNullOrWhiteSpace(permit.PermitPdfStoragePath))
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="FacilityPermitPdf" asp-route-permitId="@permit.Id"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
                                }
                                <button type="button" class="btn btn-sm btn-outline-secondary js-collapse-toggle-state" data-bs-toggle="collapse" data-bs-target="#@editPermitCollapseId" data-open-label="Close" data-closed-label="Edit">
                                    <i class="bi bi-pencil-square me-1"></i><span>Edit</span>
                                </button>
                                <form asp-action="FacilityPermitArchive" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="permitId" value="@permit.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-archive me-1"></i>Archive</button>
                                </form>
                                <div class="d-flex gap-2 reorder-controls" data-table-body-id="@tableBodyId" data-reorder-form-id="@reorderFormId">
                                    <button type="button" class="btn btn-sm btn-primary reorder-toggle-btn"><i class="bi bi-arrow-down-up me-1"></i>Reorder</button>
                                    <button type="button" class="btn btn-sm btn-success reorder-save-btn d-none"><i class="bi bi-check2-circle me-1"></i>Save Order</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary reorder-cancel-btn d-none"><i class="bi bi-x-circle me-1"></i>Cancel</button>
                                </div>
                            </div>
                        </div>

                        <div class="collapse mb-3" id="@editPermitCollapseId">
                            <div class="card card-body bg-light">
                                <h6 class="mb-3">Edit Permit</h6>
                                <form asp-action="FacilityPermitUpdate" method="post" enctype="multipart/form-data" class="row g-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="permitId" value="@permit.Id" />
                                    <div class="col-md-3">
                                        <label class="form-label">Effective Start Date</label>
                                        <input name="effectiveStartDate" type="date" class="form-control" value="@permit.EffectiveStartDate.ToString("yyyy-MM-dd")" required />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Effective End Date</label>
                                        <input name="effectiveEndDate" type="date" class="form-control" value="@(permit.EffectiveEndDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Replace PDF (optional)</label>
                                        <input name="permitPdf" type="file" class="form-control" accept=".pdf,application/pdf" />
                                    </div>
                                    <div class="col-md-2 d-grid align-self-end">
                                        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Save</button>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="gwOperationLagoon" value="true" id="permitLagoon_@permit.Id" checked="@permit.GwOperationLagoon" />
                                            <label class="form-check-label" for="permitLagoon_@permit.Id">GW-59 Operation Type: Lagoon</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="gwOperationSprayField" value="true" id="permitSprayField_@permit.Id" checked="@permit.GwOperationSprayField" />
                                            <label class="form-check-label" for="permitSprayField_@permit.Id">GW-59 Operation Type: Spray Field</label>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(permit.PermitPdfFileName))
                                    {
                                        <div class="col-md-4 offset-md-6">
                                            <small class="text-muted d-block mt-1">Current file: @permit.PermitPdfFileName</small>
                                        </div>
                                    }
                                    <div class="col-12">
                                        <label class="form-label">Notes</label>
                                        <textarea name="notes" class="form-control" rows="2">@permit.Notes</textarea>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <div class="template-section mb-3">
                            <form id="@reorderFormId" asp-action="ReorderPermitTemplateParameters" method="post" class="d-none">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="facilityPermitId" value="@permit.Id" />
                                <input type="hidden" name="reportType" value="@PermitTemplateReportTypeEnum.Ndmr" />
                                <input type="hidden" name="orderedIdsCsv" class="ordered-ids-input" />
                            </form>

                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle">
                                    <thead>
                                        <tr>
                                            <th class="drag-col" style="width:36px;"></th><th>PCS</th><th>Parameter</th><th>Units</th><th>M. Frequency</th><th>Sample Type</th><th>Months</th><th>Monthly Avg</th><th>Monthly Geo Mean</th><th>Daily Min</th><th>Daily Max</th><th>Required</th><th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="@tableBodyId" class="sortable-tbody">
                                        @if (!wwRows.Any())
                                        {
                                            <tr><td colspan="13" class="text-muted text-center">No wastewater rows configured.</td></tr>
                                        }
                                        @foreach (var item in wwRows)
                                        {
                                            var editId = $"edit_{item.Row.Id:N}";
                                            <tr class="reorder-row" data-row-id="@item.Row.Id">
                                                <td class="text-center drag-handle text-muted drag-col"><i class="bi bi-list"></i></td>
                                                <td>@item.Code</td>
                                                <td>
                                                    @item.Name
                                                    @if (HasNotes(item.Row.Notes))
                                                    {
                                                        <i class="bi bi-info-circle ms-1 text-muted" data-bs-toggle="tooltip" data-bs-placement="top" title="@NotesTitle(item.Row.Notes)"></i>
                                                    }
                                                </td>
                                                <td>@item.Units</td>
                                                <td>@item.Row.MeasurementFrequency.ToDisplayLabel()</td>
                                                <td>@item.Row.SampleType</td>
                                                <td>@(string.IsNullOrWhiteSpace(item.Row.ScheduledMonthsCsv) ? "-" : item.Row.ScheduledMonthsCsv)</td>
                                                <td>@Fmt(item.Row.MonthlyAverageLimit)</td>
                                                <td>@Fmt(item.Row.MonthlyGeometricMeanLimit)</td>
                                                <td>@Fmt(item.Row.DailyMinimumLimit)</td>
                                                <td>@Fmt(item.Row.DailyMaximumLimit)</td>
                                                <td>@(item.Row.IsRequired ? "Required" : "Optional")</td>
                                                <td class="d-flex gap-1">
                                                    <button class="btn btn-sm btn-outline-secondary edit-btn js-collapse-toggle-state" type="button" data-bs-toggle="collapse" data-bs-target="#@editId" data-tooltip="true" data-bs-placement="top" title="Edit" aria-label="Edit" data-open-label="Close" data-closed-label="Edit"><i class="bi bi-pencil-square"></i></button>
                                                    <form asp-action="DeletePermitTemplateParameter" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Row.Id" />
                                                        <button class="btn btn-sm btn-outline-danger" type="submit" data-bs-toggle="tooltip" data-bs-placement="top" title="Delete" aria-label="Delete"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </td>
                                            </tr>
                                            <tr class="collapse inline-edit-collapse" id="@editId">
                                                <td colspan="13">
                                                    <form asp-action="UpdatePermitTemplateParameter" method="post" class="row g-2 align-items-end">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@item.Row.Id" />
                                                        <div class="col-md-2"><label class="form-label">M. Frequency</label><select class="form-select form-select-sm frequency-select" name="measurementFrequency">@foreach (MeasurementFrequencyEnum f in ViewBag.Frequencies){ if(f==MeasurementFrequencyEnum.Unspecified){continue;}<option value="@f" selected="@(item.Row.MeasurementFrequency==f)">@f.ToDisplayLabel()</option>}</select></div>
                                                        <div class="col-md-2"><label class="form-label">Sample Type</label><select class="form-select form-select-sm" name="sampleType">@foreach (SampleTypeEnum s in ViewBag.SampleTypes){ if(s==SampleTypeEnum.Unspecified){continue;}<option value="@s" selected="@(item.Row.SampleType==s)">@s</option>}</select></div>
                                                        <div class="col-md-2"><label class="form-label">Months CSV</label><input class="form-control form-control-sm months-csv-input" name="scheduledMonthsCsv" value="@item.Row.ScheduledMonthsCsv" /></div>
                                                        <div class="col-md-2"><label class="form-label">Monthly Avg</label><input class="form-control form-control-sm" type="number" step="0.000001" name="monthlyAverageLimit" value="@item.Row.MonthlyAverageLimit" /></div>
                                                        <div class="col-md-2"><label class="form-label">Monthly Geo</label><input class="form-control form-control-sm" type="number" step="0.000001" name="monthlyGeometricMeanLimit" value="@item.Row.MonthlyGeometricMeanLimit" /></div>
                                                        <div class="col-md-2"><label class="form-label">Daily Min</label><input class="form-control form-control-sm" type="number" step="0.000001" name="dailyMinimumLimit" value="@item.Row.DailyMinimumLimit" /></div>
                                                        <div class="col-md-2"><label class="form-label">Daily Max</label><input class="form-control form-control-sm" type="number" step="0.000001" name="dailyMaximumLimit" value="@item.Row.DailyMaximumLimit" /></div>
                                                        <div class="col-md-3"><label class="form-label">Section</label><select class="form-select form-select-sm" name="reportType"><option value="@PermitTemplateReportTypeEnum.Ndmr" selected="@(item.Row.ReportTypes==PermitTemplateReportTypeEnum.Ndmr)">Wastewater (NDMR)</option><option value="@PermitTemplateReportTypeEnum.Gw59" selected="@(item.Row.ReportTypes==PermitTemplateReportTypeEnum.Gw59)">Groundwater (GW59)</option><option value="@PermitTemplateReportTypeEnum.Gw59A" selected="@(item.Row.ReportTypes==PermitTemplateReportTypeEnum.Gw59A)">Groundwater (GW59A)</option></select></div>
                                                        <div class="col-md-3"><label class="form-label">Notes</label><input class="form-control form-control-sm" name="notes" value="@item.Row.Notes" /></div>
                                                        <div class="col-md-2 form-check mt-4"><input class="form-check-input" id="req_@item.Row.Id" type="checkbox" name="isRequired" value="true" checked="@item.Row.IsRequired" /><label class="form-check-label" for="req_@item.Row.Id">Required</label></div>
                                                        <div class="col-12 d-flex gap-2"><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-check2 me-1"></i>Save</button><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#@editId"><i class="bi bi-x-circle me-1"></i>Cancel</button></div>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="border-top pt-3">
                            <h6 class="mb-3">Add Template Parameter</h6>
                            <form asp-action="AddPermitTemplateParameter" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="facilityPermitId" value="@permit.Id" />
                                <input type="hidden" name="reportType" value="@PermitTemplateReportTypeEnum.Ndmr" />
                                <div class="row g-3 align-items-end">
                                    <div class="col-lg-4 col-md-6">
                                        <label class="form-label">PCS</label>
                                        <select class="form-select" name="pcsParameterCatalogId" required>
                                            <option value="">Select PCS code and parameter</option>
                                            @foreach (var p in pcsCatalog)
                                            {
                                                <option value="@p.Id">@p.PcsCode - @p.UserFriendlyName (@p.AcceptedUnits)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">M. Frequency</label><select class="form-select frequency-select" name="measurementFrequency">@foreach (MeasurementFrequencyEnum f in ViewBag.Frequencies){ if(f==MeasurementFrequencyEnum.Unspecified){continue;}<option value="@f" selected="@(f==MeasurementFrequencyEnum.Monthly)">@f.ToDisplayLabel()</option>}</select></div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">Sample Type</label><select class="form-select" name="sampleType">@foreach (SampleTypeEnum s in ViewBag.SampleTypes){ if(s==SampleTypeEnum.Unspecified){continue;}<option value="@s" selected="@(s==SampleTypeEnum.Grab)">@s</option>}</select></div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">Months (CSV)</label><input name="scheduledMonthsCsv" class="form-control months-csv-input" placeholder="4,8,11" /></div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">Monthly Avg</label><input name="monthlyAverageLimit" type="number" step="0.000001" class="form-control" /></div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">Monthly Geo Mean</label><input name="monthlyGeometricMeanLimit" type="number" step="0.000001" class="form-control" /></div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">Daily Min</label><input name="dailyMinimumLimit" type="number" step="0.000001" class="form-control" /></div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">Daily Max</label><input name="dailyMaximumLimit" type="number" step="0.000001" class="form-control" /></div>
                                    <div class="col-lg-4 col-md-6"><label class="form-label">Notes</label><input name="notes" class="form-control" placeholder="Special instructions / footnotes" /></div>
                                    <div class="col-lg-2 col-md-3"><div class="form-check pt-4"><input class="form-check-input" type="checkbox" name="isRequired" value="true" id="required_ww_@permit.Id" /><label class="form-check-label" for="required_ww_@permit.Id">Required</label></div></div>
                                    <div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-plus-circle me-1"></i>Add Template Parameter</button></div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="tab-pane fade" id="gw59-pane" role="tabpanel" aria-labelledby="gw59-tab">
        @if (!activePermits.Any())
        {
            <div class="alert alert-info">No active permit versions.</div>
        }
        else
        {
            @foreach (var permit in activePermits)
            {
                var rows = permit.TemplateParameters.OrderBy(x => x.SortOrder).Select(x => new
                {
                    Row = x,
                    Code = x.PcsParameterCatalog?.PcsCode ?? "",
                    Name = x.ParameterDisplayOverride ?? x.PcsParameterCatalog?.UserFriendlyName ?? x.PcsParameterCatalog?.OfficialParameterName ?? "",
                    Units = x.UnitsOverride ?? x.PcsParameterCatalog?.AcceptedUnits ?? ""
                }).ToList();
                var gwRows = rows.Where(r => (r.Row.ReportTypes & PermitTemplateReportTypeEnum.Gw59) != 0).ToList();
                var reorderFormId = $"reorder_gw59_{permit.Id:N}";
                var tableBodyId = $"tbody_gw59_{permit.Id:N}";
                var editPermitCollapseId = $"edit_permit_gw59_{permit.Id:N}";
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="mb-1">@permit.PermitNumber v@(permit.PermitVersion)</h5>
