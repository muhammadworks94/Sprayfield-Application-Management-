                                                        <input type="hidden" name="monthlyAverageLimit" value="@item.Row.MonthlyAverageLimit" />
                                                        <input type="hidden" name="monthlyGeometricMeanLimit" value="@item.Row.MonthlyGeometricMeanLimit" />
                                                        <input type="hidden" name="dailyMinimumLimit" value="@item.Row.DailyMinimumLimit" />
                                                        <div class="col-12 d-flex gap-2"><button class="btn btn-sm btn-primary" type="submit"><i class="bi bi-check2 me-1"></i>Save</button><button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#@editId"><i class="bi bi-x-circle me-1"></i>Cancel</button></div>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="border-top pt-3">
                            <h6 class="mb-3">Add Template Parameter</h6>
                            <form asp-action="AddPermitTemplateParameter" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="facilityPermitId" value="@permit.Id" />
                                <input type="hidden" name="reportType" value="@PermitTemplateReportTypeEnum.Gw59A" />
                                <div class="row g-3 align-items-end">
                                    <div class="col-lg-4 col-md-6"><label class="form-label">PCS</label><select class="form-select" name="pcsParameterCatalogId" required><option value="">Select PCS code and parameter</option>@foreach (var p in pcsCatalog){<option value="@p.Id">@p.PcsCode - @p.UserFriendlyName (@p.AcceptedUnits)</option>}</select></div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">M. Frequency</label><select class="form-select frequency-select" name="measurementFrequency">@foreach (MeasurementFrequencyEnum f in ViewBag.Frequencies){ if(f==MeasurementFrequencyEnum.Unspecified){continue;}<option value="@f" selected="@(f==MeasurementFrequencyEnum.Monthly)">@f.ToDisplayLabel()</option>}</select></div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">Sample Type</label><select class="form-select" name="sampleType">@foreach (SampleTypeEnum s in ViewBag.SampleTypes){ if(s==SampleTypeEnum.Unspecified){continue;}<option value="@s" selected="@(s==SampleTypeEnum.Grab)">@s</option>}</select></div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">Months (CSV)</label><input name="scheduledMonthsCsv" class="form-control months-csv-input" placeholder="4,8,11" /></div>
                                    <div class="col-lg-2 col-md-3"><label class="form-label">Daily Max</label><input name="dailyMaximumLimit" type="number" step="0.000001" class="form-control" /></div>
                                    <div class="col-lg-4 col-md-6"><label class="form-label">Notes</label><input name="notes" class="form-control" placeholder="Special instructions / footnotes" /></div>
                                    <div class="col-lg-2 col-md-3"><div class="form-check pt-4"><input class="form-check-input" type="checkbox" name="isRequired" value="true" id="required_gw59a_@permit.Id" /><label class="form-check-label" for="required_gw59a_@permit.Id">Required</label></div></div>
                                    <input type="hidden" name="monthlyAverageLimit" />
                                    <input type="hidden" name="monthlyGeometricMeanLimit" />
                                    <input type="hidden" name="dailyMinimumLimit" />
                                    <div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-plus-circle me-1"></i>Add Template Parameter</button></div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="tab-pane fade" id="archived-pane" role="tabpanel" aria-labelledby="archived-tab">
        @if (!archivedPermits.Any())
        {
            <div class="alert alert-info">No archived permit versions.</div>
        }
        else
        {
            @foreach (var permit in archivedPermits)
            {
                var rows = permit.TemplateParameters.OrderBy(x => x.SortOrder).Select(x => new
                {
                    Row = x,
                    Code = x.PcsParameterCatalog?.PcsCode ?? "",
                    Name = x.ParameterDisplayOverride ?? x.PcsParameterCatalog?.UserFriendlyName ?? x.PcsParameterCatalog?.OfficialParameterName ?? "",
                    Units = x.UnitsOverride ?? x.PcsParameterCatalog?.AcceptedUnits ?? ""
                }).ToList();

                <div class="card mb-3 border-secondary-subtle">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="mb-1">@permit.PermitNumber v@(permit.PermitVersion)</h5>
                                <div class="text-muted small">@permit.EffectiveStartDate.ToString("yyyy-MM-dd") to @(permit.EffectiveEndDate?.ToString("yyyy-MM-dd") ?? "open-ended")</div>
                            </div>
                            <div class="d-flex gap-2">
                                @if (!string.IsNullOrWhiteSpace(permit.PermitPdfStoragePath))
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-action="FacilityPermitPdf" asp-route-permitId="@permit.Id"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
                                }
                                <form asp-action="FacilityPermitUnarchive" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="permitId" value="@permit.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-box-arrow-in-up me-1"></i>Unarchive</button>
                                </form>
                                <form asp-action="FacilityPermitDelete" method="post" onsubmit="return confirm('Delete this archived permit version? This action hides it from the system.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="permitId" value="@permit.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
                                </form>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle">
                                <thead>
                                    <tr><th>PCS</th><th>Parameter</th><th>Units</th><th>M. Frequency</th><th>Sample Type</th><th>Months</th><th>Daily Max</th><th>Section</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in rows)
                                    {
                                        <tr>
                                            <td>@item.Code</td>
                                            <td>
                                                @item.Name
                                                @if (HasNotes(item.Row.Notes))
                                                {
                                                    <i class="bi bi-info-circle ms-1 text-muted" data-bs-toggle="tooltip" data-bs-placement="top" title="@NotesTitle(item.Row.Notes)"></i>
                                                }
                                            </td>
                                            <td>@item.Units</td>
                                            <td>@item.Row.MeasurementFrequency.ToDisplayLabel()</td>
                                            <td>@item.Row.SampleType</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Row.ScheduledMonthsCsv) ? "-" : item.Row.ScheduledMonthsCsv)</td>
                                            <td>@Fmt(item.Row.DailyMaximumLimit)</td>
                                            <td>@ReportTypeLabel(item.Row.ReportTypes)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"], [data-tooltip="true"]').forEach(function (el) {
            new bootstrap.Tooltip(el, {
                container: 'body',
                trigger: 'hover',
                boundary: 'viewport',
                placement: 'right'
            });
        });

        function isPeriodicFrequency(value) {
            return value === 'ThreeTimesPerYear' || value === 'Annual' || value === 'Unspecified';
        }

        function syncMonthsCsvState(container) {
            var frequencySelect = container.querySelector('.frequency-select');
            var monthsInput = container.querySelector('.months-csv-input');
            if (!frequencySelect || !monthsInput) return;

            var enableMonths = isPeriodicFrequency(frequencySelect.value);
            monthsInput.disabled = !enableMonths;
            monthsInput.classList.toggle('bg-light', !enableMonths);
            if (!enableMonths) {
                monthsInput.value = '';
                monthsInput.placeholder = 'Not needed for this frequency';
            } else if (!monthsInput.placeholder || monthsInput.placeholder === 'Not needed for this frequency') {
                monthsInput.placeholder = '4,8,11';
            }
        }

        document.querySelectorAll('form').forEach(function (formEl) {
            if (formEl.querySelector('.frequency-select') && formEl.querySelector('.months-csv-input')) {
                syncMonthsCsvState(formEl);
                formEl.querySelector('.frequency-select').addEventListener('change', function () {
                    syncMonthsCsvState(formEl);
                });
            }
        });

        document.querySelectorAll('.inline-edit-collapse').forEach(function (collapseEl) {
            collapseEl.addEventListener('show.bs.collapse', function () {
                var section = collapseEl.closest('.template-section');
                if (!section) return;

                section.querySelectorAll('.inline-edit-collapse.show').forEach(function (openEl) {
                    if (openEl !== collapseEl) {
                        bootstrap.Collapse.getOrCreateInstance(openEl, { toggle: false }).hide();
                    }
                });
            });
        });

        function setCollapseToggleVisual(btn, isOpen) {
            if (!btn) return;
            var icon = btn.querySelector('i.bi');
            var label = btn.querySelector('span');
            var closedLabel = btn.getAttribute('data-closed-label') || 'Edit';
            var openLabel = btn.getAttribute('data-open-label') || 'Close';
            var closedIcon = btn.getAttribute('data-closed-icon') || 'bi-pencil-square';
            var openIcon = btn.getAttribute('data-open-icon') || 'bi-x-circle';

            if (icon) {
                icon.classList.remove(closedIcon, openIcon);
                icon.classList.add(isOpen ? openIcon : closedIcon);
            }

            if (label) {
                label.textContent = isOpen ? openLabel : closedLabel;
            } else {
                btn.setAttribute('title', isOpen ? openLabel : closedLabel);
                btn.setAttribute('aria-label', isOpen ? openLabel : closedLabel);
            }
        }

        document.querySelectorAll('.js-collapse-toggle-state[data-bs-target]').forEach(function (btn) {
            var targetSelector = btn.getAttribute('data-bs-target');
            if (!targetSelector) return;
            var collapseEl = document.querySelector(targetSelector);
            if (!collapseEl) return;

            setCollapseToggleVisual(btn, collapseEl.classList.contains('show'));
            collapseEl.addEventListener('show.bs.collapse', function () { setCollapseToggleVisual(btn, true); });
            collapseEl.addEventListener('hide.bs.collapse', function () { setCollapseToggleVisual(btn, false); });
        });

        function getPairedEditRow(mainRow) {
            var next = mainRow.nextElementSibling;
            if (next && next.classList.contains('inline-edit-collapse')) {
                return next;
            }
            return null;
        }

        function enableReorderMode(control) {
            var tableBody = document.getElementById(control.dataset.tableBodyId);
            if (!tableBody) return;
            control.classList.add('reorder-active');
            control.querySelector('.reorder-toggle-btn')?.classList.add('d-none');
            control.querySelector('.reorder-save-btn')?.classList.remove('d-none');
            control.querySelector('.reorder-cancel-btn')?.classList.remove('d-none');
            tableBody.closest('table')?.classList.add('reorder-mode');

            tableBody.querySelectorAll('.reorder-row').forEach(function (row) {
                row.draggable = true;
                row.classList.add('drag-enabled');
                var editRow = getPairedEditRow(row);
                if (editRow) editRow.style.display = 'none';
            });
            tableBody.querySelectorAll('.edit-btn').forEach(function (btn) { btn.disabled = true; });
        }

        function disableReorderMode(control, resetOrder) {
            var tableBody = document.getElementById(control.dataset.tableBodyId);
            if (!tableBody) return;
            control.classList.remove('reorder-active');
            control.querySelector('.reorder-toggle-btn')?.classList.remove('d-none');
            control.querySelector('.reorder-save-btn')?.classList.add('d-none');
            control.querySelector('.reorder-cancel-btn')?.classList.add('d-none');
            tableBody.closest('table')?.classList.remove('reorder-mode');

            if (resetOrder) {
                window.location.reload();
                return;
            }

            tableBody.querySelectorAll('.reorder-row').forEach(function (row) {
                row.draggable = false;
                row.classList.remove('drag-enabled');
                var editRow = getPairedEditRow(row);
                if (editRow) editRow.style.display = '';
            });
            tableBody.querySelectorAll('.edit-btn').forEach(function (btn) { btn.disabled = false; });
        }

        document.querySelectorAll('.reorder-controls').forEach(function (control) {
            var tableBody = document.getElementById(control.dataset.tableBodyId);
            var draggedMainRow = null;

            control.querySelector('.reorder-toggle-btn')?.addEventListener('click', function () {
                enableReorderMode(control);
            });

            control.querySelector('.reorder-cancel-btn')?.addEventListener('click', function () {
                disableReorderMode(control, true);
            });

            control.querySelector('.reorder-save-btn')?.addEventListener('click', function () {
                var form = document.getElementById(control.dataset.reorderFormId);
                if (!form) return;
                var orderedIds = Array.from(tableBody.querySelectorAll('.reorder-row[data-row-id]')).map(function (row) {
                    return row.getAttribute('data-row-id');
                }).filter(Boolean);
                form.querySelector('.ordered-ids-input').value = orderedIds.join(',');
                form.submit();
            });

            tableBody?.addEventListener('dragstart', function (e) {
                var row = e.target.closest('.reorder-row');
                if (!row || !control.classList.contains('reorder-active')) return;
                draggedMainRow = row;
                e.dataTransfer.effectAllowed = 'move';
            });

            tableBody?.addEventListener('dragover', function (e) {
                if (!draggedMainRow || !control.classList.contains('reorder-active')) return;
                var target = e.target.closest('.reorder-row');
                if (!target || target === draggedMainRow) return;
                e.preventDefault();
            });

            tableBody?.addEventListener('drop', function (e) {
                if (!draggedMainRow || !control.classList.contains('reorder-active')) return;
                var target = e.target.closest('.reorder-row');
                if (!target || target === draggedMainRow) return;
                e.preventDefault();

                var targetRect = target.getBoundingClientRect();
                var placeAfter = e.clientY > targetRect.top + (targetRect.height / 2);

                var draggedEdit = getPairedEditRow(draggedMainRow);
                var targetEdit = getPairedEditRow(target);

                if (placeAfter) {
                    if (targetEdit) {
                        targetEdit.insertAdjacentElement('afterend', draggedMainRow);
                    } else {
                        target.insertAdjacentElement('afterend', draggedMainRow);
                    }
                    if (draggedEdit) draggedMainRow.insertAdjacentElement('afterend', draggedEdit);
                } else {
                    target.insertAdjacentElement('beforebegin', draggedMainRow);
                    if (draggedEdit) draggedMainRow.insertAdjacentElement('afterend', draggedEdit);
                }
            });
        });
    </script>
    <style>
        .drag-handle { cursor: default; }
        .drag-col { display: none; }
        table.reorder-mode .drag-col { display: table-cell; }
        table.reorder-mode .drag-handle { cursor: grab; }
        table.reorder-mode .reorder-row.drag-enabled { cursor: move; }
        table.reorder-mode .reorder-row.drag-enabled:hover { background-color: #f8f9fa; }
    </style>
}
