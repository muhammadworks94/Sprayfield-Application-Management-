@model SAM.ViewModels.SystemAdmin.FacilityViewModel
@{
    ViewData["Title"] = "Facility Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">View detailed information for facility</p>
    </div>
    <div>
        <a asp-action="FacilityEdit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="ModifyBaselineLoading" asp-route-facilityId="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-calendar-range"></i> Modify Baseline Loading
        </a>
        <a asp-action="FacilityPermits" asp-route-facilityId="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-file-earmark-medical"></i> Permit Versions
        </a>
        <a asp-action="SystemAdmin" asp-route-tab="facilities" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="card">
   
    <div class="card-body">
        <h4 class="mb-5"><i class="bi bi-building me-2"></i>@Model.Name</h4>
        <div class="row">
            <div class="col-md-6">
                <h6 class="mb-3">General Information</h6>
                <dl class="row">
                    <dt class="col-sm-5"><i class="bi bi-briefcase me-1"></i>Company:</dt>
                    <dd class="col-sm-7">@Model.CompanyName</dd>

                  @*   <dt class="col-sm-5"><i class="bi bi-building me-1"></i>Facility Name:</dt>
                    <dd class="col-sm-7">@Model.Name</dd> *@

                    <dt class="col-sm-5"><i class="bi bi-file-text me-1"></i>Permit Number:</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.SelectedPermitLabel) ? (string.IsNullOrWhiteSpace(Model.PermitNumber) ? "N/A" : Model.PermitNumber) : Model.SelectedPermitLabel)</dd>

                    <dt class="col-sm-5"><i class="bi bi-calendar-event me-1"></i>Permit End Date:</dt>
                    <dd class="col-sm-7">
                        @(Model.PermitExpirationDate.HasValue
                            ? Model.PermitExpirationDate.Value.ToString("MM/dd/yyyy")
                            : "N/A")
                    </dd>

                    <dt class="col-sm-5"><i class="bi bi-person me-1"></i>Permittee:</dt>
                    <dd class="col-sm-7">@Model.Permittee</dd>

                    <dt class="col-sm-5"><i class="bi bi-file-earmark-medical me-1"></i>Selected Permit:</dt>
                    <dd class="col-sm-7">
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedPermitLabel))
                        {
                            @Model.SelectedPermitLabel
                        }
                        else
                        {
                            <span class="text-muted">Not set</span>
                        }
                        <div><a asp-action="FacilityPermits" asp-route-facilityId="@Model.Id" class="small">Manage Permit Versions</a></div>
                    </dd>

                    <dt class="col-sm-5"><i class="bi bi-tag me-1"></i>Facility Class:</dt>
                    <dd class="col-sm-7">@Model.FacilityClass</dd>

                    <dt class="col-sm-5"><i class="bi bi-telephone me-1"></i>Permit Phone:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.PermitPhone) ? Model.PermitPhone : "N/A")</dd>

                    <dt class="col-sm-5"><i class="bi bi-telephone-outbound me-1"></i>Facility Phone:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.FacilityPhone) ? Model.FacilityPhone : "N/A")</dd>

                    <dt class="col-sm-5"><i class="bi bi-person me-1"></i>Facility Contact Person:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.FacilityContactPerson) ? Model.FacilityContactPerson : "N/A")</dd>

                    <dt class="col-sm-5"><i class="bi bi-telephone me-1"></i>Facility Contact Phone:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.FacilityContactPersonPhone) ? Model.FacilityContactPersonPhone : "N/A")</dd>

                    <dt class="col-sm-5"><i class="bi bi-pen me-1"></i>Signing Official:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.SigningOfficial) ? Model.SigningOfficial : "N/A")</dd>

                    <dt class="col-sm-5"><i class="bi bi-briefcase me-1"></i>Signing Official's Title:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.FacilityContactPersonTitle) ? Model.FacilityContactPersonTitle : "N/A")</dd>
                </dl>
            </div>

            <div class="col-md-6">
                <h6 class="mb-3">Permit Location &amp; ORC</h6>
                <dl class="row">
                    <dt class="col-sm-5"><i class="bi bi-geo-alt me-1"></i>Permit Address:</dt>
                    <dd class="col-sm-7">
                        @if (!string.IsNullOrWhiteSpace(Model.PermitLocationSummary))
                        {
                            @Model.PermitLocationSummary
                            @if (!string.IsNullOrWhiteSpace(Model.SelectedPermitCounty))
                            {
                                <br /><span><i class="bi bi-map me-1"></i>@Model.SelectedPermitCounty County</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">Configure on an active permit version</span>
                        }
                    </dd>

                    <dt class="col-sm-5"><i class="bi bi-person-badge me-1"></i>ORC Name:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.OrcName) ? Model.OrcName : "N/A")</dd>

                    <dt class="col-sm-5"><i class="bi bi-person-check me-1"></i>ORC SAM User:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.CurrentOrcUserName) ? Model.CurrentOrcUserName : "N/A")</dd>

                    <dt class="col-sm-5"><i class="bi bi-calendar-event me-1"></i>ORC Start:</dt>
                    <dd class="col-sm-7">@(Model.CurrentOrcStartDate?.ToString("MM/dd/yyyy") ?? "N/A")</dd>

                    <dt class="col-sm-5"><i class="bi bi-diagram-3 me-1"></i>Operator Grade:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.OperatorGrade) ? Model.OperatorGrade : "N/A")</dd>

                    <dt class="col-sm-5"><i class="bi bi-hash me-1"></i>Operator Number:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.OperatorNumber) ? Model.OperatorNumber : "N/A")</dd>

                    <dt class="col-sm-5"><i class="bi bi-telephone me-1"></i>Operator Phone:</dt>
                    <dd class="col-sm-7">@(!string.IsNullOrWhiteSpace(Model.OperatorPhone) ? Model.OperatorPhone : "N/A")</dd>

                </dl>
            </div>
        </div>

        <hr />

        <div class="row">
            <div class="col-md-6">
                <h6 class="mb-3">Permit Sprayfields &amp; PAN Defaults</h6>
                <dl class="row">
                    <dt class="col-sm-6"><i class="bi bi-bezier me-1"></i>Total Number of Sprayfields:</dt>
                    <dd class="col-sm-6">
                        @(Model.PermitSprayfieldCount?.ToString() ?? "N/A")
                    </dd>

                    <dt class="col-sm-6"><i class="bi bi-water me-1"></i>Permitted Minimum Freeboard:</dt>
                    <dd class="col-sm-6">
                        @(Model.PermitMinimumFreeboardFeet.HasValue
                            ? $"{Model.PermitMinimumFreeboardFeet.Value} ft"
                            : "N/A")
                    </dd>

                    <dt class="col-sm-6"><i class="bi bi-water me-1"></i>Lagoon Berm Height:</dt>
                    <dd class="col-sm-6">
                        @(Model.LagoonBermHeightFeet.HasValue
                            ? $"{Model.LagoonBermHeightFeet.Value:F2} ft"
                            : "N/A")
                    </dd>

                    <dt class="col-sm-6">Mineralization Rate (%):</dt>
                    <dd class="col-sm-6">@(Model.MineralizationRatePercent.HasValue ? $"{Model.MineralizationRatePercent.Value}%" : "N/A")</dd>

                    <dt class="col-sm-6">Volatilization Rate (%):</dt>
                    <dd class="col-sm-6">@(Model.VolatilizationRatePercent.HasValue ? $"{Model.VolatilizationRatePercent.Value}%" : "N/A")</dd>
                </dl>
            </div>

            <div class="col-md-6">
                <h6 class="mb-3">Sampling</h6>
                <dl class="row">
                    <dt class="col-sm-6"><i class="bi bi-person-lines-fill me-1"></i>Person(s) Collecting Samples:</dt>
                    <dd class="col-sm-6">
                        @(!string.IsNullOrWhiteSpace(Model.PersonsCollectingSamples)
                            ? Model.PersonsCollectingSamples
                            : "N/A")
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>
