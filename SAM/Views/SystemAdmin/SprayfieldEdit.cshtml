@model SAM.ViewModels.SystemAdmin.SprayfieldEditViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Edit Sprayfield";
    var soils = ViewBag.Soils as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var crops = ViewBag.Crops as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var nozzles = ViewBag.Nozzles as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var facilities = ViewBag.Facilities as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var companies = ViewBag.Companies as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var user = await UserManager.GetUserAsync(User);
    var isGlobalAdmin = user != null && await UserManager.IsInRoleAsync(user, "admin");
}

<div class="mb-4">
    <p class="text-muted mb-0">Modify sprayfield information and settings</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="SprayfieldEdit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section">
                <div class="form-section-title">Company Information</div>
                
                <div class="mb-3">
                    <label asp-for="CompanyId" class="form-label required"></label>
                    @if (isGlobalAdmin && companies != null)
                    {
                        <select asp-for="CompanyId" asp-items="companies" class="form-select" id="companySelect">
                            <option value="">-- Select Company --</option>
                        </select>
                    }
                    else
                    {
                        <input type="hidden" asp-for="CompanyId" />
                        <input type="text" class="form-control" value="@companies?.FirstOrDefault(c => c.Value == Model.CompanyId.ToString())?.Text" disabled />
                    }
                    <span asp-validation-for="CompanyId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Sprayfield Information</div>
                
                <div class="mb-3">
                    <label asp-for="FieldId" class="form-label required"></label>
                    <input asp-for="FieldId" class="form-control" />
                    <span asp-validation-for="FieldId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SizeAcres" class="form-label required"></label>
                    <input asp-for="SizeAcres" type="number" step="0.001" min="0" class="form-control" />
                    <span asp-validation-for="SizeAcres" class="text-danger"></span>
                    <small class="form-text text-muted">Size of wetted area in acres.</small>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="SoilId" class="form-label required"></label>
                            <select asp-for="SoilId" asp-items="soils" class="form-select">
                                <option value="">-- Select Soil --</option>
                            </select>
                            <span asp-validation-for="SoilId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="CropId" class="form-label required"></label>
                            <select asp-for="CropId" asp-items="crops" class="form-select">
                                <option value="">-- Select Crop --</option>
                            </select>
                            <span asp-validation-for="CropId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="NozzleId" class="form-label required"></label>
                            <select asp-for="NozzleId" asp-items="nozzles" class="form-select">
                                <option value="">-- Select Nozzle --</option>
                            </select>
                            <span asp-validation-for="NozzleId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FacilityId" class="form-label"></label>
                            <select asp-for="FacilityId" asp-items="facilities" class="form-select">
                                <option value="">-- Select Facility (Optional) --</option>
                            </select>
                            <span asp-validation-for="FacilityId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="HydraulicLoadingLimitInPerYr" class="form-label required"></label>
                    <input asp-for="HydraulicLoadingLimitInPerYr" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="HydraulicLoadingLimitInPerYr" class="text-danger"></span>
                    <small class="form-text text-muted">Annual hydraulic loading limit in inches per year</small>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="HourlyRateInches" class="form-label"></label>
                            <input asp-for="HourlyRateInches" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="HourlyRateInches" class="text-danger"></span>
                            <small class="form-text text-muted">Design hourly application rate in inches per hour.</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="WeeklyRateInches" class="form-label"></label>
                            <input asp-for="WeeklyRateInches" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="WeeklyRateInches" class="text-danger"></span>
                            <small class="form-text text-muted">Design weekly application rate in inches per week.</small>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">Application Zones</h6>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddZone">
                        <i class="bi bi-plus-circle"></i> Add Zone
                    </button>
                </div>
                <div class="mb-2">
                    <small class="text-muted">Active zone percentages must total 100%.</small>
                </div>
                <div class="mb-2">
                    <span class="badge bg-secondary" id="zoneTotalBadge">Total: 0.00%</span>
                    <span class="text-danger ms-2" id="zonePercentMessage"></span>
                    <div asp-validation-for="Zones" class="text-danger"></div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Zone Name</th>
                                <th>% of Field</th>
                                <th>Soil</th>
                                <th>Nozzle</th>
                                <th>Crop</th>
                                <th>Active</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="zonesTableBody">
                            @for (var i = 0; i < Model.Zones.Count; i++)
                            {
                                <tr class="zone-row">
                                    <td>
                                        <input asp-for="Zones[i].Id" type="hidden" />
                                        <input asp-for="Zones[i].ZoneName" class="form-control form-control-sm" />
                                        <span asp-validation-for="Zones[i].ZoneName" class="text-danger"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Zones[i].PercentOfField" type="number" step="any" min="0.01" max="100" class="form-control form-control-sm zone-percent-input" />
                                        <span asp-validation-for="Zones[i].PercentOfField" class="text-danger"></span>
                                    </td>
                                    <td>
                                        <select asp-for="Zones[i].SoilId" asp-items="soils" class="form-select form-select-sm zone-manager-select">
                                            <option value="">-- Select Soil --</option>
                                        </select>
                                        <span asp-validation-for="Zones[i].SoilId" class="text-danger"></span>
                                    </td>
                                    <td>
                                        <select asp-for="Zones[i].NozzleId" asp-items="nozzles" class="form-select form-select-sm zone-manager-select">
                                            <option value="">-- Select Nozzle --</option>
                                        </select>
                                        <span asp-validation-for="Zones[i].NozzleId" class="text-danger"></span>
                                    </td>
                                    <td>
                                        <select asp-for="Zones[i].CropId" asp-items="crops" class="form-select form-select-sm zone-manager-select">
                                            <option value="">-- Select Crop (Optional) --</option>
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        <input asp-for="Zones[i].Active" class="form-check-input zone-active-input" />
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-outline-danger btn-sm btn-remove-zone">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3 p-3 border rounded bg-light-subtle">
                    <h6 class="mb-2">If removed zones have monthly applications</h6>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" asp-for="RemovedZoneAction" value="reassign" id="removedZoneActionReassign" />
                        <label class="form-check-label" for="removedZoneActionReassign">
                            Reassign applications to another existing zone
                        </label>
                    </div>
                    <div class="mb-2">
                        <select asp-for="ReassignToZoneId" class="form-select">
                            <option value="">-- Select target zone --</option>
                            @foreach (var zone in Model.Zones.Where(z => z.Id.HasValue))
                            {
                                <option value="@zone.Id">@zone.ZoneName</option>
                            }
                        </select>
                        <span asp-validation-for="ReassignToZoneId" class="text-danger"></span>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="RemovedZoneAction" value="delete" id="removedZoneActionDelete" />
                        <label class="form-check-label" for="removedZoneActionDelete">
                            Delete associated monthly applications for removed zones
                        </label>
                    </div>
                    <span asp-validation-for="RemovedZoneAction" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="SprayfieldDetails" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Update Sprayfield
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const isGlobalAdmin = @(isGlobalAdmin.ToString().ToLower());
            if (isGlobalAdmin) {
                document.getElementById('companySelect')?.addEventListener('change', function () {
                    const companyId = this.value;
                    if (companyId) {
                        window.location.href = '@Url.Action("SprayfieldEdit", new { id = Model.Id })' + '?companyId=' + companyId;
                    }
                });
            }

            const zonesTableBody = document.getElementById('zonesTableBody');
            const addZoneBtn = document.getElementById('btnAddZone');
            const zoneTotalBadge = document.getElementById('zoneTotalBadge');
            const zonePercentMessage = document.getElementById('zonePercentMessage');
            const form = document.querySelector('form');
            const reassignRadio = document.getElementById('removedZoneActionReassign');
            const deleteRadio = document.getElementById('removedZoneActionDelete');
            const reassignSelect = document.getElementById('ReassignToZoneId');

            function toggleReassignSelect() {
                if (!reassignSelect) return;
                reassignSelect.disabled = !(reassignRadio && reassignRadio.checked);
            }

            function reindexZoneRows() {
                const rows = zonesTableBody.querySelectorAll('.zone-row');
                rows.forEach((row, index) => {
                    row.querySelectorAll('[name]').forEach(input => {
                        input.name = input.name.replace(/Zones\[\d+\]/g, `Zones[${index}]`);
                    });
                    row.querySelectorAll('[id]').forEach(input => {
                        input.id = input.id.replace(/Zones_\d+_/g, `Zones_${index}_`);
                    });
                });
            }

            function calculateZoneTotal() {
                const rows = zonesTableBody.querySelectorAll('.zone-row');
                let total = 0;
                rows.forEach(row => {
                    const isActive = row.querySelector('.zone-active-input')?.checked;
                    const percentVal = parseFloat(row.querySelector('.zone-percent-input')?.value || '0');
                    if (isActive) {
                        total += percentVal;
                    }
                });

                zoneTotalBadge.textContent = `Total: ${total.toFixed(2)}%`;
                if (Math.abs(total - 100) > 0.01) {
                    zoneTotalBadge.classList.remove('bg-success');
                    zoneTotalBadge.classList.add('bg-secondary');
                    zonePercentMessage.textContent = 'Total must be exactly 100% for active zones.';
                } else {
                    zoneTotalBadge.classList.remove('bg-secondary');
                    zoneTotalBadge.classList.add('bg-success');
                    zonePercentMessage.textContent = '';
                }
            }

            addZoneBtn?.addEventListener('click', function () {
                const firstRow = zonesTableBody.querySelector('.zone-row');
                if (!firstRow) return;

                const newRow = firstRow.cloneNode(true);
                newRow.querySelectorAll('input, select').forEach(el => {
                    if (el.type === 'hidden') {
                        el.value = '';
                    } else if (el.type === 'checkbox') {
                        el.checked = true;
                    } else if (el.classList.contains('zone-percent-input')) {
                        el.value = '0';
                    } else {
                        el.value = '';
                    }
                });
                newRow.querySelectorAll('.text-danger').forEach(span => span.textContent = '');
                zonesTableBody.appendChild(newRow);
                reindexZoneRows();
                calculateZoneTotal();
            });

            zonesTableBody?.addEventListener('click', function (e) {
                const button = e.target.closest('.btn-remove-zone');
                if (!button) return;

                const rows = zonesTableBody.querySelectorAll('.zone-row');
                if (rows.length <= 1) {
                    const row = rows[0];
                    row.querySelectorAll('input[type="text"], input[type="number"], select').forEach(el => el.value = '');
                    row.querySelector('.zone-active-input').checked = true;
                    row.querySelector('input[type="hidden"]').value = '';
                } else {
                    button.closest('.zone-row')?.remove();
                }

                reindexZoneRows();
                calculateZoneTotal();
            });

            zonesTableBody?.addEventListener('input', calculateZoneTotal);
            zonesTableBody?.addEventListener('change', calculateZoneTotal);

            form?.addEventListener('submit', function (e) {
                calculateZoneTotal();
                const totalText = zoneTotalBadge.textContent || '';
                const total = parseFloat(totalText.replace(/[^\d.]/g, '') || '0');
                if (Math.abs(total - 100) > 0.01) {
                    e.preventDefault();
                    zonePercentMessage.textContent = 'Please adjust active zones so total is exactly 100%.';
                }
            });

            reindexZoneRows();
            calculateZoneTotal();
            reassignRadio?.addEventListener('change', toggleReassignSelect);
            deleteRadio?.addEventListener('change', toggleReassignSelect);
            toggleReassignSelect();
        });
    </script>
}

