@model SAM.ViewModels.SystemAdmin.CropEditViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Edit Crop";
    var companies = ViewBag.Companies as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var user = await UserManager.GetUserAsync(User);
    var isGlobalAdmin = user != null && await UserManager.IsInRoleAsync(user, "admin");
}

@section PageTitleInline {
    <span tabindex="0"
          role="button"
          class="text-info"
          data-bs-toggle="tooltip"
          data-bs-html="true"
          data-bs-placement="left"
          title="<strong>Crop Backend Logic</strong><br/>At Crop Create/Edit, Annual PAN Limit is derived as PANLimit = NUptake.<br/>This value is used as the compliance threshold limit (lbs/acre/year).<br/><br/><strong>Wastewater PAN Formula (used in Monthly Application and reports):</strong><br/>PAN (lbs) = {[MR x (TKN - NH3)] + (1 - VR) x NH3 + NO2 + NO3} x 8.34 x Volume (mgal).<br/>PAN Loading (lbs/acre) = PAN (lbs) / acres.<br/>Defaults: MR=40%, VR=50%.">
        <i class="bi bi-info-circle fs-5"></i>
    </span>
}

<div class="mb-4">
    <p class="text-muted mb-0">Modify crop information and settings</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="CropEdit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section">
                <div class="form-section-title">Company Information</div>
                
                <div class="mb-3">
                    <label asp-for="CompanyId" class="form-label required"></label>
                    @if (isGlobalAdmin && companies != null)
                    {
                        <select asp-for="CompanyId" asp-items="companies" class="form-select">
                            <option value="">-- Select Company --</option>
                        </select>
                    }
                    else
                    {
                        <input type="hidden" asp-for="CompanyId" />
                        <input type="text" class="form-control" value="@companies?.FirstOrDefault(c => c.Value == Model.CompanyId.ToString())?.Text" disabled />
                    }
                    <span asp-validation-for="CompanyId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Crop Information</div>
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label required"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NUptake" class="form-label required"></label>
                    <input asp-for="NUptake" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="NUptake" class="text-danger"></span>
                    <small class="form-text text-muted">Nitrogen uptake rate in lbs/acre/year</small>
                </div>

            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="SystemAdmin" asp-route-tab="crops" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Update Crop
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (element) {
                bootstrap.Tooltip.getOrCreateInstance(element);
            });
        })();
    </script>
}



