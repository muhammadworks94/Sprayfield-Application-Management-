@model SAM.ViewModels.SystemAdmin.FacilityEditViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Edit Facility";
    var companies = ViewBag.Companies as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var facilityPermits = ViewBag.FacilityPermits as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var companyUsers = ViewBag.CompanyUsers as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var user = await UserManager.GetUserAsync(User);
    var isGlobalAdmin = user != null && await UserManager.IsInRoleAsync(user, "admin");
}

<div class="mb-4">
    <p class="text-muted mb-0">Modify facility information and settings. Permit address and sprayfield details are managed under System Administration &gt; Permits.</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="FacilityEdit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section">
                <div class="form-section-title">Company Information</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="CompanyId" class="form-label required"></label>
                            @if (isGlobalAdmin && companies != null)
                            {
                                <select asp-for="CompanyId" asp-items="companies" class="form-select">
                                    <option value="">-- Select Company --</option>
                                </select>
                            }
                            else
                            {
                                <input type="hidden" asp-for="CompanyId" />
                                <input type="text" class="form-control" value="@companies?.FirstOrDefault(c => c.Value == Model.CompanyId.ToString())?.Text" disabled />
                            }
                            <span asp-validation-for="CompanyId" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Facility Information</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label required"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Permittee" class="form-label required"></label>
                            <input asp-for="Permittee" class="form-control" />
                            <span asp-validation-for="Permittee" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="DefaultFacilityPermitId" class="form-label"></label>
                            <select asp-for="DefaultFacilityPermitId" asp-items="facilityPermits" class="form-select">
                                <option value="">-- Select Permit --</option>
                            </select>
                            <div class="form-text">Manage permit versions in <a asp-action="FacilityPermits" asp-route-facilityId="@Model.Id">Permit Versions</a>.</div>
                        </div>
                    </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="SigningOfficial" class="form-label"></label>
                                <input asp-for="SigningOfficial" class="form-control" />
                                <span asp-validation-for="SigningOfficial" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="FacilityContactPersonTitle" class="form-label"></label>
                                <input asp-for="FacilityContactPersonTitle" class="form-control" />
                                <span asp-validation-for="FacilityContactPersonTitle" class="text-danger"></span>
                            </div>
                        </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="FacilityClass" class="form-label required"></label>
                            <input asp-for="FacilityClass" class="form-control" />
                            <span asp-validation-for="FacilityClass" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="PermitPhone" class="form-label"></label>
                            <input asp-for="PermitPhone" class="form-control" />
                            <span asp-validation-for="PermitPhone" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="PersonsCollectingSamples" class="form-label"></label>
                            <input asp-for="PersonsCollectingSamples" class="form-control" />
                            <span asp-validation-for="PersonsCollectingSamples" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FacilityContactPerson" class="form-label"></label>
                            <input asp-for="FacilityContactPerson" class="form-control" />
                            <span asp-validation-for="FacilityContactPerson" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FacilityContactPersonPhone" class="form-label"></label>
                            <input asp-for="FacilityContactPersonPhone" class="form-control" />
                            <span asp-validation-for="FacilityContactPersonPhone" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="LagoonBermHeightFeet" class="form-label"></label>
                            <input asp-for="LagoonBermHeightFeet" type="number" step="0.01" class="form-control" />
                            <div class="form-text">Used to calculate storage lagoon freeboard from daily water depth.</div>
                            <span asp-validation-for="LagoonBermHeightFeet" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Operator in Responsible Charge (ORC)</div>
                <p class="text-muted small mb-3">
                    Assign a SAM user as the facility ORC with a start date. Ending an ORC sets the end date used to auto-mark
                    “Has the ORC changed?” on the following month’s NDAR-1 / NDMR / NDMLR reports.
                </p>
                @if (Model.CurrentOrcStartDate.HasValue)
                {
                    <div class="alert alert-light border py-2 mb-3">
                        <strong>Current ORC:</strong> @(Model.OrcName ?? "N/A")
                        since @Model.CurrentOrcStartDate.Value.ToString("MM/dd/yyyy")
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentOrcUserId))
                        {
                            <span class="text-muted">(SAM user assigned)</span>
                        }
                    </div>
                }
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="OrcUserId" class="form-label"></label>
                            <select asp-for="OrcUserId" class="form-select" asp-items="companyUsers">
                                <option value="">-- Select SAM user --</option>
                            </select>
                            <span asp-validation-for="OrcUserId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="OrcAssignmentStartDate" class="form-label"></label>
                            <input asp-for="OrcAssignmentStartDate" type="date" class="form-control" />
                            <div class="form-text">Required with a user (or ORC name) to assign/replace the current ORC.</div>
                            <span asp-validation-for="OrcAssignmentStartDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="EndCurrentOrcAsOf" class="form-label"></label>
                            <input asp-for="EndCurrentOrcAsOf" type="date" class="form-control" />
                            <div class="form-text">Optional. Ends the current ORC without assigning a replacement.</div>
                            <span asp-validation-for="EndCurrentOrcAsOf" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="OrcName" class="form-label"></label>
                            <input asp-for="OrcName" class="form-control" />
                            <div class="form-text">Defaults from the selected SAM user’s full name.</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="OperatorGrade" class="form-label"></label>
                            <input asp-for="OperatorGrade" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="OperatorNumber" class="form-label"></label>
                            <input asp-for="OperatorNumber" class="form-control" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="OperatorPhone" class="form-label"></label>
                            <input asp-for="OperatorPhone" class="form-control" />
                        </div>
                    </div>
                </div>
                @if (Model.OrcAssignmentHistory.Count > 0)
                {
                    <div class="table-responsive mt-2">
                        <table class="table table-sm table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th>ORC</th>
                                    <th>SAM User</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th>Cert / Grade / Phone</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in Model.OrcAssignmentHistory)
                            {
                                <tr class="@(row.IsCurrent ? "table-success" : null)">
                                    <td>@row.DisplayName @(row.IsCurrent ? "(current)" : "")</td>
                                    <td>@(row.UserName ?? "—")</td>
                                    <td>@row.StartDate.ToString("MM/dd/yyyy")</td>
                                    <td>@(row.EndDate?.ToString("MM/dd/yyyy") ?? "—")</td>
                                    <td>@(row.OperatorNumber ?? "—") / @(row.OperatorGrade ?? "—") / @(row.OperatorPhone ?? "—")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="form-section">
                <div class="form-section-title">PAN Calculation Defaults</div>
                <p class="text-muted small">Used for PAN (Plant Available Nitrogen) calculation. Defaults are 40% and 50%.</p>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="MineralizationRatePercent" class="form-label"></label>
                            <input asp-for="MineralizationRatePercent" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="40" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="VolatilizationRatePercent" class="form-label"></label>
                            <input asp-for="VolatilizationRatePercent" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="50" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between flex-wrap gap-2">
                <a asp-action="ModifyBaselineLoading" asp-route-facilityId="@Model.Id" class="btn btn-outline-primary">
                    <i class="bi bi-calendar-range me-1"></i>Modify Baseline Loading
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="FacilityDetails" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Update Facility
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
