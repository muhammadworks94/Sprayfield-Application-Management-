@model SAM.ViewModels.CompanyManagement.NewClientSetupBaselineViewModel
@using System.Globalization
@using SAM.Services.Helpers

@{
    string FormatLoadingInches(decimal? value) =>
        value.HasValue
            ? Math.Round(value.Value, 2, MidpointRounding.AwayFromZero).ToString("0.##", CultureInfo.InvariantCulture)
            : string.Empty;

    var baselineMonths = BaselineWindowHelper.GetHistoricalMonths(Model.ThroughYear, Model.ThroughMonth);
    var newestBaselineLabel = new DateTime(baselineMonths[0].Year, baselineMonths[0].Month, 1).ToString("MMMM yyyy");
    var oldestBaselineLabel = new DateTime(baselineMonths[^1].Year, baselineMonths[^1].Month, 1).ToString("MMMM yyyy");
    var firstReportingLabel = new DateTime(Model.ThroughYear, Model.ThroughMonth, 1).ToString("MMMM yyyy");
    var saveUrl = ViewData["BaselineSaveUrl"] as string
        ?? Url.Action("SaveBaselineCell", "CompanyManagement")!;
    var formAction = ViewData["BaselineFormAction"] as string
        ?? "FinishNewClientSetupBaseline";
    var formController = ViewData["BaselineFormController"] as string
        ?? "CompanyManagement";
}

<div class="alert alert-info">
    <i class="bi bi-info-circle me-1"></i>
    Enter monthly loading (inches/acre) for each field. Values autosave as you type.
    Enter monthly loading for the <strong>11 months before</strong> your first SAM reporting month (<strong>@firstReportingLabel</strong>): <strong>@newestBaselineLabel</strong> through <strong>@oldestBaselineLabel</strong>.
    Use <strong>Download Template</strong> / <strong>Import</strong> in the page header for Excel entry.
</div>

<div id="baselineSaveStatus" class="small text-muted mb-2" aria-live="polite"></div>

@foreach (var group in Model.FacilityGroups)
{
    <div class="card mb-4 baseline-facility-card" data-facility-id="@group.FacilityId">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-table me-1"></i>@group.FacilityName
                <span class="text-muted fw-normal">— Monthly Loading (inches/acre)</span>
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive responsive-table wide-data-table wwchar-daily-table-wrapper fixed-height-table-wrapper mb-0">
                <table class="table table-bordered table-sm wwchar-daily-table baseline-grid-table">
                    <thead>
                        <tr>
                            <th>Month</th>
                            @foreach (var column in group.SprayfieldColumns)
                            {
                                <th>
                                    <div class="fw-semibold">@column.FieldCode</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var row = 0; row < group.MonthRows.Count; row++)
                        {
                            var monthRow = group.MonthRows[row];
                            <tr data-year="@monthRow.Year" data-month="@monthRow.Month">
                                <th scope="row"><strong>@monthRow.Label</strong></th>
                                @for (var col = 0; col < monthRow.Cells.Count; col++)
                                {
                                    var cell = monthRow.Cells[col];
                                    var isReadOnly = cell.IsReadOnly;
                                    <td class="baseline-data-cell@(isReadOnly ? " baseline-cell-readonly" : "")"
                                        data-facility-id="@group.FacilityId"
                                        data-sprayfield-id="@cell.SprayfieldId"
                                        data-year="@monthRow.Year"
                                        data-month="@monthRow.Month"
                                        @if (isReadOnly && !string.IsNullOrWhiteSpace(cell.Tooltip))
                                        {
                                            <text>data-bs-toggle="tooltip" data-bs-placement="top" title="@cell.Tooltip"</text>
                                        }>
                                        <div class="input-group input-group-sm">
                                            @* @if (isReadOnly)
                                            {
                                                <span class="input-group-text text-muted" title="@cell.Tooltip" aria-hidden="true">
                                                    <i class="bi bi-lock-fill"></i>
                                                </span>
                                            } *@
                                            <input type="text"
                                                   inputmode="decimal"
                                                   class="form-control form-control-sm baseline-cell-input@(isReadOnly ? " text-muted" : "")"
                                                   value="@FormatLoadingInches(cell.LoadingInches)"
                                                   @(isReadOnly ? "disabled" : null)
                                                   aria-label="@monthRow.Label field @group.SprayfieldColumns[col].FieldCode loading inches@(isReadOnly ? " (read-only SAM data)" : "")"
                                                   @if (isReadOnly && !string.IsNullOrWhiteSpace(cell.Tooltip))
                                                   {
                                                       <text>title="@cell.Tooltip"</text>
                                                   } />
                                        </div>
                                        <div class="baseline-cell-status small text-muted"></div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<form asp-controller="@formController" asp-action="@formAction" method="post" id="finishBaselineForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CompanyId" />
    <input type="hidden" asp-for="ThroughYear" />
    <input type="hidden" asp-for="ThroughMonth" />
    @if (Model.FacilityId.HasValue)
    {
        <input type="hidden" asp-for="FacilityId" />
    }
    <div class="card">
        <div class="card-body d-flex justify-content-between gap-2">
            @if (Model.IsFacilityEditMode && Model.FacilityId.HasValue)
            {
                <a asp-controller="SystemAdmin" asp-action="FacilityEdit" asp-route-id="@Model.FacilityId" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Facility
                </a>
                <button type="submit" class="btn btn-primary" id="finishBaselineButton">
                    <i class="bi bi-check-circle me-1"></i>Done
                </button>
            }
            else
            {
                <div></div>
                <button type="submit" class="btn btn-primary" id="finishBaselineButton">
                    <i class="bi bi-check-circle me-1"></i>Finish Setup
                </button>
            }
        </div>
    </div>
</form>

<script src="~/js/grid-keyboard-navigation.js" asp-append-version="true"></script>
<script>
    (function () {
        const CELL_SAVE_DEBOUNCE_MS = 400;
        const saveUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(saveUrl));
        const antiForgery = document.querySelector('#finishBaselineForm input[name="__RequestVerificationToken"]')?.value ?? '';
        const throughYear = @Model.ThroughYear;
        const throughMonth = @Model.ThroughMonth;
        const saveStatus = document.getElementById('baselineSaveStatus');
        const finishForm = document.getElementById('finishBaselineForm');
        const isFacilityEditMode = @(Model.IsFacilityEditMode ? "true" : "false");

        const cellStates = new Map();
        let pendingSaveCount = 0;

        const parseInches = (raw) => {
            const trimmed = (raw ?? '').trim();
            if (!trimmed) return null;
            const value = Number(trimmed);
            return Number.isFinite(value) && value > 0 ? value : null;
        };

        const setCellStatus = (cell, state, message) => {
            const statusEl = cell.querySelector('.baseline-cell-status');
            if (!statusEl) return;
            statusEl.textContent = message ?? '';
            statusEl.classList.toggle('text-danger', state === 'error');
            statusEl.classList.toggle('text-success', state === 'saved');
        };

        const updateGlobalStatus = () => {
            if (pendingSaveCount > 0) {
                saveStatus.textContent = `Saving ${pendingSaveCount} change${pendingSaveCount === 1 ? '' : 's'}...`;
            } else {
                saveStatus.textContent = 'All changes saved.';
            }
        };

        const getCellState = (input) => {
            const cell = input.closest('.baseline-data-cell');
            const key = `${cell.dataset.facilityId}:${cell.dataset.sprayfieldId}:${cell.dataset.year}:${cell.dataset.month}`;
            if (!cellStates.has(key)) {
                cellStates.set(key, {
                    lastSavedSignature: input.value.trim(),
                    debounceTimer: null,
                    saveInFlight: false,
                    rescheduleAfterFlight: false
                });
            }
            return { key, cell, state: cellStates.get(key) };
        };

        const saveCell = async (input, options = {}) => {
            const { cell, state } = getCellState(input);
            const signature = input.value.trim();

            if (!options.force && signature === state.lastSavedSignature) {
                return;
            }

            if (state.saveInFlight) {
                state.rescheduleAfterFlight = true;
                return;
            }

            state.saveInFlight = true;
            pendingSaveCount++;
            updateGlobalStatus();
            setCellStatus(cell, 'saving', 'Saving...');

            const payload = {
                facilityId: cell.dataset.facilityId,
                sprayfieldId: cell.dataset.sprayfieldId,
                throughYear,
                throughMonth,
                year: parseInt(cell.dataset.year, 10),
                month: parseInt(cell.dataset.month, 10),
                loadingInches: parseInches(signature)
            };

            let saveSucceeded = false;
            try {
                const resp = await fetch(saveUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgery
                    },
                    body: JSON.stringify(payload)
                });

                const result = await resp.json().catch(() => null);
                if (!resp.ok || !result?.success) {
                    setCellStatus(cell, 'error', result?.message || 'Save failed');
                    return;
                }

                saveSucceeded = true;
                state.lastSavedSignature = signature;
                setCellStatus(cell, 'saved', 'Saved');
                setTimeout(() => {
                    if (state.lastSavedSignature === input.value.trim()) {
                        setCellStatus(cell, 'idle', '');
                    }
                }, 1500);
            } catch {
                setCellStatus(cell, 'error', 'Save failed');
            } finally {
                state.saveInFlight = false;
                pendingSaveCount = Math.max(0, pendingSaveCount - 1);
                updateGlobalStatus();

                if (saveSucceeded && (state.rescheduleAfterFlight || input.value.trim() !== state.lastSavedSignature)) {
                    state.rescheduleAfterFlight = false;
                    await saveCell(input, options);
                } else {
                    state.rescheduleAfterFlight = false;
                }
            }
        };

        const scheduleCellSave = (input) => {
            const { state } = getCellState(input);
            if (state.debounceTimer) {
                clearTimeout(state.debounceTimer);
            }
            setCellStatus(getCellState(input).cell, 'dirty', 'Unsaved');
            state.debounceTimer = setTimeout(() => {
                state.debounceTimer = null;
                saveCell(input);
            }, CELL_SAVE_DEBOUNCE_MS);
        };

        const flushAllDirtyCells = async () => {
            const inputs = document.querySelectorAll('.baseline-cell-input:not(:disabled)');
            for (const input of inputs) {
                const { state } = getCellState(input);
                if (state.debounceTimer) {
                    clearTimeout(state.debounceTimer);
                    state.debounceTimer = null;
                }
                if (input.value.trim() !== state.lastSavedSignature) {
                    await saveCell(input, { force: true });
                }
            }
        };

        document.querySelectorAll('.baseline-cell-input:not(:disabled)').forEach(input => {
            getCellState(input);
            input.addEventListener('input', () => scheduleCellSave(input));
            input.addEventListener('blur', () => {
                const { state } = getCellState(input);
                if (state.debounceTimer) {
                    clearTimeout(state.debounceTimer);
                    state.debounceTimer = null;
                }
                saveCell(input);
            });
        });

        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
            if (window.bootstrap?.Tooltip) {
                bootstrap.Tooltip.getOrCreateInstance(el);
            }
        });

        document.querySelectorAll('table.baseline-grid-table').forEach((grid) => {
            SAM.gridKeyboardNavigation.init({
                root: grid,
                cellSelector: 'input.baseline-cell-input:not(:disabled)',
                rowSelector: 'tbody tr[data-year][data-month]'
            });
        });

        finishForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            await flushAllDirtyCells();

            if (pendingSaveCount > 0) {
                window.alert('Please wait for pending saves to complete.');
                return;
            }

            if (window.SAMLoading) {
                window.SAMLoading.show(isFacilityEditMode ? 'Saving baseline loading...' : 'Finishing client setup...');
            }

            finishForm.submit();
        });

        window.addEventListener('beforeunload', (event) => {
            const hasDirty = [...document.querySelectorAll('.baseline-cell-input:not(:disabled)')].some(input => {
                const { state } = getCellState(input);
                return input.value.trim() !== state.lastSavedSignature || state.debounceTimer || state.saveInFlight;
            });

            if (hasDirty || pendingSaveCount > 0) {
                event.preventDefault();
                event.returnValue = '';
            }
        });

        updateGlobalStatus();
    })();
</script>
