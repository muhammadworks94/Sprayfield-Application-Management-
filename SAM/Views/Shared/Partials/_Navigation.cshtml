@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@inject UserManager<ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var isAdmin = user != null && await UserManager.IsInRoleAsync(user, "admin");
    var isCompanyAdmin = user != null && (await UserManager.IsInRoleAsync(user, "admin") || await UserManager.IsInRoleAsync(user, "company_admin"));
    var isOperator = user != null && (await UserManager.IsInRoleAsync(user, "admin") || await UserManager.IsInRoleAsync(user, "company_admin") || await UserManager.IsInRoleAsync(user, "operator"));
    var isTechnician = user != null && (await UserManager.IsInRoleAsync(user, "admin") || await UserManager.IsInRoleAsync(user, "company_admin") || await UserManager.IsInRoleAsync(user, "technician"));
}

<nav class="app-sidebar enterprise-sidebar" id="sidebar" role="navigation" aria-label="Main navigation">
    <div class="sidebar-header">
        <div class="sidebar-brand-wrapper">
            <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index" aria-label="SAM Dashboard">
                <i class="bi bi-shield-check sidebar-brand-icon"></i>
                <span class="sidebar-brand-text">SAM</span>
            </a>
        </div>
        <button class="sidebar-toggle d-none d-md-flex" id="sidebarCollapseToggle" type="button" aria-label="Toggle sidebar" aria-expanded="true">
            <i class="bi bi-chevron-left"></i>
        </button>
    </div>

    <ul class="sidebar-nav" role="menubar">
        <li class="nav-item" role="none">
            <a class="nav-link" asp-controller="Dashboard" asp-action="Index" role="menuitem" data-tooltip="Dashboard">
                <i class="bi bi-speedometer2"></i>
                <span class="nav-link-text">Dashboard</span>
            </a>
        </li>
        <li class="nav-item" role="none">
            <a class="nav-link" asp-controller="Analytics" asp-action="Index" role="menuitem" data-tooltip="Analytics">
                <i class="bi bi-bar-chart-line"></i>
                <span class="nav-link-text">Analytics</span>
            </a>
        </li>
        @if (isOperator)
        {
            <li class="nav-item" role="none">
                <a class="nav-link" asp-controller="OperationalData" asp-action="IrrigationEntry" role="menuitem" data-tooltip="Irrigation Entry">
                    <i class="bi bi-cloud-rain"></i>
                    <span class="nav-link-text">Irrigation Entry</span>
                </a>
            </li>
            <li class="nav-item" role="none">
                <a class="nav-link" asp-controller="OperationalData" asp-action="OperatorEntry" role="menuitem" data-tooltip="Operator Entry">
                    <i class="bi bi-journal-text"></i>
                    <span class="nav-link-text">Operator Entry</span>
                </a>
            </li>
        }
        @if (isTechnician)
        {
            <li class="nav-item" role="none">
                <a class="nav-link" asp-controller="OperationalData" asp-action="WastewaterTesting" role="menuitem" data-tooltip="Wastewater Testing">
                    <i class="bi bi-droplet-half"></i>
                    <span class="nav-link-text">Wastewater Testing</span>
                </a>
            </li>
            <li class="nav-item" role="none">
                <a class="nav-link" asp-controller="OperationalData" asp-action="GroundwaterTesting" role="menuitem" data-tooltip="Groundwater Testing">
                    <i class="bi bi-water"></i>
                    <span class="nav-link-text">Groundwater Testing</span>
                </a>
            </li>
        }

        @if (isCompanyAdmin)
        {
            <li class="nav-item nav-dropdown-item pb-1" role="none">
                <button class="nav-dropdown-toggle" type="button" aria-expanded="false" aria-controls="dropdown-reports" data-dropdown="reports" data-tooltip="Reports">
                    <i class="bi bi-file-earmark-text"></i>
                    <span class="nav-link-text">Reports</span>
                    <i class="bi bi-chevron-down nav-dropdown-chevron"></i>
                </button>
                <ul class="nav-dropdown" id="dropdown-reports" role="menu">
                    <li class="nav-item" role="none">
                        <a class="nav-link" asp-controller="Reports" asp-action="NDAR1Reports" role="menuitem" data-tooltip="NDAR-1">
                            <i class="bi bi-file-earmark-text"></i>
                            <span class="nav-link-text">NDAR-1</span>
                        </a>
                    </li>
                    <li class="nav-item" role="none">
                        <a class="nav-link" asp-controller="Reports" asp-action="NDMRReports" role="menuitem" data-tooltip="NDMR">
                            <i class="bi bi-file-earmark-text"></i>
                            <span class="nav-link-text">NDMR</span>
                        </a>
                    </li>
                    <li class="nav-item" role="none">
                        <a class="nav-link" asp-controller="Reports" asp-action="NDMLRReports" role="menuitem" data-tooltip="NDMLR">
                            <i class="bi bi-file-earmark-text"></i>
                            <span class="nav-link-text">NDMLR</span>
                        </a>
                    </li>
                    <li class="nav-item" role="none">
                        <a class="nav-link" asp-controller="Reports" asp-action="GroundwaterQualityReports" role="menuitem" data-tooltip="GW-59">
                            <i class="bi bi-water"></i>
                            <span class="nav-link-text">GW-59</span>
                        </a>
                    </li>
                </ul>
            </li>
        }

        @if (isOperator || isTechnician)
        {
            <li class="nav-item border-separate" role="none">
                <a class="nav-link" asp-controller="SystemAdmin" asp-action="SystemAdmin" asp-route-tab="facilities" role="menuitem" data-tooltip="System Administration">
                    <i class="bi bi-gear"></i>
                    <span class="nav-link-text">System Administration</span>
                </a>
            </li>
        }

        @if (isCompanyAdmin)
        {
            <li class="nav-item" role="none">
                <a class="nav-link" asp-controller="UserManagement" asp-action="Index" role="menuitem" data-tooltip="Users">
                    <i class="bi bi-people"></i>
                    <span class="nav-link-text">Users</span>
                </a>
            </li>
        }

    </ul>

    @if (isAdmin)
    {
        <div class="sidebar-footer">
            <ul class="sidebar-nav" role="menubar">
                <li class="nav-item nav-dropdown-item" role="none">
                    <button class="nav-dropdown-toggle" type="button" aria-expanded="false" aria-controls="dropdown-logs" data-dropdown="logs" data-tooltip="Logs">
                        <i class="bi bi-journal-text"></i>
                        <span class="nav-link-text">Logs</span>
                        <i class="bi bi-chevron-down nav-dropdown-chevron"></i>
                    </button>
                    <ul class="nav-dropdown" id="dropdown-logs" role="menu">
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="UserActivityLogs" asp-action="Index" role="menuitem" data-tooltip="User activity">
                                <i class="bi bi-clock-history"></i>
                                <span class="nav-link-text">User activity</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="ErrorLogs" asp-action="Index" role="menuitem" data-tooltip="Error Logs">
                                <i class="bi bi-exclamation-octagon"></i>
                                <span class="nav-link-text">Error Logs</span>
                            </a>
                        </li>
                        <li class="nav-item" role="none">
                            <a class="nav-link" asp-controller="EmailLogs" asp-action="Index" role="menuitem" data-tooltip="Email Logs">
                                <i class="bi bi-envelope-check"></i>
                                <span class="nav-link-text">Email Logs</span>
                            </a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item" role="none">
                    <a class="nav-link" asp-controller="EmailTemplates" asp-action="Index" role="menuitem" data-tooltip="Email Templates">
                        <i class="bi bi-envelope-paper"></i>
                        <span class="nav-link-text">Email Templates</span>
                    </a>
                </li>
                <li class="nav-item" role="none">
                    <a class="nav-link" asp-controller="CompanyManagement" asp-action="NewClientSetup" role="menuitem" data-tooltip="New Client Setup">
                        <i class="bi bi-calendar-range"></i>
                        <span class="nav-link-text">New Client Setup</span>
                    </a>
                </li>
                <li class="nav-item" role="none">
                    <a class="nav-link" asp-controller="CompanyManagement" asp-action="Index" role="menuitem" data-tooltip="Manage Companies">
                        <i class="bi bi-building-gear"></i>
                        <span class="nav-link-text">Manage Companies</span>
                    </a>
                </li>
                <li class="nav-item" role="none">
                    <a class="nav-link" asp-controller="UserManagement" asp-action="ManageAdmins" role="menuitem" data-tooltip="Global Admins">
                        <i class="bi bi-shield-check"></i>
                        <span class="nav-link-text">Global Admins</span>
                    </a>
                </li>
                <li class="nav-item" role="none">
                    <a class="nav-link" asp-controller="ProjectKnowledge" asp-action="Index" role="menuitem" data-tooltip="Project Knowledge">
                        <i class="bi bi-diagram-3"></i>
                        <span class="nav-link-text">Project Knowledge</span>
                    </a>
                </li>
            </ul>
        </div>
    }
</nav>

<div class="sidebar-overlay" id="sidebarOverlay"></div>


