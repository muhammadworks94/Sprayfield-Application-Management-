@model SAM.ViewModels.OperationalData.MonthlyApplicationsIndexViewModel
@using SAM.Services.Helpers
@{
    ViewData["Title"] = "Irrigation Entry";
    var facilities = Model.Facilities;
    var sprayfields = Model.Sprayfields;
    var selectedFacilityId = Model.Filter.FacilityId;
    var selectedSprayfieldId = Model.Filter.SprayfieldId;
    var selectedMonth = Model.Filter.Month;
    var selectedYear = Model.Filter.Year;
    var items = Model.Applications.Items;
    var totalPages = Model.Applications.TotalPages;
    var currentPage = Model.Applications.Page;

    string NextSortDir(string column) =>
        string.Equals(Model.Sort.SortBy, column, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(Model.Sort.SortDir, "asc", StringComparison.OrdinalIgnoreCase)
            ? "desc"
            : "asc";

    bool IsActiveSort(string column) => string.Equals(Model.Sort.SortBy, column, StringComparison.OrdinalIgnoreCase);

    var dateNextSortDir = NextSortDir("applicationDate");
    var sprayfieldNextSortDir = NextSortDir("sprayfield");
    var dailyLoadingNextSortDir = NextSortDir("dailyLoading");
    var volumeNextSortDir = NextSortDir("volume");
    var maxHourlyNextSortDir = NextSortDir("maxHourlyLoading");
}

@section PageTitleInline {
    <span tabindex="0"
          role="button"
          class="text-info"
          data-bs-toggle="tooltip"
          data-bs-html="true"
          data-bs-placement="left"
          title="<strong>Monthly Application Backend Logic</strong><br/>Wastewater PAN formula used here:<br/>PAN (lbs) = {[MR x (TKN - NH3)] + (1 - VR) x NH3 + NO2 + NO3} x 8.34 x Volume (mgal).<br/>PAN Loading (lbs/acre) = PAN (lbs) / acres.<br/>MR/VR come from Facility defaults (40%/50% if missing), chemistry comes from WWChar monthly values.<br/>Annual PAN limit threshold comes from Crop PANLimit (derived at crop save).<br/>12-month rolling PAN and hydraulic utilization are computed; warnings trigger at 85% and 100%.">
        <i class="bi bi-info-circle fs-5"></i>
    </span>
}

@section PageTitleExtra {
    <button class="btn btn-sm btn-outline-secondary"
            type="button"
            id="toggleMonthlyApplicationFilters"
            data-bs-toggle="collapse"
            data-bs-target="#monthlyApplicationFiltersCollapse"
            aria-expanded="false"
            aria-controls="monthlyApplicationFiltersCollapse">
        <i class="bi bi-funnel me-1"></i><span>Show Filters</span>
    </button>
}

<div class="d-flex justify-content-between align-items-center mb-4 page-intro">
    <div>
        <p class="text-muted mb-0">Track and manage irrigation entry records.</p>
    </div>
</div>

<div class="collapse mb-3" id="monthlyApplicationFiltersCollapse">
    <div class="card">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <select name="facilityId" id="facilityId" class="form-select">
                        <option value="">All Facilities</option>
                        @if (facilities != null)
                        {
                            @foreach (var facility in facilities)
                            {
                                <option value="@facility.Value" selected="@(selectedFacilityId.HasValue && selectedFacilityId.Value.ToString() == facility.Value)">
                                    @facility.Text
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="sprayfieldId" id="sprayfieldId" class="form-select">
                        <option value="">All Sprayfields</option>
                        @if (sprayfields != null)
                        {
                            @foreach (var sprayfield in sprayfields)
                            {
                                <option value="@sprayfield.Value" selected="@(selectedSprayfieldId.HasValue && selectedSprayfieldId.Value.ToString() == sprayfield.Value)">
                                    @sprayfield.Text
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="month" id="month" class="form-select">
                        <option value="">All Months</option>
                        @for (var m = 1; m <= 12; m++)
                        {
                            var monthName = new DateTime(2000, m, 1).ToString("MMMM");
                            <option value="@m" selected="@(selectedMonth.HasValue && selectedMonth.Value == m)">@monthName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="number" placeholder="Year" id="year" name="year" min="2000" max="2100" class="form-control" value="@(selectedYear?.ToString() ?? string.Empty)" />
                </div>
                <div class="col-md-1">
                    <select name="pageSize" id="pageSize" class="form-select">
                        @foreach (var size in new[] { 25, 50, 100, 200 })
                        {
                            if (Model.Filter.PageSize == size)
                            {
                                <option value="@size" selected>@size</option>
                            }
                            else
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <input type="hidden" name="sortBy" value="@Model.Sort.SortBy" />
                    <input type="hidden" name="sortDir" value="@Model.Sort.SortDir" />
                    <input type="hidden" name="page" value="1" />
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-funnel"></i> Apply
                    </button>
                    <a asp-action="IrrigationEntry" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-x-circle"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-4 page-section-header">
            <div class="btn-group" role="group" aria-label="View mode toggle">
                <button type="button" class="btn btn-outline-secondary btn-sm active" id="monthlyAppsTableViewBtn">
                    <i class="bi bi-table"></i> Table
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="monthlyAppsCardViewBtn">
                    <i class="bi bi-grid-3x3-gap"></i> Cards
                </button>
            </div>
            <a asp-action="MonthlyApplicationCreate" asp-route-facilityId="@selectedFacilityId" asp-route-sprayfieldId="@selectedSprayfieldId" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle"></i> Add Application
            </a>
        </div>

        @if (items.Any())
        {
            <div id="monthlyAppsTableView" class="table-responsive responsive-table monthly-apps-table-wrapper fixed-height-table-wrapper">
                <table class="table table-hover monthly-apps-table">
                    <thead>
                        <tr>
                            <th>
                                <a asp-action="IrrigationEntry"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-sprayfieldId="@Model.Filter.SprayfieldId"
                                   asp-route-month="@Model.Filter.Month"
                                   asp-route-year="@Model.Filter.Year"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="applicationDate"
                                   asp-route-sortDir="@dateNextSortDir">
                                    Date
                                    @if (IsActiveSort("applicationDate"))
                                    {
                                        <i class="bi @(Model.Sort.SortDir == "asc" ? "bi-sort-up" : "bi-sort-down") ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="IrrigationEntry"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-sprayfieldId="@Model.Filter.SprayfieldId"
                                   asp-route-month="@Model.Filter.Month"
                                   asp-route-year="@Model.Filter.Year"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="sprayfield"
                                   asp-route-sortDir="@sprayfieldNextSortDir">
                                    Sprayfield
                                    @if (IsActiveSort("sprayfield"))
                                    {
                                        <i class="bi @(Model.Sort.SortDir == "asc" ? "bi-sort-up" : "bi-sort-down") ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="IrrigationEntry"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-sprayfieldId="@Model.Filter.SprayfieldId"
                                   asp-route-month="@Model.Filter.Month"
                                   asp-route-year="@Model.Filter.Year"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="dailyLoading"
                                   asp-route-sortDir="@dailyLoadingNextSortDir">
                                    Daily Loading (in)
                                    @if (IsActiveSort("dailyLoading"))
                                    {
                                        <i class="bi @(Model.Sort.SortDir == "asc" ? "bi-sort-up" : "bi-sort-down") ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="IrrigationEntry"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-sprayfieldId="@Model.Filter.SprayfieldId"
                                   asp-route-month="@Model.Filter.Month"
                                   asp-route-year="@Model.Filter.Year"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="volume"
                                   asp-route-sortDir="@volumeNextSortDir">
                                    Volume (gal)
                                    @if (IsActiveSort("volume"))
                                    {
                                        <i class="bi @(Model.Sort.SortDir == "asc" ? "bi-sort-up" : "bi-sort-down") ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="IrrigationEntry"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-sprayfieldId="@Model.Filter.SprayfieldId"
                                   asp-route-month="@Model.Filter.Month"
                                   asp-route-year="@Model.Filter.Year"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="maxHourlyLoading"
                                   asp-route-sortDir="@maxHourlyNextSortDir">
                                    Maximum Hourly Loading (inches/acre)
                                    @if (IsActiveSort("maxHourlyLoading"))
                                    {
                                        <i class="bi @(Model.Sort.SortDir == "asc" ? "bi-sort-up" : "bi-sort-down") ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th class="table-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td>
                                <a asp-action="MonthlyApplicationDetails" asp-route-id="@item.Id">
                                    @item.ApplicationDate.ToString("MM/dd/yyyy")
                                </a>
                            </td>
                            <td>@item.SprayfieldName</td>
                            <td>@(MonthlyApplicationCalculationHelper.FormatDailyLoadingInchesDisplay(item.DailyLoadingInches) ?? "-")</td>
                            <td>@item.VolumeGallons.ToString("F2")</td>
                            <td>@item.MaximumHourlyLoadingInchesPerAcre.ToString("F2")</td>
                            <td class="table-actions">
                                <div class="d-inline-flex flex-nowrap align-items-center gap-1">
                                    <a asp-action="MonthlyApplicationEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal@(item.Id.ToString().Replace("-", ""))">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                                <div class="modal fade" id="deleteModal@(item.Id.ToString().Replace("-", ""))" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Confirm Delete</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete this monthly application?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="MonthlyApplicationDelete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div id="monthlyAppsCardView" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 d-none responsive-card-grid">
                @foreach (var item in items)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header-light d-flex justify-content-between align-items-start">
                                <h6 class="mb-0">@item.ApplicationDate.ToString("MM/dd/yyyy")</h6>
                                <small class="text-muted">@item.FacilityName</small>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <dl class="row small mb-3">
                                    <dt class="col-5">Sprayfield</dt>
                                    <dd class="col-7 mb-1">@item.SprayfieldName</dd>

                                    <dt class="col-5">Zone</dt>
                                    <dd class="col-7 mb-1">@item.ZoneName</dd>

                                    <dt class="col-5">Zone Acres</dt>
                                    <dd class="col-7 mb-1">@(item.ZoneAcres.HasValue ? $"{item.ZoneAcres.Value:F2} acres" : "-")</dd>

                                    <dt class="col-5">Volume</dt>
                                    <dd class="col-7 mb-1">@item.VolumeGallons.ToString("F2") gal</dd>

                                    <dt class="col-5">Daily Loading</dt>
                                    <dd class="col-7 mb-1">@(MonthlyApplicationCalculationHelper.FormatDailyLoadingInchesDisplay(item.DailyLoadingInches) is string dl ? $"{dl} in" : "-")</dd>

                                    <dt class="col-5">Time</dt>
                                    <dd class="col-7 mb-1">@(item.TimeIrrigatedMinutes?.ToString("F2") ?? "-") min</dd>

                                    <dt class="col-5">Max Hourly Loading</dt>
                                    <dd class="col-7 mb-1">@item.MaximumHourlyLoadingInchesPerAcre.ToString("F2") inches/acre</dd>

                                    <dt class="col-5">Operator</dt>
                                    <dd class="col-7 mb-1">@item.OperatorSnapshotName</dd>
                                </dl>

                                <div class="mt-auto d-flex justify-content-end">
                                    <div class="btn-group" role="group" aria-label="Monthly application actions">
                                        <a asp-action="MonthlyApplicationEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModalCard@(item.Id.ToString().Replace("-", ""))">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="deleteModalCard@(item.Id.ToString().Replace("-", ""))" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Confirm Delete</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are you sure you want to delete this monthly application?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="MonthlyApplicationDelete" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination">
                        @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="IrrigationEntry"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-sprayfieldId="@Model.Filter.SprayfieldId"
                                   asp-route-month="@Model.Filter.Month"
                                   asp-route-year="@Model.Filter.Year"
                                   asp-route-page="@pageNumber"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="@Model.Sort.SortBy"
                                   asp-route-sortDir="@Model.Sort.SortDir">@pageNumber</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox ui-empty-icon"></i>
                <p class="text-muted mt-3 mb-1">No monthly applications found.</p>
                <p class="text-muted small mb-3">Create your first monthly application record to get started.</p>
                <a asp-action="MonthlyApplicationCreate" asp-route-facilityId="@selectedFacilityId" asp-route-sprayfieldId="@selectedSprayfieldId" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle"></i> Create First Application
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const tableBtn = document.getElementById('monthlyAppsTableViewBtn');
            const cardBtn = document.getElementById('monthlyAppsCardViewBtn');
            const tableView = document.getElementById('monthlyAppsTableView');
            const cardView = document.getElementById('monthlyAppsCardView');
            const storageKey = 'monthlyApplicationsViewMode';

            function setViewMode(mode) {
                const isTable = mode === 'table';

                if (isTable) {
                    tableView?.classList.remove('d-none');
                    cardView?.classList.add('d-none');
                    tableBtn?.classList.add('active');
                    cardBtn?.classList.remove('active');
                } else {
                    tableView?.classList.add('d-none');
                    cardView?.classList.remove('d-none');
                    tableBtn?.classList.remove('active');
                    cardBtn?.classList.add('active');
                }

                if (window.localStorage) {
                    localStorage.setItem(storageKey, mode);
                }
            }

            const savedMode = window.localStorage ? localStorage.getItem(storageKey) : null;
            setViewMode(savedMode === 'card' ? 'card' : 'table');

            tableBtn?.addEventListener('click', function () { setViewMode('table'); });
            cardBtn?.addEventListener('click', function () { setViewMode('card'); });

            const filterToggleBtn = document.getElementById('toggleMonthlyApplicationFilters');
            const filterCollapseElement = document.getElementById('monthlyApplicationFiltersCollapse');
            if (filterToggleBtn && filterCollapseElement && typeof bootstrap !== 'undefined') {
                const filterCollapse = bootstrap.Collapse.getOrCreateInstance(filterCollapseElement, { toggle: false });
                const label = filterToggleBtn.querySelector('span');

                function setFilterToggleState(isExpanded) {
                    filterToggleBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
                    if (label) {
                        label.textContent = isExpanded ? 'Hide Filters' : 'Show Filters';
                    }
                }

                filterCollapse.hide();
                setFilterToggleState(false);

                filterCollapseElement.addEventListener('shown.bs.collapse', function () {
                    setFilterToggleState(true);
                });

                filterCollapseElement.addEventListener('hidden.bs.collapse', function () {
                    setFilterToggleState(false);
                });
            }

            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (element) {
                bootstrap.Tooltip.getOrCreateInstance(element);
            });
        })();
    </script>
}
