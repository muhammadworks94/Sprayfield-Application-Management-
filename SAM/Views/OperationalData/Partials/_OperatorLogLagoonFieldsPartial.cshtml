@model SAM.ViewModels.OperationalData.IOperatorLogLagoonFields
@{
    var belowMinimum = Model.StorageFt.HasValue
        && Model.PermittedMinimumFreeboardFeet.HasValue
        && Model.StorageFt.Value < Model.PermittedMinimumFreeboardFeet.Value;
    var freeboardClass = belowMinimum ? "text-danger fw-semibold" : string.Empty;
}

<div class="row lagoon-freeboard-section"
     data-lagoon-section="true"
     data-berm-height="@(Model.LagoonBermHeightFeet?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
     data-min-freeboard="@(Model.PermittedMinimumFreeboardFeet?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
    <div class="col-md-3">
        <div class="mb-3">
            <label asp-for="WaterDepthFt" class="form-label"></label>
            <input asp-for="WaterDepthFt" type="number" step="0.01" class="form-control lagoon-water-depth-input" />
            <span asp-validation-for="WaterDepthFt" class="text-danger"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="mb-3">
            <label class="form-label">Lagoon Berm Height (ft)</label>
            <input type="text" class="form-control lagoon-berm-height-display" readonly
                   value="@(Model.LagoonBermHeightFeet.HasValue ? Model.LagoonBermHeightFeet.Value.ToString("F2") : "Not configured")" />
        </div>
    </div>
    <div class="col-md-3">
        <div class="mb-3">
            <label class="form-label">Storage Lagoon Freeboard (ft)</label>
            <input type="text" class="form-control lagoon-freeboard-display @freeboardClass" readonly
                   value="@(Model.StorageFt.HasValue ? Model.StorageFt.Value.ToString("F2") : "")" />
            @if (Model.IsLegacyFreeboardEntry)
            {
                <small class="form-text text-muted">Legacy entry — enter water depth to recalculate.</small>
            }
        </div>
    </div>
    <div class="col-md-3">
        <div class="mb-3">
            <label class="form-label">Required Minimum Freeboard (ft)</label>
            <input type="text" class="form-control lagoon-min-freeboard-display" readonly
                   value="@(Model.PermittedMinimumFreeboardFeet.HasValue ? Model.PermittedMinimumFreeboardFeet.Value.ToString("F2") : "N/A")" />
        </div>
    </div>
</div>
