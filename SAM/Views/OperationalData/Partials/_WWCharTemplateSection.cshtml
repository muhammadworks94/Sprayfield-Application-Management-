@model SAM.ViewModels.OperationalData.WWCharTemplateSectionViewModel
@using SAM.Domain.Enums
@using SAM.Utilities
@{
    var orcOnSiteOptions = ViewBag.ORCOnSiteOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var permitHref = Model.FacilityId != Guid.Empty
        ? Url.Action("FacilityPermits", "SystemAdmin", new
        {
            facilityId = Model.FacilityId,
            source = "wwchar",
            month = (int)Model.Month,
            year = Model.Year
        })
        : string.Empty;
}

<div class="form-section"
     data-wwchar-template-section="true"
     data-facility-id="@Model.FacilityId"
     data-facility-permit-id="@(Model.FacilityPermitId?.ToString() ?? string.Empty)"
     data-facility-permit-display="@(Model.FacilityPermitDisplay ?? string.Empty)"
     data-month="@((int)Model.Month)"
     data-year="@Model.Year"
     data-berm-height="@(Model.LagoonBermHeightFeet?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
     data-min-freeboard="@(Model.PermittedMinimumFreeboardFeet?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
    <div class="form-section-title">Attachment A Template Daily Data (Days 1-31)</div>
    <p class="text-muted small mb-2">Template rows are month-filtered and shown as daily entry columns.</p>

    @if (Model.TemplateParameters.Any())
    {
        if (Model.IsEdit)
        {
            <div class="alert alert-info py-2 small">
                Updates to <strong>ORC On Site</strong>, <strong>Water Depth (ft)</strong>, <strong>ORC Arrival Time</strong>, and <strong>ORC Time on Site</strong> are synced through Operator Entry for the exact day and automatically reflected anywhere this date is used. Storage lagoon freeboard is calculated from lagoon berm height minus water depth.
            </div>
        }

        <div class="alert alert-light border py-2 small mb-2">
            Lagoon Berm Height =
            @(Model.LagoonBermHeightFeet.HasValue ? $"{Model.LagoonBermHeightFeet.Value:F2} ft" : "not configured")
            |
            Required Minimum Freeboard =
            @(Model.PermittedMinimumFreeboardFeet.HasValue ? $"{Model.PermittedMinimumFreeboardFeet.Value:F2} ft" : "N/A")
        </div>

        @for (int p = 0; p < Model.TemplateParameters.Count; p++)
        {
            <input type="hidden" name="TemplateParameters[@p].FacilityPermitTemplateParameterId" value="@Model.TemplateParameters[p].FacilityPermitTemplateParameterId" />
            <input type="hidden" name="TemplateParameters[@p].PcsCode" value="@Model.TemplateParameters[p].PcsCode" />
            <input type="hidden" name="TemplateParameters[@p].ParameterName" value="@Model.TemplateParameters[p].ParameterName" />
            <input type="hidden" name="TemplateParameters[@p].Units" value="@Model.TemplateParameters[p].Units" />
            <input type="hidden" name="TemplateParameters[@p].Notes" value="@Model.TemplateParameters[p].Notes" />
        }

        <div class="table-responsive responsive-table wide-data-table wwchar-daily-table-wrapper fixed-height-table-wrapper mb-3">
            <table class="table table-bordered table-sm wwchar-daily-table" id="wwcharLagoonDailyTable">
                <thead>
                    <tr>
                        <th>Day</th>
                        <th>ORC On Site</th>
                        <th>Water Depth (ft)</th>
                        <th>Storage Lagoon Freeboard (ft)</th>
                        <th>ORC Arrival Time (24H)</th>
                        <th>ORC Time on Site (hours)</th>
                        @for (int p = 0; p < Model.TemplateParameters.Count; p++)
                        {
                            var isFlowPcs = NdmrFlowFormatting.IsFlowPcs(Model.TemplateParameters[p].PcsCode);
                            <th>
                                @Model.TemplateParameters[p].PcsCode
                                <div class="small fw-normal">
                                    @Model.TemplateParameters[p].ParameterName (@Model.TemplateParameters[p].Units)
                                    <i class="bi bi-info-circle ms-1 text-muted" data-bs-toggle="tooltip" title="@(string.IsNullOrWhiteSpace(Model.TemplateParameters[p].Notes) ? "No notes." : Model.TemplateParameters[p].Notes)"></i>
                                    @if (!isFlowPcs)
                                    {
                                        <span class="text-primary ms-1 d-inline-flex align-items-center gap-1">
                                            &lt;
                                            <i class="bi bi-info-circle text-primary" data-bs-toggle="tooltip" title="@ReportingDetectionLimitHelper.TooltipText"></i>
                                        </span>
                                    }
                                </div>
                                <div class="small text-muted">
                                    @Model.TemplateParameters[p].MeasurementFrequency | @Model.TemplateParameters[p].SampleType | Max: @(Model.TemplateParameters[p].DailyMaximumLimit?.ToString() ?? "-")
                                </div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int d = 0; d < 31; d++)
                    {
                        var freeboardValue = Model.StorageLagoonFreeboardFt != null && Model.StorageLagoonFreeboardFt.Count > d && Model.StorageLagoonFreeboardFt[d].HasValue
                            ? Model.StorageLagoonFreeboardFt[d]!.Value.ToString("F2")
                            : string.Empty;
                        var belowMinimum = Model.StorageLagoonFreeboardFt != null
                            && Model.StorageLagoonFreeboardFt.Count > d
                            && Model.StorageLagoonFreeboardFt[d].HasValue
                            && Model.PermittedMinimumFreeboardFeet.HasValue
                            && Model.StorageLagoonFreeboardFt[d]!.Value < Model.PermittedMinimumFreeboardFeet.Value;
                        <tr>
                            <th scope="row"><strong>@(d + 1)</strong></th>
                            <td>
                                <select name="ORCOnSite[@d]" class="form-select form-select-sm">
                                    <option value="">-</option>
                                    @if (orcOnSiteOptions != null)
                                    {
                                        @foreach (var option in orcOnSiteOptions)
                                        {
                                            var selected = Model.ORCOnSite != null &&
                                                           Model.ORCOnSite.Count > d &&
                                                           Model.ORCOnSite[d].HasValue &&
                                                           option.Value == Model.ORCOnSite[d]!.Value.ToString();
                                            <option value="@option.Value" selected="@selected">@option.Text</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td><input name="LagoonWaterDepthFt[@d]" type="number" step="0.01" class="form-control form-control-sm wwchar-water-depth-input" value="@((Model.LagoonWaterDepthFt != null && Model.LagoonWaterDepthFt.Count > d && Model.LagoonWaterDepthFt[d].HasValue) ? Model.LagoonWaterDepthFt[d]!.Value.ToString() : string.Empty)" /></td>
                            <td><input type="text" class="form-control form-control-sm wwchar-freeboard-display @(belowMinimum ? "text-danger fw-semibold" : string.Empty)" readonly value="@freeboardValue" /></td>
                            <td><input name="ORCArrivalTime[@d]" type="time" step="900" class="form-control form-control-sm" value="@((Model.ORCArrivalTime != null && Model.ORCArrivalTime.Count > d && !string.IsNullOrWhiteSpace(Model.ORCArrivalTime[d])) ? Model.ORCArrivalTime[d] : string.Empty)" /></td>
                            <td><input name="ORCTimeOnSiteHours[@d]" type="number" step="0.25" class="form-control form-control-sm" value="@((Model.ORCTimeOnSiteHours != null && Model.ORCTimeOnSiteHours.Count > d && Model.ORCTimeOnSiteHours[d].HasValue) ? Model.ORCTimeOnSiteHours[d]!.Value.ToString() : string.Empty)" /></td>
                            @for (int p = 0; p < Model.TemplateParameters.Count; p++)
                            {
                                var key = $"{Model.TemplateParameters[p].FacilityPermitTemplateParameterId}:{d}";
                                var currentVal = Model.TemplateParameters[p].DailyValues != null && Model.TemplateParameters[p].DailyValues.Count > d
                                    ? Model.TemplateParameters[p].DailyValues[d]
                                    : null;
                                var isFlowPcs = NdmrFlowFormatting.IsFlowPcs(Model.TemplateParameters[p].PcsCode);
                                var isRdl = Model.TemplateParameters[p].DailyIsReportingDetectionLimit != null
                                    && Model.TemplateParameters[p].DailyIsReportingDetectionLimit.Count > d
                                    && Model.TemplateParameters[p].DailyIsReportingDetectionLimit[d];
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (!isFlowPcs)
                                        {
                                            <input type="hidden" name="TemplateParameters[@p].DailyIsReportingDetectionLimit[@d]" value="false" />
                                            <input name="TemplateParameters[@p].DailyIsReportingDetectionLimit[@d]"
                                                   type="checkbox"
                                                   value="true"
                                                   class="form-check-input flex-shrink-0"
                                                   @(isRdl ? "checked" : null) />
                                        }
                                        <input name="TemplateParameters[@p].DailyValues[@d]"
                                               type="number"
                                               step="0.000001"
                                               class="form-control form-control-sm"
                                               value="@(currentVal?.ToString() ?? string.Empty)"
                                               data-template-key="@key" />
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <script>
            (function () {
                const section = document.querySelector('[data-wwchar-template-section="true"]');
                if (!section) return;

                const bermHeightRaw = section.dataset.bermHeight;
                const minFreeboardRaw = section.dataset.minFreeboard;
                const bermHeight = bermHeightRaw === '' ? null : Number(bermHeightRaw);
                const minFreeboard = minFreeboardRaw === '' ? null : Number(minFreeboardRaw);

                const refreshRowFreeboard = (row) => {
                    const waterDepthInput = row.querySelector('.wwchar-water-depth-input');
                    const freeboardDisplay = row.querySelector('.wwchar-freeboard-display');
                    if (!waterDepthInput || !freeboardDisplay) return;

                    const waterDepthRaw = waterDepthInput.value.trim();
                    const waterDepth = waterDepthRaw === '' ? null : Number(waterDepthRaw);
                    if (bermHeight == null || waterDepth == null || Number.isNaN(waterDepth)) {
                        freeboardDisplay.value = '';
                        freeboardDisplay.classList.remove('text-danger', 'fw-semibold');
                        return;
                    }

                    const freeboard = bermHeight - waterDepth;
                    freeboardDisplay.value = Number.isFinite(freeboard) ? freeboard.toFixed(2) : '';
                    const belowMinimum = minFreeboard != null && Number.isFinite(freeboard) && freeboard < minFreeboard;
                    freeboardDisplay.classList.toggle('text-danger', belowMinimum);
                    freeboardDisplay.classList.toggle('fw-semibold', belowMinimum);
                };

                section.querySelectorAll('tbody tr').forEach(row => {
                    const waterDepthInput = row.querySelector('.wwchar-water-depth-input');
                    if (waterDepthInput) {
                        waterDepthInput.addEventListener('input', () => refreshRowFreeboard(row));
                    }
                    refreshRowFreeboard(row);
                });
            })();
        </script>
    }
    else
    {
        <div class="alert alert-warning d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
            <span>@(Model.TemplateParametersStatusMessage ?? "No permit template parameters found for the selected facility/month/year.")</span>
            @if (Model.FacilityId == Guid.Empty)
            {
                <span class="text-danger fw-semibold">Select facility</span>
            }
            else
            {
                <a href="@permitHref"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-sm btn-outline-primary"
                   id="openPermitVersionsBtn"
                   data-base-url="@Url.Action("FacilityPermits", "SystemAdmin")">
                    Open Permit Versions
                </a>
            }
        </div>
    }
</div>
