@model SAM.ViewModels.OperationalData.GWMonitTemplateSectionViewModel

<input type="hidden" name="FacilityPermitId" value="@Model.FacilityPermitId" />

<div class="mb-3">
    <label class="form-label">Resolved Permit Version</label>
    <input id="resolvedPermitDisplay" class="form-control" value="@(string.IsNullOrWhiteSpace(Model.FacilityPermitDisplay) ? "No active permit for selected date" : Model.FacilityPermitDisplay)" readonly />
</div>

<div class="form-section-title">Groundwater Permit Template Parameters (Attachment C)</div>
@if (Model.TemplateParameters.Any())
{
    @for (int i = 0; i < Model.TemplateParameters.Count; i++)
    {
        <input type="hidden" name="TemplateParameters[@i].FacilityPermitTemplateParameterId" value="@Model.TemplateParameters[i].FacilityPermitTemplateParameterId" />
        <input type="hidden" name="TemplateParameters[@i].PcsCode" value="@Model.TemplateParameters[i].PcsCode" />
        <input type="hidden" name="TemplateParameters[@i].ParameterName" value="@Model.TemplateParameters[i].ParameterName" />
        <input type="hidden" name="TemplateParameters[@i].Units" value="@Model.TemplateParameters[i].Units" />
        <input type="hidden" name="TemplateParameters[@i].MeasurementFrequency" value="@Model.TemplateParameters[i].MeasurementFrequency" />
        <input type="hidden" name="TemplateParameters[@i].SampleType" value="@Model.TemplateParameters[i].SampleType" />
        <input type="hidden" name="TemplateParameters[@i].ScheduledMonthsCsv" value="@Model.TemplateParameters[i].ScheduledMonthsCsv" />
        <input type="hidden" name="TemplateParameters[@i].DailyMaximumLimit" value="@Model.TemplateParameters[i].DailyMaximumLimit" />
        <input type="hidden" name="TemplateParameters[@i].Notes" value="@Model.TemplateParameters[i].Notes" />
        <input type="hidden" name="TemplateParameters[@i].IsRequiredForSelectedMonth" value="@Model.TemplateParameters[i].IsRequiredForSelectedMonth" />
        <input type="hidden" name="TemplateParameters[@i].RequirementMessage" value="@Model.TemplateParameters[i].RequirementMessage" />
    }

    <div class="alert alert-secondary py-2 small mb-2">
        Enter values in the right-most column. Rows marked <strong>Required This Month</strong> must be filled before save.
    </div>

    <div class="table-responsive fixed-height-table-wrapper mb-3">
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>PCS</th>
                    <th>Parameter</th>
                    <th>Units</th>
                    <th>M. Frequency</th>
                    <th>Sample Type</th>
                    <th>Months</th>
                    <th>Daily Max</th>
                    <th>Entry Value</th>
                </tr>
            </thead>
            <tbody>
            @for (int i = 0; i < Model.TemplateParameters.Count; i++)
            {
                <tr class="@(Model.TemplateParameters[i].IsRequiredForSelectedMonth ? "table-warning" : string.Empty)">
                    <td>@Model.TemplateParameters[i].PcsCode</td>
                    <td>
                        @Model.TemplateParameters[i].ParameterName
                        @if (Model.TemplateParameters[i].IsRequiredForSelectedMonth)
                        {
                            <span class="badge bg-warning text-dark ms-1">Required This Month</span>
                        }
                        <i class="bi bi-info-circle ms-1 text-primary" data-bs-toggle="tooltip" title="@(string.IsNullOrWhiteSpace(Model.TemplateParameters[i].Notes) ? "No notes." : Model.TemplateParameters[i].Notes)"></i>
                    </td>
                    <td>@Model.TemplateParameters[i].Units</td>
                    <td>@Model.TemplateParameters[i].MeasurementFrequency</td>
                    <td>@Model.TemplateParameters[i].SampleType</td>
                    <td>@(string.IsNullOrWhiteSpace(Model.TemplateParameters[i].ScheduledMonthsCsv) ? "-" : Model.TemplateParameters[i].ScheduledMonthsCsv)</td>
                    <td>@(Model.TemplateParameters[i].DailyMaximumLimit?.ToString("0.######") ?? "-")</td>
                    <td><input name="TemplateParameters[@i].EnteredValue" type="number" step="0.000001" class="form-control form-control-sm" value="@Model.TemplateParameters[i].EnteredValue" /></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">@(Model.TemplateParametersStatusMessage ?? "No groundwater permit template parameters found for the selected facility/date.")</div>
}
