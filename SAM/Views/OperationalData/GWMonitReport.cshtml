@model SAM.ViewModels.OperationalData.GW59ReportViewModel
@using SAM.Utilities

@{
    ViewData["Title"] = "GW-59 Groundwater Monitoring Report";
    var namedLabSnapshots = Gw59LabPdfCalibration.SelectNamedSnapshots(Model.ParameterSnapshots);
    var otherLines = Model.OtherParameterLines.Take(Gw59LabPdfCalibration.OtherLineLimit).ToList();
    var leftOtherLines = otherLines.Take(5).ToList();
    var rightOtherLines = otherLines.Skip(5).Take(5).ToList();
}

<style>
    .gw-report-grid .card { height: 100%; }
    .gw-kv {
        display: grid;
        grid-template-columns: minmax(180px, 42%) minmax(0, 58%);
        gap: .5rem 1rem;
        margin: 0;
    }
    .gw-kv dt, .gw-kv dd { margin: 0; }
    .gw-kv dt { font-weight: 600; color: #475467; }
    .gw-kv dd { color: #101828; word-break: break-word; }

    @@media (max-width: 767.98px) {
        .gw-kv { grid-template-columns: 1fr; gap: .25rem 0; }
        .gw-kv dt { margin-top: .5rem; }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0 small">Auto-generated from groundwater monitoring data</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="ExportGW59Report" asp-route-id="@Model.GwMonitId" class="btn btn-primary btn-sm js-report-export-link">
            <i class="bi bi-file-earmark-pdf"></i> Download PDF
        </a>
        <a asp-controller="OperationalData" asp-action="GWMonitDetails" asp-route-id="@Model.GwMonitId" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row g-3 gw-report-grid">
    <div class="col-12 col-xl-6">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Facility Information</h6></div>
            <div class="card-body small">
                <dl class="gw-kv">
                    <dt>Facility Name</dt><dd>@Model.FacilityName</dd>
                    <dt>Permit Number</dt><dd>@Model.PermitNumber</dd>
                    <dt>Permittee</dt><dd>@Model.Permittee</dd>
                    <dt>Address</dt><dd>@Model.Address, @Model.City, @Model.State @Model.ZipCode</dd>
                    <dt>County</dt><dd>@Model.County</dd>
                    <dt>Contact Person</dt><dd>@(!string.IsNullOrWhiteSpace(Model.ContactPerson) ? Model.ContactPerson : "N/A")</dd>
                    <dt>Telephone</dt><dd>@(!string.IsNullOrWhiteSpace(Model.FacilityPhone) ? Model.FacilityPhone : "N/A")</dd>
                    <dt>Permit Expiration</dt><dd>@Model.PermitExpirationDate?.ToString("MM/dd/yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Sampling Information &amp; Well Details</h6></div>
            <div class="card-body small">
                <dl class="gw-kv">
                    <dt>Well ID (from Permit)</dt><dd>@Model.WellId</dd>
                    <dt>Well Location / Site Name</dt><dd>@Model.WellLocation</dd>
                    <dt>Well Depth</dt><dd>@(Model.WellDepthFeet?.ToString("F2") ?? "N/A") ft</dd>
                    <dt>Well Diameter</dt><dd>@(Model.DiameterInches?.ToString("F2") ?? "N/A") in</dd>
                    <dt>Screened Interval</dt>
                    <dd>
                        @if (Model.ScreenedIntervalFromFeet.HasValue || Model.ScreenedIntervalToFeet.HasValue)
                        {
                            @($"{Model.ScreenedIntervalFromFeet?.ToString("F2") ?? "?"} to {Model.ScreenedIntervalToFeet?.ToString("F2") ?? "?"} ft")
                        }
                        else
                        {
                            @:N/A
                        }
                    </dd>
                    <dt>No. of Wells to be Sampled</dt><dd>@Model.NumberOfWellsToBeSampled</dd>
                    <dt>Date Sample Collected</dt><dd>@Model.SampleDate.ToString("MM/dd/yyyy")</dd>
                    <dt>Sample Depth</dt><dd>@(Model.SampleDepth?.ToString("F2") ?? "N/A") ft</dd>
                    <dt>Depth to Water Level</dt><dd>@(Model.WaterLevel?.ToString("F2") ?? "N/A") ft</dd>
                    <dt>Measuring Point</dt><dd>@(Model.MeasuringPointAboveLandSurface?.ToString("F2") ?? "N/A") ft above land surface</dd>
                    <dt>Relative M.P. Elevation</dt><dd>@(Model.RelativeMpElevation?.ToString("F2") ?? "N/A") ft</dd>
                    <dt>Volume Pumped/Bailed Before Sampling</dt><dd>@(Model.GallonsPumped?.ToString("F2") ?? "N/A") gallons</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Field Analyses</h6></div>
            <div class="card-body small">
                <dl class="gw-kv">
                    <dt>pH (field)</dt><dd>@(Model.PHField?.ToString("F2") ?? "N/A") units</dd>
                    <dt>Temperature (field)</dt><dd>@(Model.TemperatureField?.ToString("F1") ?? "N/A") &deg;C</dd>
                    <dt>Specific Conductance</dt><dd>@(Model.SpecificConductance?.ToString("F2") ?? "N/A") &micro;Mhos</dd>
                    <dt>Odor</dt><dd>@(!string.IsNullOrWhiteSpace(Model.Odor) ? Model.Odor : "N/A")</dd>
                    <dt>Appearance</dt><dd>@(!string.IsNullOrWhiteSpace(Model.Appearance) ? Model.Appearance : "N/A")</dd>
                    <dt>Metals Collected Unfiltered</dt><dd>@(Model.MetalsUnfiltered switch { true => "Yes", false => "No", _ => "Not set" })</dd>
                    <dt>Metals Field Acidified</dt><dd>@(Model.MetalsAcidified switch { true => "Yes", false => "No", _ => "Not set" })</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Laboratory Information &amp; Parameters</h6></div>
            <div class="card-body small">
                <dl class="gw-kv">
                    <dt>Laboratory Name</dt><dd>@Model.LabName</dd>
                    <dt>Certification No.</dt><dd>@Model.LabCertificationNumber</dd>
                </dl>
                @if (namedLabSnapshots.Any())
                {
                    <div class="mt-3">
                        <div class="fw-semibold mb-2">Named Laboratory Parameters</div>
                        <dl class="gw-kv">
                            @foreach (var snapshot in namedLabSnapshots)
                            {
                                var units = string.IsNullOrWhiteSpace(snapshot.Units) ? string.Empty : $" {snapshot.Units}";
                                <dt>@snapshot.ParameterName (@snapshot.PcsCode)</dt>
                                <dd>@snapshot.Value!.Value.ToString("0.######")@units</dd>
                            }
                        </dl>
                    </div>
                }
                else
                {
                    <div class="mt-3 text-muted">No named laboratory parameter values for this record.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Organics (VOC)</h6></div>
            <div class="card-body small">
                <dl class="gw-kv">
                    <dt>Lab Report Attached?</dt><dd>@(Model.LabReportAttached ? "Yes" : "No")</dd>
                    <dt>VOC Method #</dt><dd>@(!string.IsNullOrWhiteSpace(Model.VOCMethodNumber) ? Model.VOCMethodNumber : "N/A")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Permit Operation &amp; Other GW-59 Rows</h6></div>
            <div class="card-body small">
                <dl class="gw-kv">
                    <dt>Lagoon</dt><dd>@(Model.GwOperationLagoon ? "Checked" : "Unchecked")</dd>
                    <dt>Spray Field</dt><dd>@(Model.GwOperationSprayField ? "Checked" : "Unchecked")</dd>
                </dl>
                <div class="mt-3">
                    <div class="fw-semibold mb-2">Other (Specify Compounds and Concentration Units)</div>
                    @if (otherLines.Any())
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="text-muted small mb-1">#1–#5</div>
                                @if (leftOtherLines.Any())
                                {
                                    <ol class="mb-0 ps-3" start="1">
                                        @foreach (var line in leftOtherLines)
                                        {
                                            <li>@Gw59LabPdfCalibration.FormatOtherLine(line)</li>
                                        }
                                    </ol>
                                }
                                else
                                {
                                    <div class="text-muted">—</div>
                                }
                            </div>
                            <div class="col-md-6">
                                <div class="text-muted small mb-1">#6–#10</div>
                                @if (rightOtherLines.Any())
                                {
                                    <ol class="mb-0 ps-3" start="6">
                                        @foreach (var line in rightOtherLines)
                                        {
                                            <li>@Gw59LabPdfCalibration.FormatOtherLine(line)</li>
                                        }
                                    </ol>
                                }
                                else
                                {
                                    <div class="text-muted">—</div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">No additional non-direct GW-59 rows for this record.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="card">
            <div class="card-header"><h6 class="mb-0">Certification</h6></div>
            <div class="card-body small">
                <p class="mb-3">
                    I certify that, to the best of my knowledge and belief, the information submitted in this report is true, accurate, and complete,
                    and that the laboratory analytical data was produced using approved methods of analysis by a certified laboratory.
                </p>
                <dl class="gw-kv">
                    <dt>Name</dt><dd>@Model.CertificationName</dd>
                    <dt>Title</dt><dd>@Model.CertificationTitle</dd>
                    <dt>Date</dt><dd>@Model.CertificationDate?.ToString("MM/dd/yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.SAMLoading) {
                window.SAMLoading.bindLinkClicks('.js-report-export-link', {
                    loadingMessage: 'Generating groundwater quality report...',
                    useFetchDownload: true,
                    autoHideMs: 15000
                });
            }
        });
    </script>
}
