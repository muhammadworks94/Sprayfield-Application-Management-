@model SAM.ViewModels.OperationalData.WWCharEditViewModel
@using SAM.Domain.Enums
@{
    ViewData["Title"] = "Edit Wastewater Characteristics Record";
    var facilities = ViewBag.Facilities as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var months = ViewBag.Months as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var orcOnSiteOptions = ViewBag.ORCOnSiteOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var flowMeasuringPointOptions = ViewBag.FlowMeasuringPointOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var parameterMonitoringPointOptions = ViewBag.ParameterMonitoringPointOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="mb-4">
    <p class="text-muted mb-0">Modify wastewater characteristics record</p>
</div>

<div class="card">
    <div class="card-body">
        <button class="btn btn-link px-0 mb-3" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#wwcharEditInstructions"
                aria-expanded="false"
                aria-controls="wwcharEditInstructions">
            <i class="bi bi-journal-text me-1"></i> Editing wastewater characteristics instructions
        </button>

        <div class="collapse" id="wwcharEditInstructions">
            <div class="alert alert-info">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1"></i>Editing Wastewater Records</h6>
                <ul class="small mb-0 ps-3">
                    <li class="mb-1"><strong>Record context</strong>: This record represents one facility’s effluent data for a specific month and year. Verify you are editing the correct period.</li>
                    <li class="mb-1"><strong>Daily rows</strong>: Each row is a calendar day. Only revise values when you are correcting data entry errors or applying updated lab results.</li>
                    <li class="mb-1"><strong>Analytical data</strong>: For BOD5, TSS, nutrients, coliforms, residual chloride, Ca, Mg, Na, SAR, and TN, align edits with final lab reports. Do not “smooth” results to fit expectations.</li>
                    <li class="mb-1"><strong>Missing vs zero</strong>: Use blanks when no sample or measurement exists. Reserve zeros for true zero results as reported by the lab or meter.</li>
                    <li class="mb-1"><strong>Composite time & ORC on site</strong>: Ensure these fields still reflect actual sampling practices and staffing for each day.</li>
                    <li class="mb-1"><strong>Lagoon freeboard</strong>: Correct only if the original measurement was clearly wrong. These values support storage and freeboard compliance evaluations.</li>
                    <li><strong>Comments / facility notes</strong>: Document material corrections (e.g., “Updated BOD5 days 5–7 from final lab report dated …”) so audits and regulatory reviews can follow the history.</li>
                </ul>
            </div>
        </div>

        <form asp-action="WWCharEdit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CompanyId" />
            <input type="hidden" asp-for="FacilityPermitId" />
            
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section">
                <div class="form-section-title">Basic Information</div>
                
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="FacilityId" class="form-label required"></label>
                            <select asp-for="FacilityId" asp-items="facilities" class="form-select">
                                <option value="">-- Select Facility --</option>
                            </select>
                            <span asp-validation-for="FacilityId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Month" class="form-label required"></label>
                            <select asp-for="Month" asp-items="months" class="form-select">
                                <option value="">-- Select Month --</option>
                            </select>
                            <span asp-validation-for="Month" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Year" class="form-label required"></label>
                            <input asp-for="Year" type="number" class="form-control" min="2000" max="2100" />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label class="form-label">Resolved Permit Version</label>
                            <input id="resolvedPermitDisplay" class="form-control" value="@(string.IsNullOrWhiteSpace(Model.FacilityPermitDisplay) ? "No active permit for selected date" : Model.FacilityPermitDisplay)" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FlowMeasuringPoint" class="form-label"></label>
                            <select asp-for="FlowMeasuringPoint" asp-items="flowMeasuringPointOptions" class="form-select">
                                <option value="">-- Select Flow Measuring Point --</option>
                            </select>
                            <span asp-validation-for="FlowMeasuringPoint" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ParameterMonitoringPoint" class="form-label"></label>
                            <select asp-for="ParameterMonitoringPoint" asp-items="parameterMonitoringPointOptions" class="form-select">
                                <option value="">-- Select Parameter Monitoring Point --</option>
                            </select>
                            <span asp-validation-for="ParameterMonitoringPoint" class="text-danger"></span>
                        </div>
                    </div>
                </div>

            </div>

            <div id="wwcharTemplateSectionContainer">
                @await Html.PartialAsync("Partials/_WWCharTemplateSection", new WWCharTemplateSectionViewModel
                {
                    FacilityId = Model.FacilityId,
                    FacilityPermitId = Model.FacilityPermitId,
                    FacilityPermitDisplay = Model.FacilityPermitDisplay,
                    Month = Model.Month,
                    Year = Model.Year,
                    RecordId = Model.Id,
                    IsEdit = true,
                    TemplateParametersStatusMessage = Model.TemplateParametersStatusMessage,
                    TemplateParameters = Model.TemplateParameters,
                    ORCOnSite = Model.ORCOnSite,
                    LagoonFreeboard = Model.LagoonFreeboard
                })
            </div>

            <div class="form-section">
                <div class="form-section-title">Lab Information</div>
                
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="LabCertification" class="form-label required"></label>
                            <input asp-for="LabCertification" class="form-control" />
                            <span asp-validation-for="LabCertification" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="CollectedBy" class="form-label required"></label>
                            <input asp-for="CollectedBy" class="form-control" />
                            <span asp-validation-for="CollectedBy" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="AnalyzedBy" class="form-label required"></label>
                            <input asp-for="AnalyzedBy" class="form-control" />
                            <span asp-validation-for="AnalyzedBy" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 responsive-form-actions">
                <a asp-action="WWCharDetails" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Update Record
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            var tooltipContainer = el.closest('.wwchar-daily-table-wrapper') || el.closest('.card-body') || document.body;
            new bootstrap.Tooltip(el, {
                container: tooltipContainer,
                trigger: 'hover focus',
                boundary: 'viewport',
                fallbackPlacements: ['top', 'bottom', 'right', 'left']
            });
        });

        (function () {
            var facilityInput = document.getElementById('FacilityId');
            var monthInput = document.getElementById('Month');
            var yearInput = document.getElementById('Year');
            var resolvedPermitInput = document.getElementById('resolvedPermitDisplay');
            var facilityPermitIdInput = document.getElementById('FacilityPermitId');
            var sectionContainer = document.getElementById('wwcharTemplateSectionContainer');
            var recordIdInput = document.getElementById('Id');
            var requestSeq = 0;
            var debounceHandle = null;
            var noPermitLabel = 'No active permit for selected date';
            var contextUrl = '@Url.Action("WWCharTemplateContext", "OperationalData")';
            var permitBaseUrl = '@Url.Action("FacilityPermits", "SystemAdmin")';

            if (!facilityInput || !monthInput || !yearInput || !sectionContainer) return;

            function initTooltips(scope) {
                (scope || document).querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                    if (!bootstrap.Tooltip.getInstance(el)) {
                        var tooltipContainer = el.closest('.wwchar-daily-table-wrapper') || el.closest('.card-body') || document.body;
                        new bootstrap.Tooltip(el, {
                            container: tooltipContainer,
                            trigger: 'hover focus',
                            boundary: 'viewport',
                            fallbackPlacements: ['top', 'bottom', 'right', 'left']
                        });
                    }
                });
            }

            function captureTemplateValues() {
                var result = {
                    keyedTemplateValues: {},
                    namedValues: {}
                };

                sectionContainer.querySelectorAll('input[name], select[name], textarea[name]').forEach(function (el) {
                    var name = el.name || '';
                    if (!name) return;

                    if (el.dataset && el.dataset.templateKey) {
                        result.keyedTemplateValues[el.dataset.templateKey] = el.value;
                        return;
                    }

                    if (name.startsWith('ORCOnSite[') || name.startsWith('LagoonFreeboard[')) {
                        result.namedValues[name] = el.value;
                    }
                });

                return result;
            }

            function applyCapturedValues(snapshot) {
                if (!snapshot) return;

                sectionContainer.querySelectorAll('input[name], select[name], textarea[name]').forEach(function (el) {
                    if (el.dataset && el.dataset.templateKey && Object.prototype.hasOwnProperty.call(snapshot.keyedTemplateValues, el.dataset.templateKey)) {
                        el.value = snapshot.keyedTemplateValues[el.dataset.templateKey];
                        return;
                    }

                    if (el.name && Object.prototype.hasOwnProperty.call(snapshot.namedValues, el.name)) {
                        el.value = snapshot.namedValues[el.name];
                    }
                });
            }

            function updatePermitButtonLink() {
                var openPermitBtn = document.getElementById('openPermitVersionsBtn');
                if (!openPermitBtn) return;

                var facilityId = facilityInput.value;
                var month = monthInput.value;
                var year = yearInput.value;

                if (!facilityId) return;

                var url = new URL(permitBaseUrl, window.location.origin);
                url.searchParams.set('facilityId', facilityId);
                url.searchParams.set('source', 'wwchar');
                if (month) url.searchParams.set('month', month);
                if (year) url.searchParams.set('year', year);

                openPermitBtn.href = url.toString();
            }

            function refreshTemplateSection() {
                var facilityId = facilityInput.value;
                var month = monthInput.value;
                var year = yearInput.value;

                if (!facilityId || !month || !year) {
                    if (resolvedPermitInput) resolvedPermitInput.value = noPermitLabel;
                    if (facilityPermitIdInput) facilityPermitIdInput.value = '';
                    updatePermitButtonLink();
                    return;
                }

                var currentSeq = ++requestSeq;
                var snapshot = captureTemplateValues();
                var url = new URL(contextUrl, window.location.origin);
                url.searchParams.set('facilityId', facilityId);
                url.searchParams.set('month', month);
                url.searchParams.set('year', year);
                url.searchParams.set('isEdit', 'true');
                if (recordIdInput && recordIdInput.value) {
                    url.searchParams.set('recordId', recordIdInput.value);
                }

                fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (response) {
                        if (!response.ok) throw new Error('Failed to refresh WWChar template context.');
                        return response.text();
                    })
                    .then(function (html) {
                        if (currentSeq !== requestSeq) return;

                        sectionContainer.innerHTML = html;
                        applyCapturedValues(snapshot);
                        initTooltips(sectionContainer);
                        updatePermitButtonLink();

                        var sectionRoot = sectionContainer.querySelector('[data-wwchar-template-section="true"]');
                        if (sectionRoot) {
                            var permitDisplay = sectionRoot.getAttribute('data-facility-permit-display') || '';
                            var permitId = sectionRoot.getAttribute('data-facility-permit-id') || '';

                            if (resolvedPermitInput) {
                                resolvedPermitInput.value = permitDisplay || noPermitLabel;
                            }

                            if (facilityPermitIdInput) {
                                facilityPermitIdInput.value = permitId;
                            }
                        }
                    })
                    .catch(function () {
                        updatePermitButtonLink();
                    });
            }

            function scheduleRefresh() {
                clearTimeout(debounceHandle);
                debounceHandle = setTimeout(refreshTemplateSection, 220);
            }

            [facilityInput, monthInput, yearInput].forEach(function (input) {
                input.addEventListener('change', scheduleRefresh);
                input.addEventListener('input', scheduleRefresh);
            });

            initTooltips(document);
            updatePermitButtonLink();
        })();
    </script>
}

