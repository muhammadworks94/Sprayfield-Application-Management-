@model SAM.ViewModels.OperationalData.MonthlyApplicationViewModel
@using SAM.Services.Helpers
@{
    ViewData["Title"] = "Irrigation Entry Details";
}

@section PageTitleInline {
    <span tabindex="0"
          role="button"
          class="text-info"
          data-bs-toggle="tooltip"
          data-bs-html="true"
          data-bs-placement="left"
          title="<strong>Monthly Application Backend Logic</strong><br/>Wastewater PAN formula used here:<br/>PAN (lbs) = {[MR x (TKN - NH3)] + (1 - VR) x NH3 + NO2 + NO3} x 8.34 x Volume (mgal).<br/>PAN Loading (lbs/acre) = PAN (lbs) / acres.<br/>MR/VR are from Facility defaults (40%/50% fallback), chemistry comes from WWChar monthly values.<br/>Annual PAN limit threshold comes from Crop PANLimit (derived at crop save).<br/>System computes 12-month rolling PAN/hydraulic utilization and warning thresholds.">
        <i class="bi bi-info-circle fs-5"></i>
    </span>
}

<div class="mb-4">
    <p class="text-muted mb-0">Review irrigation entry details.</p>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <h5 class="mb-1">Irrigation Entry Details</h5>
                <p class="text-muted mb-0">Submitted for @(string.IsNullOrWhiteSpace(Model.SprayfieldName) ? "selected sprayfield" : Model.SprayfieldName) on @Model.ApplicationDate.ToString("MMMM dd, yyyy").</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="MonthlyApplicationEdit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="IrrigationEntry" asp-route-facilityId="@Model.FacilityId" class="btn btn-sm btn-secondary">Back</a>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-lg-4 col-md-6">
                <div class="border rounded p-3 h-100 bg-light-subtle">
                    <div class="small text-muted text-uppercase">Daily Loading</div>
                    <div class="fs-4 fw-semibold">@(MonthlyApplicationCalculationHelper.FormatDailyLoadingInchesDisplay(Model.DailyLoadingInches) ?? "-") <span class="fs-6 fw-normal text-muted">in</span></div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="border rounded p-3 h-100 bg-light-subtle">
                    <div class="small text-muted text-uppercase">Volume</div>
                    <div class="fs-4 fw-semibold">@Model.VolumeGallons.ToString("F2") <span class="fs-6 fw-normal text-muted">gal</span></div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="border rounded p-3 h-100 bg-light-subtle">
                    <div class="small text-muted text-uppercase">Time Irrigated</div>
                    <div class="fs-4 fw-semibold">@(Model.TimeIrrigatedMinutes?.ToString("F2") ?? "-") <span class="fs-6 fw-normal text-muted">min</span></div>
                </div>
            </div>
            <div class="col-lg-4 col-md-12">
                <div class="border rounded p-3 h-100 bg-light-subtle">
                    <div class="small text-muted text-uppercase">Max Hourly Loading</div>
                    <div class="fs-4 fw-semibold">@Model.MaximumHourlyLoadingInchesPerAcre.ToString("F2") <span class="fs-6 fw-normal text-muted">in/acre</span></div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-xl-6">
                <h6 class="text-muted text-uppercase small mb-3">Location And Record</h6>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Date</dt>
                    <dd class="col-sm-8">@Model.ApplicationDate.ToString("MM/dd/yyyy")</dd>

                    <dt class="col-sm-4">Facility</dt>
                    <dd class="col-sm-8">@Model.FacilityName</dd>

                    <dt class="col-sm-4">Sprayfield</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.SprayfieldName) ? "-" : Model.SprayfieldName)</dd>

                    <dt class="col-sm-4">Zone</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.ZoneName) ? "-" : Model.ZoneName)</dd>

                    <dt class="col-sm-4">Zone Acres</dt>
                    <dd class="col-sm-8">@(Model.ZoneAcres.HasValue ? $"{Model.ZoneAcres.Value:F2} acres" : "-")</dd>
                </dl>
            </div>
            <div class="col-xl-6">
                <h6 class="text-muted text-uppercase small mb-3">Personnel And Notes</h6>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Operator</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.OperatorSnapshotName) ? "-" : Model.OperatorSnapshotName)</dd>

                    <dt class="col-sm-4">Comments</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Comments) ? "-" : Model.Comments)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (element) {
                bootstrap.Tooltip.getOrCreateInstance(element);
            });
        })();
    </script>
}


