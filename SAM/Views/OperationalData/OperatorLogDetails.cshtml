@model SAM.ViewModels.OperationalData.OperatorLogViewModel
@{
    ViewData["Title"] = "Operator Log Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">View detailed information for operator log</p>
    </div>
    <div>
        <a asp-action="OperatorLogEdit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="OperatorLogs" asp-route-companyId="@Model.CompanyId" asp-route-facilityId="@Model.FacilityId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h4 class="mb-4"><i class="bi bi-journal-text me-2"></i>@(Model.FacilityName ?? "Facility") – @Model.LogDate.ToString("MM/dd/yyyy")</h4>
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Record Context</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-briefcase me-1"></i>Company:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.CompanyName ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-building me-1"></i>Facility:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.FacilityName ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar3 me-1"></i>Log Date:</dt>
                    <dd class="col-sm-7 mb-2">@Model.LogDate.ToString("MM/dd/yyyy")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Operator & Time</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-person me-1"></i>Operator Name:</dt>
                    <dd class="col-sm-7 mb-2">@(string.IsNullOrEmpty(Model.OperatorName) ? "N/A" : Model.OperatorName)</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-clock me-1"></i>Arrival Time:</dt>
                    <dd class="col-sm-7 mb-2">@(string.IsNullOrEmpty(Model.ArrivalTime) ? "N/A" : Model.ArrivalTime)</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-hourglass-split me-1"></i>Time on Site (hours):</dt>
                    <dd class="col-sm-7 mb-2">@(Model.TimeOnSiteHours.HasValue ? Model.TimeOnSiteHours.Value.ToString("F2") : "N/A")</dd>
                </dl>
            </div>
        </div>
        <div class="border-top pt-3 mt-3">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="detail-section-label mb-4">Conditions & Maintenance</h5>
                    <dl class="row">
                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-cloud-sun me-1"></i>Weather Conditions:</dt>
                        <dd class="col-sm-7 mb-2">@(string.IsNullOrEmpty(Model.WeatherConditions) ? "N/A" : Model.WeatherConditions)</dd>

                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-thermometer-half me-1"></i>Temperature (°F):</dt>
                        <dd class="col-sm-7 mb-2">@(Model.TemperatureF?.ToString("F2") ?? "N/A")</dd>

                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-cloud-rain me-1"></i>Precipitation (in):</dt>
                        <dd class="col-sm-7 mb-2">@(Model.PrecipitationIn?.ToString("F2") ?? "N/A")</dd>

                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-rulers me-1"></i>Storage (ft):</dt>
                        <dd class="col-sm-7 mb-2">@(Model.StorageFt?.ToString("F2") ?? "N/A")</dd>

                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-arrow-up-right-square me-1"></i>5-Day Upset (ft):</dt>
                        <dd class="col-sm-7 mb-2">@(Model.FiveDayUpsetFt?.ToString("F2") ?? "N/A")</dd>

                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-tools me-1"></i>Maintenance Performed:</dt>
                        <dd class="col-sm-7 mb-2 text-break">@(string.IsNullOrEmpty(Model.MaintenancePerformed) ? "N/A" : Model.MaintenancePerformed)</dd>

                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-clipboard-check me-1"></i>Equipment Inspected:</dt>
                        <dd class="col-sm-7 mb-2 text-break">@(string.IsNullOrEmpty(Model.EquipmentInspected) ? "N/A" : Model.EquipmentInspected)</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <h5 class="detail-section-label mb-4">Issues & Actions</h5>
                    <dl class="row">
                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-exclamation-triangle me-1"></i>Issues Noted:</dt>
                        <dd class="col-sm-7 mb-2 text-break">@(string.IsNullOrEmpty(Model.IssuesNoted) ? "N/A" : Model.IssuesNoted)</dd>

                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-wrench-adjustable-circle me-1"></i>Corrective Actions:</dt>
                        <dd class="col-sm-7 mb-2 text-break">@(string.IsNullOrEmpty(Model.CorrectiveActions) ? "N/A" : Model.CorrectiveActions)</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="border-top pt-3 mt-3">
            <div class="row">
                <div class="col-12">
                    <h5 class="detail-section-label mb-4">Next Shift Notes</h5>
                    <dl class="row">
                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-journal-arrow-down me-1"></i>Notes for Next Shift:</dt>
                        <dd class="col-sm-7 mb-2 text-break">@(string.IsNullOrEmpty(Model.NextShiftNotes) ? "N/A" : Model.NextShiftNotes)</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
