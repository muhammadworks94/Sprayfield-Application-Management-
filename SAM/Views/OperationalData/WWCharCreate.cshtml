@model SAM.ViewModels.OperationalData.WWCharCreateViewModel
@using SAM.Domain.Enums
@{
    ViewData["Title"] = "Create Wastewater Characteristics Record";
    var facilities = ViewBag.Facilities as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var months = ViewBag.Months as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var orcOnSiteOptions = ViewBag.ORCOnSiteOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var flowMeasuringPointOptions = ViewBag.FlowMeasuringPointOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var parameterMonitoringPointOptions = ViewBag.ParameterMonitoringPointOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="mb-4">
    <p class="text-muted mb-0">Add a new wastewater characteristics record</p>
</div>

<div class="card">
    <div class="card-body">
        <button class="btn btn-link px-0 mb-3" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#wwcharInstructions"
                aria-expanded="false"
                aria-controls="wwcharInstructions">
            <i class="bi bi-journal-text me-1"></i> Wastewater characteristics instructions
        </button>

        <div class="collapse" id="wwcharInstructions">
            <div class="alert alert-info">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-1"></i>Wastewater Characteristics Guide</h6>
                <ul class="small mb-0 ps-3">
                    <li class="mb-1"><strong>Purpose</strong>: This record captures a full month of daily effluent data for one facility, supporting permit and compliance reporting.</li>
                    <li class="mb-1"><strong>Facility / Month / Year</strong>: Ensure these match the lab reports and regulatory submittal period. One record per facility per month.</li>
                    <li class="mb-1"><strong>Day rows</strong>: Each row represents a calendar day (1–31). Enter values only for days when samples or flow data are available.</li>
                    <li class="mb-1"><strong>Organic & solids</strong> (BOD5, TSS): Enter lab‑reported concentrations in mg/L. Leave blank (do not enter 0) when no sample was collected.</li>
                    <li class="mb-1"><strong>Flow Rate (GPM)</strong>: Use representative plant flow for that day (daily average or as defined in your permit).</li>
                    <li class="mb-1"><strong>pH</strong>: Enter daily pH as measured in the field or lab. If multiple readings exist, use the value required by your monitoring plan.</li>
                    <li class="mb-1"><strong>NH3‑N and other nutrients</strong>: Record lab‑reported ammonia as N (mg/L); use blanks for missing data rather than zeros.</li>
                    <li class="mb-1"><strong>Coliforms</strong> (fecal): Enter counts in CFU/100mL. If the lab reports “&lt;DL”, use the numeric detection limit according to your SOP and note details elsewhere if needed.</li>
                    <li class="mb-1"><strong>Residual Chloride & cations</strong> (Ca, Mg, Na, SAR, TN): Record mg/L values from lab or field instruments as required by your permit.</li>
                    <li class="mb-1"><strong>Composite Time</strong>: Time the composite sample represents (e.g., end of composite). Use 24‑hour time for clarity.</li>
                    <li class="mb-1"><strong>ORC On Site</strong>: Indicate whether the ORC (Operator in Responsible Charge) was on site that day, using the provided options.</li>
                    <li class="mb-1"><strong>Lagoon Freeboard</strong>: Enter measured distance from liquid surface to the top of the lagoon berm (inches). This helps track available storage and compliance with freeboard limits.</li>
                    <li><strong>Missing data</strong>: When a required sample or measurement is missed, leave the field blank and document the reason in your facility notes or incident logs as per your SOP.</li>
                </ul>
            </div>
        </div>

        <form asp-action="WWCharCreate" method="post">
            @Html.AntiForgeryToken()
            
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section">
                <div class="form-section-title">Basic Information</div>
                
            <input type="hidden" asp-for="CompanyId" />
            <input type="hidden" asp-for="FacilityPermitId" />
                
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="FacilityId" class="form-label required"></label>
                            <select asp-for="FacilityId" asp-items="facilities" class="form-select">
                                <option value="">-- Select Facility --</option>
                            </select>
                            <span asp-validation-for="FacilityId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Month" class="form-label required"></label>
                            <select asp-for="Month" asp-items="months" class="form-select">
                                <option value="">-- Select Month --</option>
                            </select>
                            <span asp-validation-for="Month" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Year" class="form-label required"></label>
                            <input asp-for="Year" type="number" class="form-control" min="2000" max="2100" />
                            <span asp-validation-for="Year" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label class="form-label">Resolved Permit Version</label>
                            <input class="form-control" value="@(string.IsNullOrWhiteSpace(Model.FacilityPermitDisplay) ? "No active permit for selected date" : Model.FacilityPermitDisplay)" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="FlowMeasuringPoint" class="form-label"></label>
                            <select asp-for="FlowMeasuringPoint" asp-items="flowMeasuringPointOptions" class="form-select">
                                <option value="">-- Select Flow Measuring Point --</option>
                            </select>
                            <span asp-validation-for="FlowMeasuringPoint" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="ParameterMonitoringPoint" class="form-label"></label>
                            <select asp-for="ParameterMonitoringPoint" asp-items="parameterMonitoringPointOptions" class="form-select">
                                <option value="">-- Select Parameter Monitoring Point --</option>
                            </select>
                            <span asp-validation-for="ParameterMonitoringPoint" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="NO2N" class="form-label">
                                NO2 as N
                                <i class="bi bi-info-circle ms-1 text-muted"
                                   title="Nitrite as Nitrogen (mg/L)"
                                   aria-label="Nitrite as Nitrogen (mg/L)"></i>
                            </label>
                            <input asp-for="NO2N" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="NO2N" class="text-danger"></span>
                            <small class="form-text text-muted">Nitrite as N (mg/L). Used for PAN calculation.</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="TKNN" class="form-label">
                                TKN as N
                                <i class="bi bi-info-circle ms-1 text-muted"
                                   title="Total Kjeldahl Nitrogen as Nitrogen (mg/L)"
                                   aria-label="Total Kjeldahl Nitrogen as Nitrogen (mg/L)"></i>
                            </label>
                            <input asp-for="TKNN" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="TKNN" class="text-danger"></span>
                            <small class="form-text text-muted">TKN as N (mg/L). Used for PAN calculation.</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="NO3N" class="form-label">
                                NO3 as N
                                <i class="bi bi-info-circle ms-1 text-muted"
                                   title="Nitrate as Nitrogen (mg/L)"
                                   aria-label="Nitrate as Nitrogen (mg/L)"></i>
                            </label>
                            <input asp-for="NO3N" type="number" step="0.01" min="0" class="form-control" />
                            <span asp-validation-for="NO3N" class="text-danger"></span>
                            <small class="form-text text-muted">NO3 as N (mg/L). Used for PAN calculation.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Daily Data (Days 1-31)</div>
                <p class="text-muted small">Enter daily values for each parameter. Leave blank if no data available.</p>
                
                <div class="table-responsive wwchar-daily-table-wrapper fixed-height-table-wrapper">
                    <table class="table table-bordered wwchar-daily-table">
                        <thead>
                            <tr>
                                <th>Day</th>
                                <th>BOD5 <i class="bi bi-info-circle ms-1 text-muted" title="Biochemical Oxygen Demand, 5-day (mg/L)" aria-label="Biochemical Oxygen Demand, 5-day (mg/L)"></i><br/>(mg/L)</th>
                                <th>TSS <i class="bi bi-info-circle ms-1 text-muted" title="Total Suspended Solids (mg/L)" aria-label="Total Suspended Solids (mg/L)"></i><br/>(mg/L)</th>
                                <th>Flow Rate<br/>(GPM)</th>
                                <th>pH</th>
                                <th>NH3-N <i class="bi bi-info-circle ms-1 text-muted" title="Ammonia as Nitrogen (mg/L)" aria-label="Ammonia as Nitrogen (mg/L)"></i><br/>(mg/L)</th>
                                <th>Fecal Coliform<br/>(CFU/100mL)</th>
                                <th>Residual Chloride<br/>(mg/L)</th>
                                <th>Ca <i class="bi bi-info-circle ms-1 text-muted" title="Calcium (mg/L)" aria-label="Calcium (mg/L)"></i><br/>(mg/L)</th>
                                <th>Mg <i class="bi bi-info-circle ms-1 text-muted" title="Magnesium (mg/L)" aria-label="Magnesium (mg/L)"></i><br/>(mg/L)</th>
                                <th>Na <i class="bi bi-info-circle ms-1 text-muted" title="Sodium (mg/L)" aria-label="Sodium (mg/L)"></i><br/>(mg/L)</th>
                                <th>SAR <i class="bi bi-info-circle ms-1 text-muted" title="Sodium Adsorption Ratio (mg/L)" aria-label="Sodium Adsorption Ratio (mg/L)"></i><br/>(mg/L)</th>
                                <th>TN <i class="bi bi-info-circle ms-1 text-muted" title="Total Nitrogen (mg/L)" aria-label="Total Nitrogen (mg/L)"></i><br/>(mg/L)</th>
                                <th>Composite<br/>Time</th>
                                <th>ORC <i class="bi bi-info-circle ms-1 text-muted" title="Operator in Responsible Charge On Site" aria-label="Operator in Responsible Charge On Site"></i><br/>On Site</th>
                                <th>Lagoon<br/>Freeboard<br/>(inches)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < 31; i++)
                            {
                                <tr>
                                    <td><strong>@(i + 1)</strong></td>
                                    <td>
                                        <input asp-for="BOD5Daily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="TSSDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="FlowRateDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="PHDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="NH3NDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="FecalColiformDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="ChlorideDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="CaDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="MgDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="NaDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="SARDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="TNDaily[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <input asp-for="CompositeTime[i]" type="time" class="form-control form-control-sm" />
                                    </td>
                                    <td>
                                        <select asp-for="ORCOnSite[i]" asp-items="orcOnSiteOptions" class="form-select form-select-sm">
                                            <option value="">-</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input asp-for="LagoonFreeboard[i]" type="number" step="0.01" class="form-control form-control-sm" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Permit Template Parameters (PCS)</div>
                @if (Model.TemplateParameters.Any())
                {
                    <div class="table-responsive responsive-table wide-data-table fixed-height-table-wrapper mb-3">
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th>PCS</th>
                                    <th>Parameter</th>
                                    <th>Freq</th>
                                    <th>Sample</th>
                                    <th>Months</th>
                                    <th>Monthly Avg</th>
                                    <th>Monthly Geo Mean</th>
                                    <th>Daily Min</th>
                                    <th>Daily Max</th>
                                    @for (int day = 1; day <= 31; day++)
                                    {
                                        <th>@day</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                            @for (int i = 0; i < Model.TemplateParameters.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Model.TemplateParameters[i].PcsCode
                                        <input type="hidden" asp-for="TemplateParameters[i].FacilityPermitTemplateParameterId" />
                                        <input type="hidden" asp-for="TemplateParameters[i].PcsCode" />
                                        <input type="hidden" asp-for="TemplateParameters[i].ParameterName" />
                                        <input type="hidden" asp-for="TemplateParameters[i].Units" />
                                    </td>
                                    <td>@Model.TemplateParameters[i].ParameterName (@Model.TemplateParameters[i].Units)</td>
                                    <td>@Model.TemplateParameters[i].MeasurementFrequency</td>
                                    <td>@Model.TemplateParameters[i].SampleType</td>
                                    <td>@Model.TemplateParameters[i].ScheduledMonthsCsv</td>
                                    <td>@Model.TemplateParameters[i].MonthlyAverageLimit</td>
                                    <td>@Model.TemplateParameters[i].MonthlyGeometricMeanLimit</td>
                                    <td>@Model.TemplateParameters[i].DailyMinimumLimit</td>
                                    <td>@Model.TemplateParameters[i].DailyMaximumLimit</td>
                                    @for (int d = 0; d < 31; d++)
                                    {
                                        <td><input asp-for="TemplateParameters[i].DailyValues[d]" type="number" step="0.000001" class="form-control form-control-sm" /></td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">@(Model.TemplateParametersStatusMessage ?? "No permit template parameters found for the selected facility/month/year.")</div>
                }
            </div>

            <div class="form-section">
                <div class="form-section-title">Lab Information</div>
                
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="LabCertification" class="form-label"></label>
                            <input asp-for="LabCertification" class="form-control" />
                            <span asp-validation-for="LabCertification" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="CollectedBy" class="form-label"></label>
                            <input asp-for="CollectedBy" class="form-control" />
                            <span asp-validation-for="CollectedBy" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="AnalyzedBy" class="form-label"></label>
                            <input asp-for="AnalyzedBy" class="form-control" />
                            <span asp-validation-for="AnalyzedBy" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="WWChars" asp-route-facilityId="@Model.FacilityId" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Create Record
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

