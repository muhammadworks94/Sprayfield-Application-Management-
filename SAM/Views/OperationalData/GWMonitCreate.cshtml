@model SAM.ViewModels.OperationalData.GWMonitCreateViewModel
@{
    ViewData["Title"] = "Create Groundwater Monitoring Record";
    var facilities = ViewBag.Facilities as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var monitoringWells = ViewBag.MonitoringWells as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="mb-4">
    <p class="text-muted mb-0">Add a new groundwater monitoring record</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="GWMonitCreate" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CompanyId" />
            <input type="hidden" asp-for="FacilityPermitId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section">
                <div class="form-section-title">Basic Information</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="FacilityId" class="form-label required"></label>
                            <select asp-for="FacilityId" asp-items="facilities" class="form-select" id="facilitySelect">
                                <option value=""> Select Facility </option>
                            </select>
                            <span asp-validation-for="FacilityId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="MonitoringWellId" class="form-label required"></label>
                            <select asp-for="MonitoringWellId" asp-items="monitoringWells" class="form-select">
                                <option value=""> Select Monitoring Well </option>
                            </select>
                            <span asp-validation-for="MonitoringWellId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="SampleDate" class="form-label required"></label>
                            <input asp-for="SampleDate" type="date" class="form-control" />
                            <span asp-validation-for="SampleDate" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label class="form-label">Resolved Permit Version</label>
                            <input class="form-control" value="@(string.IsNullOrWhiteSpace(Model.FacilityPermitDisplay) ? "No active permit for selected date" : Model.FacilityPermitDisplay)" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Groundwater Permit Template Parameters (Attachment C)</div>
                @if (Model.TemplateParameters.Any())
                {
                    @for (int i = 0; i < Model.TemplateParameters.Count; i++)
                    {
                        <input type="hidden" asp-for="TemplateParameters[i].FacilityPermitTemplateParameterId" />
                        <input type="hidden" asp-for="TemplateParameters[i].PcsCode" />
                        <input type="hidden" asp-for="TemplateParameters[i].ParameterName" />
                        <input type="hidden" asp-for="TemplateParameters[i].Units" />
                        <input type="hidden" asp-for="TemplateParameters[i].MeasurementFrequency" />
                        <input type="hidden" asp-for="TemplateParameters[i].SampleType" />
                        <input type="hidden" asp-for="TemplateParameters[i].ScheduledMonthsCsv" />
                        <input type="hidden" asp-for="TemplateParameters[i].DailyMaximumLimit" />
                        <input type="hidden" asp-for="TemplateParameters[i].Notes" />
                        <input type="hidden" asp-for="TemplateParameters[i].IsRequiredForSelectedMonth" />
                        <input type="hidden" asp-for="TemplateParameters[i].RequirementMessage" />
                    }

                    <div class="alert alert-secondary py-2 small mb-2">
                        Enter values in the right-most column. Rows marked <strong>Required This Month</strong> must be filled before save.
                    </div>

                    <div class="table-responsive fixed-height-table-wrapper mb-3">
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th>PCS</th>
                                    <th>Parameter</th>
                                    <th>Units</th>
                                    <th>M. Frequency</th>
                                    <th>Sample Type</th>
                                    <th>Months</th>
                                    <th>Daily Max</th>
                                    <th>Entry Value</th>
                                </tr>
                            </thead>
                            <tbody>
                            @for (int i = 0; i < Model.TemplateParameters.Count; i++)
                            {
                                <tr class="@(Model.TemplateParameters[i].IsRequiredForSelectedMonth ? "table-warning" : string.Empty)">
                                    <td>@Model.TemplateParameters[i].PcsCode</td>
                                    <td>
                                        @Model.TemplateParameters[i].ParameterName
                                        @if (Model.TemplateParameters[i].IsRequiredForSelectedMonth)
                                        {
                                            <span class="badge bg-warning text-dark ms-1">Required This Month</span>
                                        }
                                        <i class="bi bi-info-circle ms-1 text-muted" data-bs-toggle="tooltip" title="@(string.IsNullOrWhiteSpace(Model.TemplateParameters[i].Notes) ? "No notes." : Model.TemplateParameters[i].Notes)"></i>
                                    </td>
                                    <td>@Model.TemplateParameters[i].Units</td>
                                    <td>@Model.TemplateParameters[i].MeasurementFrequency</td>
                                    <td>@Model.TemplateParameters[i].SampleType</td>
                                    <td>@(string.IsNullOrWhiteSpace(Model.TemplateParameters[i].ScheduledMonthsCsv) ? "-" : Model.TemplateParameters[i].ScheduledMonthsCsv)</td>
                                    <td>@(Model.TemplateParameters[i].DailyMaximumLimit?.ToString("0.######") ?? "-")</td>
                                    <td>
                                        <input asp-for="TemplateParameters[i].EnteredValue" type="number" step="0.000001" class="form-control form-control-sm" />
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">@(Model.TemplateParametersStatusMessage ?? "No groundwater permit template parameters found for the selected facility/date.")</div>
                }
            </div>

            <div class="form-section">
                <div class="form-section-title">Sample Information</div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="SampleDepth" class="form-label"></label>
                            <input asp-for="SampleDepth" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="SampleDepth" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="WaterLevel" class="form-label"></label>
                            <input asp-for="WaterLevel" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="WaterLevel" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="Temperature" class="form-label"></label>
                            <input asp-for="Temperature" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Temperature" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="GallonsPumped" class="form-label"></label>
                            <input asp-for="GallonsPumped" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="GallonsPumped" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="Odor" class="form-label"></label>
                            <select asp-for="Odor" class="form-select">
                                <option value="">Select Odor</option>
                                <option value="None">None</option>
                                <option value="Slight">Slight</option>
                                <option value="Strong">Strong</option>
                            </select>
                            <span asp-validation-for="Odor" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="Appearance" class="form-label"></label>
                            <select asp-for="Appearance" class="form-select">
                                <option value="">Select Appearance</option>
                                <option value="Clear">Clear</option>
                                <option value="Turbid">Turbid</option>
                            </select>
                            <span asp-validation-for="Appearance" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Physical Parameters</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Conductivity" class="form-label"></label>
                            <input asp-for="Conductivity" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Conductivity" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Turbidity" class="form-label"></label>
                            <input asp-for="Turbidity" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Turbidity" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="TDS" class="form-label"></label>
                            <input asp-for="TDS" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="TDS" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Organics</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3 form-check">
                            <input class="form-check-input" asp-for="VOCReportAttached" type="checkbox" />
                            <label class="form-check-label" asp-for="VOCReportAttached"></label>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="VOCMethodNumber" class="form-label"></label>
                            <input asp-for="VOCMethodNumber" class="form-control" />
                            <span asp-validation-for="VOCMethodNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Lab Information</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="LabCertification" class="form-label required"></label>
                            <input asp-for="LabCertification" class="form-control" />
                            <span asp-validation-for="LabCertification" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="CollectedBy" class="form-label required"></label>
                            <input asp-for="CollectedBy" class="form-control" />
                            <span asp-validation-for="CollectedBy" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="AnalyzedBy" class="form-label required"></label>
                            <input asp-for="AnalyzedBy" class="form-control" />
                            <span asp-validation-for="AnalyzedBy" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Additional Information</div>
                <div class="mb-3">
                    <label asp-for="Comments" class="form-label required"></label>
                    <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Comments" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="GWMonits" asp-route-facilityId="@Model.FacilityId" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Create Record
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            new bootstrap.Tooltip(el);
        });

        document.getElementById('facilitySelect')?.addEventListener('change', function() {
            var facilityId = this.value;
            if (facilityId) {
                window.location.href = '@Url.Action("GWMonitCreate")' + '?facilityId=' + facilityId;
            }
        });
    </script>
}
