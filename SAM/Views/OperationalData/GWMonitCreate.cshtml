@model SAM.ViewModels.OperationalData.GWMonitCreateViewModel
@{
    ViewData["Title"] = "Create Groundwater Monitoring Record";
    var facilities = ViewBag.Facilities as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var monitoringWells = ViewBag.MonitoringWells as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var hasVocFile = !string.IsNullOrWhiteSpace(Model.VOCReportFileName);
}

<div class="mb-4">
    <p class="text-muted mb-0">Add a new groundwater monitoring record</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="GWMonitCreate" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CompanyId" />
            <input type="hidden" asp-for="FacilityPermitId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-section">
                <div class="form-section-title">Basic Information</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="FacilityId" class="form-label required"></label>
                            <select asp-for="FacilityId" asp-items="facilities" class="form-select" id="facilitySelect">
                                <option value=""> Select Facility </option>
                            </select>
                            <span asp-validation-for="FacilityId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="MonitoringWellId" class="form-label required"></label>
                            <select asp-for="MonitoringWellId" asp-items="monitoringWells" class="form-select">
                                <option value=""> Select Monitoring Well </option>
                            </select>
                            <span asp-validation-for="MonitoringWellId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="SampleDate" class="form-label required"></label>
                            <input asp-for="SampleDate" type="date" class="form-control" />
                            <span asp-validation-for="SampleDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div id="gwTemplateSectionContainer">
                    @await Html.PartialAsync("Partials/_GWMonitTemplateSection", new SAM.ViewModels.OperationalData.GWMonitTemplateSectionViewModel
                    {
                        FacilityId = Model.FacilityId,
                        SampleDate = Model.SampleDate,
                        RecordId = null,
                        IsEdit = false,
                        FacilityPermitId = Model.FacilityPermitId,
                        FacilityPermitDisplay = Model.FacilityPermitDisplay,
                        TemplateParametersStatusMessage = Model.TemplateParametersStatusMessage,
                        TemplateParameters = Model.TemplateParameters
                    })
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Sample Information</div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="SampleDepth" class="form-label"></label>
                            <input asp-for="SampleDepth" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="SampleDepth" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="WaterLevel" class="form-label"></label>
                            <input asp-for="WaterLevel" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="WaterLevel" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="Temperature" class="form-label"></label>
                            <input asp-for="Temperature" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Temperature" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="GallonsPumped" class="form-label"></label>
                            <input asp-for="GallonsPumped" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="GallonsPumped" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="Odor" class="form-label"></label>
                            <select asp-for="Odor" class="form-select">
                                <option value="">Select Odor</option>
                                <option value="None">None</option>
                                <option value="Slight">Slight</option>
                                <option value="Strong">Strong</option>
                            </select>
                            <span asp-validation-for="Odor" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="Appearance" class="form-label"></label>
                            <select asp-for="Appearance" class="form-select">
                                <option value="">Select Appearance</option>
                                <option value="Clear">Clear</option>
                                <option value="Turbid">Turbid</option>
                            </select>
                            <span asp-validation-for="Appearance" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Physical Parameters</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="Conductivity" class="form-label"></label>
                            <input asp-for="Conductivity" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Conductivity" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Organics</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3 form-check">
                            <input class="form-check-input" asp-for="VOCReportAttached" type="checkbox" id="vocReportAttachedCheckbox" disabled="@(!hasVocFile)" />
                            <label class="form-check-label" asp-for="VOCReportAttached"></label>
                            <small class="text-muted d-block mt-1" id="vocAttachmentHelp">
                                Upload a VOC PDF before it can be attached to the GW-59 report.
                            </small>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="VOCReportFile" class="form-label"></label>
                            <input asp-for="VOCReportFile" type="file" class="form-control" accept=".pdf,application/pdf" id="vocReportFileInput" />
                            <span asp-validation-for="VOCReportFile" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="mb-3">
                            <label asp-for="VOCMethodNumber" class="form-label"></label>
                            <input asp-for="VOCMethodNumber" class="form-control" />
                            <span asp-validation-for="VOCMethodNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Lab Information</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="LabCertification" class="form-label"></label>
                            <input asp-for="LabCertification" class="form-control" />
                            <span asp-validation-for="LabCertification" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="CollectedBy" class="form-label"></label>
                            <input asp-for="CollectedBy" class="form-control" />
                            <span asp-validation-for="CollectedBy" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="AnalyzedBy" class="form-label"></label>
                            <input asp-for="AnalyzedBy" class="form-control" />
                            <span asp-validation-for="AnalyzedBy" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Additional Information</div>
                <div class="mb-3">
                    <label asp-for="Comments" class="form-label"></label>
                    <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Comments" class="text-danger"></span>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">GW-59A Compliance</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="GW59ADueDate" class="form-label"></label>
                            <input asp-for="GW59ADueDate" type="date" class="form-control" />
                            <span asp-validation-for="GW59ADueDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 mb-3">
                        <label class="form-label">1. Enter date monitoring results were due. (@(Model.GW59ADueDate?.ToString("MM/dd/yyyy") ?? "__________")) Will this monitoring report (GW-59 and GW-59A) be submitted after the established due date?</label>
                        <div class="d-flex gap-4">
                            <input type="hidden" name="GW59AQuestion1Response" value="@(Model.GW59AQuestion1Response.HasValue ? (Model.GW59AQuestion1Response.Value ? "true" : "false") : "")" data-gw59a-hidden="GW59AQuestion1Response" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion1Response_Yes" data-gw59a-toggle="GW59AQuestion1Response" data-gw59a-value="true" @(Model.GW59AQuestion1Response == true ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion1Response_Yes">Yes</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion1Response_No" data-gw59a-toggle="GW59AQuestion1Response" data-gw59a-value="false" @(Model.GW59AQuestion1Response == false ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion1Response_No">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label">2. Was any required information missing on the GW-59 report forms?</label>
                        <div class="d-flex gap-4 mb-2">
                            <input type="hidden" name="GW59AQuestion2Response" value="@(Model.GW59AQuestion2Response.HasValue ? (Model.GW59AQuestion2Response.Value ? "true" : "false") : "")" data-gw59a-hidden="GW59AQuestion2Response" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion2Response_Yes" data-gw59a-toggle="GW59AQuestion2Response" data-gw59a-value="true" @(Model.GW59AQuestion2Response == true ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion2Response_Yes">Yes</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion2Response_No" data-gw59a-toggle="GW59AQuestion2Response" data-gw59a-value="false" @(Model.GW59AQuestion2Response == false ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion2Response_No">No</label>
                            </div>
                        </div>
                        <label asp-for="GW59AQuestion2Details" class="form-label"></label>
                        <textarea asp-for="GW59AQuestion2Details" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label">3. Are any of the monitor wells in need of repair or maintenance (damaged casing, unlocked or missing cap, missing identification plate, area overgrown, etc.)? If the answer is "Yes", contact the Regional Office for guidance.</label>
                        <div class="d-flex gap-4">
                            <input type="hidden" name="GW59AQuestion3Response" value="@(Model.GW59AQuestion3Response.HasValue ? (Model.GW59AQuestion3Response.Value ? "true" : "false") : "")" data-gw59a-hidden="GW59AQuestion3Response" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion3Response_Yes" data-gw59a-toggle="GW59AQuestion3Response" data-gw59a-value="true" @(Model.GW59AQuestion3Response == true ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion3Response_Yes">Yes</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion3Response_No" data-gw59a-toggle="GW59AQuestion3Response" data-gw59a-value="false" @(Model.GW59AQuestion3Response == false ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion3Response_No">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label">4. Are any monitored constituents equal to or above the established standards?</label>
                        <div class="d-flex gap-4 mb-2">
                            <input type="hidden" name="GW59AQuestion4Response" value="@(Model.GW59AQuestion4Response.HasValue ? (Model.GW59AQuestion4Response.Value ? "true" : "false") : "")" data-gw59a-hidden="GW59AQuestion4Response" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion4Response_Yes" data-gw59a-toggle="GW59AQuestion4Response" data-gw59a-value="true" @(Model.GW59AQuestion4Response == true ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion4Response_Yes">Yes</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion4Response_No" data-gw59a-toggle="GW59AQuestion4Response" data-gw59a-value="false" @(Model.GW59AQuestion4Response == false ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion4Response_No">No</label>
                            </div>
                        </div>
                        <label asp-for="GW59AQuestion4Details" class="form-label"></label>
                        <textarea asp-for="GW59AQuestion4Details" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label">5. For the constituents identified in question 4 above, have standards been exceeded previously for the same constituent(s) in the same well(s) in the last two years?</label>
                        <div class="d-flex gap-4 mb-2">
                            <input type="hidden" name="GW59AQuestion5Response" value="@(Model.GW59AQuestion5Response.HasValue ? (Model.GW59AQuestion5Response.Value ? "true" : "false") : "")" data-gw59a-hidden="GW59AQuestion5Response" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion5Response_Yes" data-gw59a-toggle="GW59AQuestion5Response" data-gw59a-value="true" @(Model.GW59AQuestion5Response == true ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion5Response_Yes">Yes</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion5Response_No" data-gw59a-toggle="GW59AQuestion5Response" data-gw59a-value="false" @(Model.GW59AQuestion5Response == false ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion5Response_No">No</label>
                            </div>
                        </div>
                        <label asp-for="GW59AQuestion5Details" class="form-label"></label>
                        <textarea asp-for="GW59AQuestion5Details" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label">6. Are the monitoring wells listed in section 5 located at or beyond the review boundary?</label>
                        <div class="d-flex gap-4">
                            <input type="hidden" name="GW59AQuestion6Response" value="@(Model.GW59AQuestion6Response.HasValue ? (Model.GW59AQuestion6Response.Value ? "true" : "false") : "")" data-gw59a-hidden="GW59AQuestion6Response" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion6Response_Yes" data-gw59a-toggle="GW59AQuestion6Response" data-gw59a-value="true" @(Model.GW59AQuestion6Response == true ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion6Response_Yes">Yes</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion6Response_No" data-gw59a-toggle="GW59AQuestion6Response" data-gw59a-value="false" @(Model.GW59AQuestion6Response == false ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion6Response_No">No</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mb-3">
                        <label class="form-label">7. Is the permittee implementing previously approved actions required by the Division involving this groundwater quality problem?</label>
                        <div class="d-flex gap-4 mb-2">
                            <input type="hidden" name="GW59AQuestion7Response" value="@(Model.GW59AQuestion7Response.HasValue ? (Model.GW59AQuestion7Response.Value ? "true" : "false") : "")" data-gw59a-hidden="GW59AQuestion7Response" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion7Response_Yes" data-gw59a-toggle="GW59AQuestion7Response" data-gw59a-value="true" @(Model.GW59AQuestion7Response == true ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion7Response_Yes">Yes</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="GW59AQuestion7Response_No" data-gw59a-toggle="GW59AQuestion7Response" data-gw59a-value="false" @(Model.GW59AQuestion7Response == false ? "checked" : "") />
                                <label class="form-check-label" for="GW59AQuestion7Response_No">No</label>
                            </div>
                        </div>
                        <label asp-for="GW59AQuestion7Details" class="form-label"></label>
                        <textarea asp-for="GW59AQuestion7Details" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4"><div class="mb-3"><label asp-for="GW59ASignerName" class="form-label"></label><input asp-for="GW59ASignerName" class="form-control" /></div></div>
                    <div class="col-md-4"><div class="mb-3"><label asp-for="GW59ASignerTitle" class="form-label"></label><input asp-for="GW59ASignerTitle" class="form-control" /></div></div>
                    <div class="col-md-4"><div class="mb-3"><label asp-for="GW59ASignedDate" class="form-label"></label><input asp-for="GW59ASignedDate" type="date" class="form-control" /></div></div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="GWMonits" asp-route-facilityId="@Model.FacilityId" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Create Record
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const facilitySelect = document.getElementById('facilitySelect');
            const sampleDateInput = document.getElementById('SampleDate');
            const container = document.getElementById('gwTemplateSectionContainer');
            const contextUrl = '@Url.Action("GWMonitTemplateContext", "OperationalData")';
            const vocFileInput = document.getElementById('vocReportFileInput');
            const vocAttachedCheckbox = document.getElementById('vocReportAttachedCheckbox');
            const vocAttachmentHelp = document.getElementById('vocAttachmentHelp');
            let debounceTimer = null;
            let requestCounter = 0;

            function initTooltips(scope) {
                (scope || document).querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                    var tooltipContainer = el.closest('.fixed-height-table-wrapper') || el.closest('.card-body') || document.body;
                    var existing = bootstrap.Tooltip.getInstance(el);
                    if (existing) {
                        existing.dispose();
                    }

                    new bootstrap.Tooltip(el, {
                        container: tooltipContainer,
                        trigger: 'hover focus',
                        boundary: 'viewport',
                        fallbackPlacements: ['top', 'bottom', 'right', 'left']
                    });
                });
            }

            function captureTemplateValues() {
                const values = {};
                if (!container) return values;
                const rowInputs = container.querySelectorAll('input[name^="TemplateParameters["][name$="].EnteredValue"]');
                rowInputs.forEach(function (input) {
                    const idxMatch = input.name.match(/^TemplateParameters\[(\d+)\]\.EnteredValue$/);
                    if (!idxMatch) return;
                    const idx = idxMatch[1];
                    const idInput = container.querySelector(`input[name="TemplateParameters[${idx}].FacilityPermitTemplateParameterId"]`);
                    const key = idInput?.value;
                    if (key) {
                        values[key] = input.value;
                    }
                });
                return values;
            }

            function restoreTemplateValues(values) {
                if (!container || !values) return;
                const rowInputs = container.querySelectorAll('input[name^="TemplateParameters["][name$="].EnteredValue"]');
                rowInputs.forEach(function (input) {
                    const idxMatch = input.name.match(/^TemplateParameters\[(\d+)\]\.EnteredValue$/);
                    if (!idxMatch) return;
                    const idx = idxMatch[1];
                    const idInput = container.querySelector(`input[name="TemplateParameters[${idx}].FacilityPermitTemplateParameterId"]`);
                    const key = idInput?.value;
                    if (key && Object.prototype.hasOwnProperty.call(values, key)) {
                        input.value = values[key];
                    }
                });
            }

            async function refreshTemplateSection() {
                const facilityId = facilitySelect?.value;
                const sampleDate = sampleDateInput?.value;
                if (!container || !facilityId || !sampleDate) return;

                const snapshot = captureTemplateValues();
                const currentRequest = ++requestCounter;
                const url = `${contextUrl}?facilityId=${encodeURIComponent(facilityId)}&sampleDate=${encodeURIComponent(sampleDate)}&isEdit=false`;

                try {
                    const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) return;
                    const html = await response.text();
                    if (currentRequest !== requestCounter) return;
                    container.innerHTML = html;
                    restoreTemplateValues(snapshot);
                    initTooltips(container);
                } catch {
                    // no-op; keep current UI state on transient failures
                }
            }

            function queueRefresh() {
                if (debounceTimer) clearTimeout(debounceTimer);
                debounceTimer = setTimeout(refreshTemplateSection, 180);
            }

            facilitySelect?.addEventListener('change', queueRefresh);
            sampleDateInput?.addEventListener('change', queueRefresh);
            initTooltips(document);

            function syncVocAttachmentState() {
                if (!vocAttachedCheckbox || !vocFileInput) return;
                const hasSelectedFile = vocFileInput.files && vocFileInput.files.length > 0;
                vocAttachedCheckbox.disabled = !hasSelectedFile;
                if (!hasSelectedFile) {
                    vocAttachedCheckbox.checked = false;
                    if (vocAttachmentHelp) {
                        vocAttachmentHelp.textContent = 'Upload a VOC PDF before it can be attached to the GW-59 report.';
                    }
                } else if (vocAttachmentHelp) {
                    vocAttachmentHelp.textContent = 'A selected VOC PDF can be attached to the GW-59 report.';
                }
            }

            vocFileInput?.addEventListener('change', syncVocAttachmentState);
            syncVocAttachmentState();

            function initGw59AToggles() {
                const toggleInputs = document.querySelectorAll('[data-gw59a-toggle]');
                toggleInputs.forEach(function (input) {
                    input.addEventListener('change', function () {
                        const field = input.getAttribute('data-gw59a-toggle');
                        const selectedValue = input.getAttribute('data-gw59a-value');
                        const hidden = document.querySelector(`[data-gw59a-hidden="${field}"]`);
                        if (!hidden) return;

                        const siblings = document.querySelectorAll(`[data-gw59a-toggle="${field}"]`);
                        if (input.checked) {
                            siblings.forEach(function (sibling) {
                                if (sibling !== input) {
                                    sibling.checked = false;
                                }
                            });
                            hidden.value = selectedValue;
                        } else if (hidden.value === selectedValue) {
                            hidden.value = '';
                        }
                    });
                });
            }

            initGw59AToggles();
        })();
    </script>
}
