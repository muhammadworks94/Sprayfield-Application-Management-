@model SAM.ViewModels.OperationalData.GWMonitEditViewModel
@{
    ViewData["Title"] = "Edit Groundwater Monitoring Record";
    var facilities = ViewBag.Facilities as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var monitoringWells = ViewBag.MonitoringWells as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="mb-4">
    <p class="text-muted mb-0">Modify groundwater monitoring record</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="GWMonitEdit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CompanyId" />
            <input type="hidden" asp-for="FacilityPermitId" />
            <input type="hidden" asp-for="VOCReportFileName" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <strong>Unable to save.</strong> Please fix the highlighted fields and try again.
                </div>
            }

            <div class="form-section">
                <div class="form-section-title">Basic Information</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="FacilityId" class="form-label required"></label>
                            <select asp-for="FacilityId" asp-items="facilities" class="form-select" id="facilitySelect">
                                <option value="">-- Select Facility --</option>
                            </select>
                            <span asp-validation-for="FacilityId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="MonitoringWellId" class="form-label required"></label>
                            <select asp-for="MonitoringWellId" asp-items="monitoringWells" class="form-select">
                                <option value="">-- Select Monitoring Well --</option>
                            </select>
                            <span asp-validation-for="MonitoringWellId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="SampleDate" class="form-label required"></label>
                            <input asp-for="SampleDate" type="date" class="form-control" />
                            <span asp-validation-for="SampleDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <div id="gwTemplateSectionContainer">
                    @await Html.PartialAsync("Partials/_GWMonitTemplateSection", new SAM.ViewModels.OperationalData.GWMonitTemplateSectionViewModel
                    {
                        FacilityId = Model.FacilityId,
                        SampleDate = Model.SampleDate,
                        RecordId = Model.Id,
                        IsEdit = true,
                        FacilityPermitId = Model.FacilityPermitId,
                        FacilityPermitDisplay = Model.FacilityPermitDisplay,
                        TemplateParametersStatusMessage = Model.TemplateParametersStatusMessage,
                        TemplateParameters = Model.TemplateParameters
                    })
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Sample Information</div>
                <div class="row">
                    <div class="col-md-3"><div class="mb-3"><label asp-for="SampleDepth" class="form-label"></label><input asp-for="SampleDepth" type="number" step="0.01" class="form-control" /><span asp-validation-for="SampleDepth" class="text-danger"></span></div></div>
                    <div class="col-md-3"><div class="mb-3"><label asp-for="WaterLevel" class="form-label"></label><input asp-for="WaterLevel" type="number" step="0.01" class="form-control" /><span asp-validation-for="WaterLevel" class="text-danger"></span></div></div>
                    <div class="col-md-3"><div class="mb-3"><label asp-for="Temperature" class="form-label"></label><input asp-for="Temperature" type="number" step="0.01" class="form-control" /><span asp-validation-for="Temperature" class="text-danger"></span></div></div>
                    <div class="col-md-3"><div class="mb-3"><label asp-for="GallonsPumped" class="form-label"></label><input asp-for="GallonsPumped" type="number" step="0.01" class="form-control" /><span asp-validation-for="GallonsPumped" class="text-danger"></span></div></div>
                </div>
                <div class="row">
                    <div class="col-md-3"><div class="mb-3"><label asp-for="Odor" class="form-label"></label><select asp-for="Odor" class="form-select"><option value="">Select Odor</option><option value="None">None</option><option value="Slight">Slight</option><option value="Strong">Strong</option></select><span asp-validation-for="Odor" class="text-danger"></span></div></div>
                    <div class="col-md-3"><div class="mb-3"><label asp-for="Appearance" class="form-label"></label><select asp-for="Appearance" class="form-select"><option value="">Select Appearance</option><option value="Clear">Clear</option><option value="Turbid">Turbid</option></select><span asp-validation-for="Appearance" class="text-danger"></span></div></div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Physical Parameters</div>
                <div class="row">
                    <div class="col-md-4"><div class="mb-3"><label asp-for="Conductivity" class="form-label"></label><input asp-for="Conductivity" type="number" step="0.01" class="form-control" /><span asp-validation-for="Conductivity" class="text-danger"></span></div></div>
                    <div class="col-md-4"><div class="mb-3"><label asp-for="Turbidity" class="form-label"></label><input asp-for="Turbidity" type="number" step="0.01" class="form-control" /><span asp-validation-for="Turbidity" class="text-danger"></span></div></div>
                    <div class="col-md-4"><div class="mb-3"><label asp-for="TDS" class="form-label"></label><input asp-for="TDS" type="number" step="0.01" class="form-control" /><span asp-validation-for="TDS" class="text-danger"></span></div></div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Organics</div>
                <div class="row">
                    <div class="col-md-4"><div class="mb-3 form-check"><input class="form-check-input" asp-for="VOCReportAttached" type="checkbox" /><label class="form-check-label" asp-for="VOCReportAttached"></label></div></div>
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="VOCReportFile" class="form-label"></label>
                            <input asp-for="VOCReportFile" type="file" class="form-control" accept=".pdf,application/pdf" />
                            <span asp-validation-for="VOCReportFile" class="text-danger"></span>
                            @if (!string.IsNullOrWhiteSpace(Model.VOCReportFileName))
                            {
                                <small class="text-muted d-block mt-1">Current file: @Model.VOCReportFileName</small>
                            }
                        </div>
                    </div>
                    <div class="col-md-12"><div class="mb-3"><label asp-for="VOCMethodNumber" class="form-label"></label><input asp-for="VOCMethodNumber" class="form-control" /><span asp-validation-for="VOCMethodNumber" class="text-danger"></span></div></div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Lab Information</div>
                <div class="row">
                    <div class="col-md-4"><div class="mb-3"><label asp-for="LabCertification" class="form-label"></label><input asp-for="LabCertification" class="form-control" /><span asp-validation-for="LabCertification" class="text-danger"></span></div></div>
                    <div class="col-md-4"><div class="mb-3"><label asp-for="CollectedBy" class="form-label"></label><input asp-for="CollectedBy" class="form-control" /><span asp-validation-for="CollectedBy" class="text-danger"></span></div></div>
                    <div class="col-md-4"><div class="mb-3"><label asp-for="AnalyzedBy" class="form-label"></label><input asp-for="AnalyzedBy" class="form-control" /><span asp-validation-for="AnalyzedBy" class="text-danger"></span></div></div>
                </div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Additional Information</div>
                <div class="mb-3"><label asp-for="Comments" class="form-label"></label><textarea asp-for="Comments" class="form-control" rows="3"></textarea><span asp-validation-for="Comments" class="text-danger"></span></div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="GWMonitDetails" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Update Record</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const facilitySelect = document.getElementById('facilitySelect');
            const sampleDateInput = document.getElementById('SampleDate');
            const container = document.getElementById('gwTemplateSectionContainer');
            const contextUrl = '@Url.Action("GWMonitTemplateContext", "OperationalData")';
            const recordId = '@Model.Id';
            let debounceTimer = null;
            let requestCounter = 0;

            function initTooltips(scope) {
                (scope || document).querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                    var tooltipContainer = el.closest('.fixed-height-table-wrapper') || el.closest('.card-body') || document.body;
                    var existing = bootstrap.Tooltip.getInstance(el);
                    if (existing) {
                        existing.dispose();
                    }

                    new bootstrap.Tooltip(el, {
                        container: tooltipContainer,
                        trigger: 'hover focus',
                        boundary: 'viewport',
                        fallbackPlacements: ['top', 'bottom', 'right', 'left']
                    });
                });
            }

            function captureTemplateValues() {
                const values = {};
                if (!container) return values;
                const rowInputs = container.querySelectorAll('input[name^="TemplateParameters["][name$="].EnteredValue"]');
                rowInputs.forEach(function (input) {
                    const idxMatch = input.name.match(/^TemplateParameters\[(\d+)\]\.EnteredValue$/);
                    if (!idxMatch) return;
                    const idx = idxMatch[1];
                    const idInput = container.querySelector(`input[name="TemplateParameters[${idx}].FacilityPermitTemplateParameterId"]`);
                    const key = idInput?.value;
                    if (key) {
                        values[key] = input.value;
                    }
                });
                return values;
            }

            function restoreTemplateValues(values) {
                if (!container || !values) return;
                const rowInputs = container.querySelectorAll('input[name^="TemplateParameters["][name$="].EnteredValue"]');
                rowInputs.forEach(function (input) {
                    const idxMatch = input.name.match(/^TemplateParameters\[(\d+)\]\.EnteredValue$/);
                    if (!idxMatch) return;
                    const idx = idxMatch[1];
                    const idInput = container.querySelector(`input[name="TemplateParameters[${idx}].FacilityPermitTemplateParameterId"]`);
                    const key = idInput?.value;
                    if (key && Object.prototype.hasOwnProperty.call(values, key)) {
                        input.value = values[key];
                    }
                });
            }

            async function refreshTemplateSection() {
                const facilityId = facilitySelect?.value;
                const sampleDate = sampleDateInput?.value;
                if (!container || !facilityId || !sampleDate) return;

                const snapshot = captureTemplateValues();
                const currentRequest = ++requestCounter;
                const url = `${contextUrl}?facilityId=${encodeURIComponent(facilityId)}&sampleDate=${encodeURIComponent(sampleDate)}&recordId=${encodeURIComponent(recordId)}&isEdit=true`;

                try {
                    const response = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) return;
                    const html = await response.text();
                    if (currentRequest !== requestCounter) return;
                    container.innerHTML = html;
                    restoreTemplateValues(snapshot);
                    initTooltips(container);
                } catch {
                    // no-op; keep current UI state on transient failures
                }
            }

            function queueRefresh() {
                if (debounceTimer) clearTimeout(debounceTimer);
                debounceTimer = setTimeout(refreshTemplateSection, 180);
            }

            facilitySelect?.addEventListener('change', queueRefresh);
            sampleDateInput?.addEventListener('change', queueRefresh);
            initTooltips(document);
        })();
    </script>
}
