@model SAM.ViewModels.OperationalData.WWCharViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Wastewater Characteristics Details";
    var user = await UserManager.GetUserAsync(User);
    var canEdit = user != null && (await UserManager.IsInRoleAsync(user, "admin") || await UserManager.IsInRoleAsync(user, "company_admin") || await UserManager.IsInRoleAsync(user, "technician"));
    var flowMeasuringPointDisplay = Model.FlowMeasuringPoint switch
    {
        SAM.Domain.Enums.FlowMeasuringPointEnum.NoFlowGenerated => "No flow generated",
        SAM.Domain.Enums.FlowMeasuringPointEnum.Influent => "Influent",
        SAM.Domain.Enums.FlowMeasuringPointEnum.Effluent => "Effluent",
        _ => "N/A"
    };
    var parameterMonitoringPointDisplay = Model.ParameterMonitoringPoint switch
    {
        SAM.Domain.Enums.ParameterMonitoringPointEnum.GroundwaterLowering => "Groundwater Lowering",
        SAM.Domain.Enums.ParameterMonitoringPointEnum.SurfaceWater => "Surface Water",
        SAM.Domain.Enums.ParameterMonitoringPointEnum.Influent => "Influent",
        SAM.Domain.Enums.ParameterMonitoringPointEnum.Effluent => "Effluent",
        _ => "N/A"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 page-intro">
    <div>
        <p class="text-muted mb-0">View detailed information for wastewater characteristics record</p>
    </div>
    <div>
        @if (canEdit)
        {
            <a asp-action="WWCharEdit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a asp-action="WWChars" asp-route-facilityId="@Model.FacilityId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h4 class="mb-4"><i class="bi bi-droplet-half me-2"></i>@(Model.FacilityName ?? "Wastewater") - @Model.Month @Model.Year</h4>
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-3">Record Context</h5>
                <dl class="row responsive-detail-list">
                    <dd class="col-sm-5"><i class="bi bi-building me-1"></i>Facility:</dd>
                    <dd class="col-sm-7">@(Model.FacilityName ?? "N/A")</dd>

                    <dd class="col-sm-5"><i class="bi bi-briefcase me-1"></i>Company:</dd>
                    <dd class="col-sm-7">@(Model.CompanyName ?? "N/A")</dd>

                    <dd class="col-sm-5"><i class="bi bi-calendar3 me-1"></i>Period:</dd>
                    <dd class="col-sm-7">@Model.Month @Model.Year</dd>

                    <dd class="col-sm-5"><i class="bi bi-diagram-3 me-1"></i>Flow Measuring Point:</dd>
                    <dd class="col-sm-7">@flowMeasuringPointDisplay</dd>

                    <dd class="col-sm-5"><i class="bi bi-geo-alt me-1"></i>Parameter Monitoring Point:</dd>
                    <dd class="col-sm-7">@parameterMonitoringPointDisplay</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-3">Nitrogen / PAN Parameters</h5>
                <dl class="row responsive-detail-list">
                    <dd class="col-sm-5"><i class="bi bi-droplet me-1"></i>NO2 as N (mg/L):</dd>
                    <dd class="col-sm-7">@(Model.NO2N.HasValue ? Model.NO2N.Value.ToString("F2") : "N/A")</dd>

                    <dd class="col-sm-5"><i class="bi bi-droplet me-1"></i>TKN as N (mg/L):</dd>
                    <dd class="col-sm-7">@(Model.TKNN.HasValue ? Model.TKNN.Value.ToString("F2") : "N/A")</dd>

                    <dd class="col-sm-5"><i class="bi bi-droplet me-1"></i>NO3 as N (mg/L):</dd>
                    <dd class="col-sm-7">@(Model.NO3N.HasValue ? Model.NO3N.Value.ToString("F2") : "N/A")</dd>
                </dl>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-12">
                <h5 class="detail-section-label mb-3">Lab and Sampling</h5>
                <div class="row g-2">
                    <div class="col-lg-3 col-md-6 d-flex">
                        <div class="fw-semibold me-2"><i class="bi bi-building me-1"></i>Lab Options:</div>
                        <div>@(string.IsNullOrEmpty(Model.SelectedLabOptionName) ? "N/A" : Model.SelectedLabOptionName)</div>
                    </div>
                    <div class="col-lg-3 col-md-6 d-flex">
                        <div class="fw-semibold me-2"><i class="bi bi-building me-1"></i>Lab Options 2:</div>
                        <div>@(string.IsNullOrEmpty(Model.SelectedSecondaryLabOptionName) ? "N/A" : Model.SelectedSecondaryLabOptionName)</div>
                    </div>
                    <div class="col-lg-3 col-md-6 d-flex">
                        <div class="fw-semibold me-2"><i class="bi bi-person me-1"></i>Collected By:</div>
                        <div>@(string.IsNullOrEmpty(Model.CollectedBy) ? "N/A" : Model.CollectedBy)</div>
                    </div>
                    <div class="col-lg-3 col-md-6 d-flex">
                        <div class="fw-semibold me-2"><i class="bi bi-person-badge me-1"></i>Analyzed By:</div>
                        <div>@(string.IsNullOrEmpty(Model.AnalyzedBy) ? "N/A" : Model.AnalyzedBy)</div>
                    </div>
                    <div class="col-md-6 d-flex">
                        <div class="fw-semibold me-2"><i class="bi bi-clipboard-check me-1"></i>Lab Certification:</div>
                        <div>@(string.IsNullOrEmpty(Model.SelectedLabCertificationNumber) ? "N/A" : Model.SelectedLabCertificationNumber)</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.SelectedSecondaryLabCertificationNumber))
                    {
                        <div class="col-md-6 d-flex">
                            <div class="fw-semibold me-2"><i class="bi bi-clipboard-check me-1"></i>Lab 2 Certification:</div>
                            <div>@Model.SelectedSecondaryLabCertificationNumber</div>
                        </div>
                    }
                    <div class="col-md-6 d-flex">
                        <div class="fw-semibold me-2"><i class="bi bi-person me-1"></i>Sampling Person 1:</div>
                        <div>@(string.IsNullOrEmpty(Model.SamplingPerson1) ? "N/A" : Model.SamplingPerson1)</div>
                    </div>
                    <div class="col-md-6 d-flex">
                        <div class="fw-semibold me-2"><i class="bi bi-person me-1"></i>Sampling Person 2:</div>
                        <div>@(string.IsNullOrEmpty(Model.SamplingPerson2) ? "N/A" : Model.SamplingPerson2)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h4 class="mb-0">Test Result Attachments</h4>
        @if (Model.TestResultAttachments.Any())
        {
            <div class="table-responsive mt-3">
                <table class="table table-sm table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Test Date</th>
                            <th>File</th>
                            <th>Uploaded By</th>
                            <th>Uploaded At (UTC)</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attachment in Model.TestResultAttachments)
                        {
                            <tr>
                                <td>@attachment.TestDate.ToString("MM/dd/yyyy")</td>
                                <td>@attachment.OriginalFileName</td>
                                <td>@attachment.UploadedBy</td>
                                <td>@attachment.UploadedAtUtc.ToString("MM/dd/yyyy HH:mm")</td>
                                <td class="d-flex gap-1">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="WWCharTestResultFile" asp-route-attachmentId="@attachment.Id">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="WWCharTestResultFile" asp-route-attachmentId="@attachment.Id" asp-route-download="true">
                                        <i class="bi bi-download"></i> Download
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-muted small mt-2">No test result attachments uploaded for this month.</div>
        }
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h4 class="mb-0">Attachment A Template Daily Data</h4>
        <p class="text-muted small mb-2 mt-1">Days 1-31</p>

        @if (Model.TemplateParameters.Any())
        {
            <div class="table-responsive responsive-table wide-data-table wwchar-daily-table-wrapper fixed-height-table-wrapper">
                <table class="table table-sm table-bordered table-striped wwchar-daily-table">
                    <thead>
                        <tr>
                            <th>Day</th>
                            <th>ORC On Site</th>
                            <th>Storage Lagoon Freeboard (ft)</th>
                            <th>ORC Arrival Time (24H)</th>
                            <th>ORC Time on Site (hours)</th>
                            @for (int p = 0; p < Model.TemplateParameters.Count; p++)
                            {
                                <th>
                                    @Model.TemplateParameters[p].PcsCode
                                    <div class="small fw-normal">
                                        @Model.TemplateParameters[p].ParameterName (@Model.TemplateParameters[p].Units)
                                        <i class="bi bi-info-circle ms-1 text-muted" data-bs-toggle="tooltip" title="@(string.IsNullOrWhiteSpace(Model.TemplateParameters[p].Notes) ? "No notes." : Model.TemplateParameters[p].Notes)"></i>
                                    </div>
                                    <div class="small text-muted">
                                        @Model.TemplateParameters[p].MeasurementFrequency | @Model.TemplateParameters[p].SampleType | Max: @(Model.TemplateParameters[p].DailyMaximumLimit?.ToString() ?? "-")
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int d = 0; d < 31; d++)
                        {
                            <tr>
                                <th scope="row"><strong>@(d + 1)</strong></th>
                                <td>@(Model.ORCOnSite != null && d < Model.ORCOnSite.Count && Model.ORCOnSite[d].HasValue ? Model.ORCOnSite[d].Value.ToString() : "-")</td>
                                <td>@(Model.LagoonFreeboard != null && d < Model.LagoonFreeboard.Count && Model.LagoonFreeboard[d].HasValue ? Model.LagoonFreeboard[d].Value.ToString("F2") : "-")</td>
                                <td>@(Model.ORCArrivalTime != null && d < Model.ORCArrivalTime.Count && !string.IsNullOrWhiteSpace(Model.ORCArrivalTime[d]) ? Model.ORCArrivalTime[d] : "-")</td>
                                <td>@(Model.ORCTimeOnSiteHours != null && d < Model.ORCTimeOnSiteHours.Count && Model.ORCTimeOnSiteHours[d].HasValue ? Model.ORCTimeOnSiteHours[d].Value.ToString("F2") : "-")</td>
                                @for (int p = 0; p < Model.TemplateParameters.Count; p++)
                                {
                                    <td>@(Model.TemplateParameters[p].DailyValues != null && d < Model.TemplateParameters[p].DailyValues.Count && Model.TemplateParameters[p].DailyValues[d].HasValue ? Model.TemplateParameters[p].DailyValues[d]!.Value.ToString("F6") : "-")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                <span>@(Model.TemplateParametersStatusMessage ?? "No permit template parameters found for this period.")</span>
                @if (Model.FacilityId != Guid.Empty)
                {
                    <a asp-controller="SystemAdmin"
                       asp-action="FacilityPermits"
                       asp-route-facilityId="@Model.FacilityId"
                       asp-route-source="wwchar"
                       asp-route-month="@((int)Model.Month)"
                       asp-route-year="@Model.Year"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-sm btn-outline-primary">
                        Open Permit Versions
                    </a>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            var tooltipContainer = el.closest('.wwchar-daily-table-wrapper') || el.closest('.card-body') || document.body;
            new bootstrap.Tooltip(el, {
                container: tooltipContainer,
                trigger: 'hover focus',
                boundary: 'viewport',
                fallbackPlacements: ['top', 'bottom', 'right', 'left']
            });
        });
    </script>
}
