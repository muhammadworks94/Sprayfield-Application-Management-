@model SAM.ViewModels.OperationalData.WWCharViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Wastewater Characteristics Details";
    var user = await UserManager.GetUserAsync(User);
    var canEdit = user != null && (await UserManager.IsInRoleAsync(user, "admin") || await UserManager.IsInRoleAsync(user, "company_admin") || await UserManager.IsInRoleAsync(user, "technician"));
    var nh3Values = Model.NH3NDaily?.Where(x => x.HasValue).Select(x => x!.Value).ToList() ?? new List<decimal>();
    var bod5Values = Model.BOD5Daily?.Where(x => x.HasValue).Select(x => x!.Value).ToList() ?? new List<decimal>();
    var tssValues = Model.TSSDaily?.Where(x => x.HasValue).Select(x => x!.Value).ToList() ?? new List<decimal>();
    var flowValues = Model.FlowRateDaily?.Where(x => x.HasValue).Select(x => x!.Value).ToList() ?? new List<decimal>();
    var avgNH3 = nh3Values.Any() ? nh3Values.Average() : (decimal?)null;
    var avgBOD5 = bod5Values.Any() ? bod5Values.Average() : (decimal?)null;
    var avgTSS = tssValues.Any() ? tssValues.Average() : (decimal?)null;
    var avgFlow = flowValues.Any() ? flowValues.Average() : (decimal?)null;
    var flowMeasuringPointDisplay = Model.FlowMeasuringPoint switch
    {
        SAM.Domain.Enums.FlowMeasuringPointEnum.NoFlowGenerated => "No flow generated",
        SAM.Domain.Enums.FlowMeasuringPointEnum.Influent => "Influent",
        SAM.Domain.Enums.FlowMeasuringPointEnum.Effluent => "Effluent",
        _ => "N/A"
    };
    var parameterMonitoringPointDisplay = Model.ParameterMonitoringPoint switch
    {
        SAM.Domain.Enums.ParameterMonitoringPointEnum.GroundwaterLowering => "Groundwater Lowering",
        SAM.Domain.Enums.ParameterMonitoringPointEnum.SurfaceWater => "Surface Water",
        SAM.Domain.Enums.ParameterMonitoringPointEnum.Influent => "Influent",
        SAM.Domain.Enums.ParameterMonitoringPointEnum.Effluent => "Effluent",
        _ => "N/A"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 page-intro">
    <div>
        <p class="text-muted mb-0">View detailed information for wastewater characteristics record</p>
    </div>
    <div>
        @if (canEdit)
        {
            <a asp-action="WWCharEdit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a asp-action="WWChars" asp-route-facilityId="@Model.FacilityId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h4 class="mb-4"><i class="bi bi-droplet-half me-2"></i>@(Model.FacilityName ?? "Wastewater") – @Model.Month @Model.Year</h4>
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-3">Record Context</h5>
                <dl class="row responsive-detail-list">
                    <dd class="col-sm-5"><i class="bi bi-building me-1"></i>Facility:</dd>
                    <dd class="col-sm-7">@(Model.FacilityName ?? "N/A")</dd>

                    <dd class="col-sm-5"><i class="bi bi-briefcase me-1"></i>Company:</dd>
                    <dd class="col-sm-7">@(Model.CompanyName ?? "N/A")</dd>

                    <dd class="col-sm-5"><i class="bi bi-calendar3 me-1"></i>Period:</dd>
                    <dd class="col-sm-7">@Model.Month @Model.Year</dd>

                    <dd class="col-sm-5"><i class="bi bi-diagram-3 me-1"></i>Flow Measuring Point:</dd>
                    <dd class="col-sm-7">@flowMeasuringPointDisplay</dd>

                    <dd class="col-sm-5"><i class="bi bi-geo-alt me-1"></i>Parameter Monitoring Point:</dd>
                    <dd class="col-sm-7">@parameterMonitoringPointDisplay</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-3">Nitrogen / PAN Parameters</h5>
                <dl class="row responsive-detail-list">
                    <dd class="col-sm-5">
                        <i class="bi bi-droplet me-1"></i>NO2 as N (mg/L):
                        <i class="bi bi-info-circle ms-1 text-muted"
                           title="Nitrite as Nitrogen (mg/L)"
                           aria-label="Nitrite as Nitrogen (mg/L)"></i>
                    </dd>
                    <dd class="col-sm-7">@(Model.NO2N.HasValue? Model.NO2N.Value.ToString("F2") : "N/A")</dd>

                    <dd class="col-sm-5">
                        <i class="bi bi-droplet me-1"></i>TKN as N (mg/L):
                        <i class="bi bi-info-circle ms-1 text-muted"
                           title="Total Kjeldahl Nitrogen as Nitrogen (mg/L)"
                           aria-label="Total Kjeldahl Nitrogen as Nitrogen (mg/L)"></i>
                    </dd>
                    <dd class="col-sm-7">@(Model.TKNN.HasValue? Model.TKNN.Value.ToString("F2") : "N/A")</dd>

                    <dd class="col-sm-5">
                        <i class="bi bi-droplet me-1"></i>NO3 as N (mg/L):
                        <i class="bi bi-info-circle ms-1 text-muted"
                           title="Nitrate as Nitrogen (mg/L)"
                           aria-label="Nitrate as Nitrogen (mg/L)"></i>
                    </dd>
                    <dd class="col-sm-7">@(Model.NO3N.HasValue? Model.NO3N.Value.ToString("F2") : "N/A")</dd>
                </dl>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-12">
                <h5 class="detail-section-label mb-3">Lab and Sampling</h5>

                <div class="row g-2">

                    <!-- Lab Certification -->
                    <div class="col-md-4 d-flex">
                        <div class="fw-semibold me-2">
                            <i class="bi bi-clipboard-check me-1"></i>Lab Certification:
                        </div>
                        <div>
                            @(string.IsNullOrEmpty(Model.LabCertification) ? "N/A" : Model.LabCertification)
                        </div>
                    </div>

                    <!-- Collected By -->
                    <div class="col-md-4 d-flex">
                        <div class="fw-semibold me-2">
                            <i class="bi bi-person me-1"></i>Collected By:
                        </div>
                        <div>
                            @(string.IsNullOrEmpty(Model.CollectedBy) ? "N/A" : Model.CollectedBy)
                        </div>
                    </div>

                    <!-- Analyzed By -->
                    <div class="col-md-4 d-flex">
                        <div class="fw-semibold me-2">
                            <i class="bi bi-person-badge me-1"></i>Analyzed By:
                        </div>
                        <div>
                            @(string.IsNullOrEmpty(Model.AnalyzedBy) ? "N/A" : Model.AnalyzedBy)
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <div class="d-flex justify-content-between">
            <div>
                <h4 class="mb-0">Daily Data</h4>
                <p class="text-muted small mb-0 mt-1">Days 1–31</p>
            </div>

            @if (avgNH3.HasValue || avgBOD5.HasValue || avgTSS.HasValue || avgFlow.HasValue)
            {
                <div class="border rounded p-2 mb-3 bg-light">
                    <span class="small fw-semibold">Monthly summary:</span>
                    @if (avgNH3.HasValue)
                    {
                        <span class="small">Average NH3-N: @avgNH3.Value.ToString("F2") mg/L</span>
                    }
                    @if (avgBOD5.HasValue)
                    {
                        <span class="small">@(avgNH3.HasValue ? " | " : "")Average BOD5: @avgBOD5.Value.ToString("F2") mg/L</span>
                    }
                    @if (avgTSS.HasValue)
                    {
                        <span class="small">@(avgNH3.HasValue || avgBOD5.HasValue ? " | " : "")Average TSS: @avgTSS.Value.ToString("F2") mg/L</span>
                    }
                    @if (avgFlow.HasValue)
                    {
                        <span class="small">@(avgNH3.HasValue || avgBOD5.HasValue || avgTSS.HasValue ? " | " : "")Average Flow: @avgFlow.Value.ToString("F2") GPM</span>
                    }
                </div>
            }
        </div>
        <div class="table-responsive responsive-table wide-data-table wwchar-daily-table-wrapper fixed-height-table-wrapper">
            <table class="table table-sm table-bordered table-striped wwchar-daily-table">
                <thead>
                    <tr>
                        <th scope="col">Day</th>
                        <th scope="col">BOD5 <i class="bi bi-info-circle ms-1 text-muted" title="Biochemical Oxygen Demand, 5-day (mg/L)" aria-label="Biochemical Oxygen Demand, 5-day (mg/L)"></i><br />(mg/L)</th>
                        <th scope="col">TSS <i class="bi bi-info-circle ms-1 text-muted" title="Total Suspended Solids (mg/L)" aria-label="Total Suspended Solids (mg/L)"></i><br />(mg/L)</th>
                        <th scope="col">Flow Rate<br />(GPM)</th>
                        <th scope="col">pH</th>
                        <th scope="col">NH3-N <i class="bi bi-info-circle ms-1 text-muted" title="Ammonia as Nitrogen (mg/L)" aria-label="Ammonia as Nitrogen (mg/L)"></i><br />(mg/L)</th>
                        <th scope="col">Fecal Coliform<br />(CFU/100mL)</th>
                        <th scope="col">Residual Chloride<br />(mg/L)</th>
                        <th scope="col">Ca <i class="bi bi-info-circle ms-1 text-muted" title="Calcium (mg/L)" aria-label="Calcium (mg/L)"></i><br />(mg/L)</th>
                        <th scope="col">Mg <i class="bi bi-info-circle ms-1 text-muted" title="Magnesium (mg/L)" aria-label="Magnesium (mg/L)"></i><br />(mg/L)</th>
                        <th scope="col">Na <i class="bi bi-info-circle ms-1 text-muted" title="Sodium (mg/L)" aria-label="Sodium (mg/L)"></i><br />(mg/L)</th>
                        <th scope="col">SAR <i class="bi bi-info-circle ms-1 text-muted" title="Sodium Adsorption Ratio (mg/L)" aria-label="Sodium Adsorption Ratio (mg/L)"></i><br />(mg/L)</th>
                        <th scope="col">TN <i class="bi bi-info-circle ms-1 text-muted" title="Total Nitrogen (mg/L)" aria-label="Total Nitrogen (mg/L)"></i><br />(mg/L)</th>
                        <th scope="col">Composite<br />Time</th>
                        <th scope="col">ORC <i class="bi bi-info-circle ms-1 text-muted" title="Operator in Responsible Charge On Site" aria-label="Operator in Responsible Charge On Site"></i><br />On Site</th>
                        <th scope="col">Lagoon<br />Freeboard<br />(inches)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < 31; i++)
                    {
                        <tr>
                            <td><strong>@(i + 1)</strong></td>
                            <td>@(Model.BOD5Daily != null && i < Model.BOD5Daily.Count && Model.BOD5Daily[i].HasValue ? Model.BOD5Daily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.TSSDaily != null && i < Model.TSSDaily.Count && Model.TSSDaily[i].HasValue ? Model.TSSDaily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.FlowRateDaily != null && i < Model.FlowRateDaily.Count && Model.FlowRateDaily[i].HasValue ? Model.FlowRateDaily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.PHDaily != null && i < Model.PHDaily.Count && Model.PHDaily[i].HasValue ? Model.PHDaily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.NH3NDaily != null && i < Model.NH3NDaily.Count && Model.NH3NDaily[i].HasValue ? Model.NH3NDaily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.FecalColiformDaily != null && i < Model.FecalColiformDaily.Count && Model.FecalColiformDaily[i].HasValue ? Model.FecalColiformDaily[i].Value.ToString("F0") : "-")</td>
                            <td>@(Model.ChlorideDaily != null && i < Model.ChlorideDaily.Count && Model.ChlorideDaily[i].HasValue ? Model.ChlorideDaily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.CaDaily != null && i < Model.CaDaily.Count && Model.CaDaily[i].HasValue ? Model.CaDaily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.MgDaily != null && i < Model.MgDaily.Count && Model.MgDaily[i].HasValue ? Model.MgDaily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.NaDaily != null && i < Model.NaDaily.Count && Model.NaDaily[i].HasValue ? Model.NaDaily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.SARDaily != null && i < Model.SARDaily.Count && Model.SARDaily[i].HasValue ? Model.SARDaily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.TNDaily != null && i < Model.TNDaily.Count && Model.TNDaily[i].HasValue ? Model.TNDaily[i].Value.ToString("F2") : "-")</td>
                            <td>@(Model.CompositeTime != null && i < Model.CompositeTime.Count && !string.IsNullOrEmpty(Model.CompositeTime[i]) ? Model.CompositeTime[i] : "-")</td>
                            <td>@(Model.ORCOnSite != null && i < Model.ORCOnSite.Count && Model.ORCOnSite[i].HasValue ? Model.ORCOnSite[i].Value.ToString() : "-")</td>
                            <td>@(Model.LagoonFreeboard != null && i < Model.LagoonFreeboard.Count && Model.LagoonFreeboard[i].HasValue ? Model.LagoonFreeboard[i].Value.ToString("F2") : "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
