@model SAM.ViewModels.OperationalData.GWMonitViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@using SAM.Utilities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Groundwater Monitoring Details";
    var user = await UserManager.GetUserAsync(User);
    var canEdit = user != null && (await UserManager.IsInRoleAsync(user, "admin") || await UserManager.IsInRoleAsync(user, "company_admin") || await UserManager.IsInRoleAsync(user, "technician"));
    string Yn(bool? v) => !v.HasValue ? "Unanswered" : (v.Value ? "Yes" : "No");
    string YnBadgeClass(bool? v) => !v.HasValue ? "bg-secondary" : (v.Value ? "bg-success" : "bg-dark");
    string DetailOrNa(string? value) => string.IsNullOrWhiteSpace(value) ? "N/A" : value;
    var hasVocFile = !string.IsNullOrWhiteSpace(Model.VOCReportFileName);
    var vocFileStatus = !hasVocFile
        ? "No VOC PDF uploaded."
        : Model.VOCReportAttached
            ? "VOC PDF is uploaded and attached to the GW-59 report."
            : "VOC PDF is uploaded but not attached to the GW-59 report.";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">View detailed information for groundwater monitoring record</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (canEdit)
        {
            <a asp-action="GWMonitEdit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a asp-action="GWMonits" asp-route-facilityId="@Model.FacilityId" asp-route-monitoringWellId="@Model.MonitoringWellId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@section Scripts {
    <style>
        .gw59a-question {
            border: 1px solid #e4e7ec;
            border-radius: .5rem;
            padding: 1rem 1.1rem;
            margin-bottom: 1rem;
            background: #fff;
        }

        .gw59a-question-text {
            color: #101828;
            line-height: 1.45;
            margin-bottom: .65rem;
        }

        .gw59a-detail-block {
            margin-top: .75rem;
            padding-top: .75rem;
            border-top: 1px dashed #d0d5dd;
        }

        .gw59a-detail-label {
            color: #475467;
            font-size: .875rem;
            margin-bottom: .35rem;
        }

        .gw59a-detail-value {
            color: #101828;
            white-space: pre-wrap;
            word-break: break-word;
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                var tooltipContainer = el.closest('.fixed-height-table-wrapper') || el.closest('.card-body') || document.body;
                var existing = bootstrap.Tooltip.getInstance(el);
                if (existing) {
                    existing.dispose();
                }

                new bootstrap.Tooltip(el, {
                    container: tooltipContainer,
                    trigger: 'hover focus',
                    boundary: 'viewport',
                    fallbackPlacements: ['top', 'bottom', 'right', 'left']
                });
            });
        });
    </script>
}

<div class="card">
    <div class="card-body">
        <h4 class="mb-4"><i class="bi bi-water me-2"></i>@(Model.FacilityName ?? "Facility") – @(Model.MonitoringWellName ?? "Well") – @Model.SampleDate.ToString("MM/dd/yyyy")</h4>
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Record Context</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar3 me-1"></i>Sample Date:</dt>
                    <dd class="col-sm-7 mb-2">@Model.SampleDate.ToString("MM/dd/yyyy")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-building me-1"></i>Facility:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.FacilityName ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-geo-alt me-1"></i>Monitoring Well:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.MonitoringWellName ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-briefcase me-1"></i>Company:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.CompanyName ?? "N/A")</dd>
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-collection me-1"></i>Metals Unfiltered:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.MetalsSamplesCollectedUnfiltered switch { true => "Yes", false => "No", _ => "Not set" })</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet-fill me-1"></i>Metal Samples Field Acidified:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.MetalSamplesFieldAcidified switch { true => "Yes", false => "No", _ => "Not set" })</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Sample Information</h5>
                <dl class="row">
                    @* <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-arrows-vertical me-1"></i>Sample Depth:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.SampleDepth?.ToString("F2") ?? "N/A") feet</dd> *@

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet-half me-1"></i>Water Level:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.WaterLevel?.ToString("F2") ?? "N/A") feet</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-layers me-1"></i>Well Depth:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.WellDepthFeet?.ToString("F2") ?? "N/A") ft</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-circle me-1"></i>Well Diameter:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.DiameterInches?.ToString("F2") ?? "N/A") in</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-rulers me-1"></i>Measuring Point:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.MeasuringPointAboveLandSurface?.ToString("F2") ?? "N/A") ft above land surface</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-arrows-collapse-vertical me-1"></i>Relative M.P. Elevation:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.RelativeMpElevation?.ToString("F2") ?? "N/A") ft</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-distribute-horizontal me-1"></i>Screened Interval:</dt>
                    <dd class="col-sm-7 mb-2">
                        @if (Model.ScreenedIntervalFromFeet.HasValue || Model.ScreenedIntervalToFeet.HasValue)
                        {
                            @($"{Model.ScreenedIntervalFromFeet?.ToString("F2") ?? "?"} to {Model.ScreenedIntervalToFeet?.ToString("F2") ?? "?"} ft")
                        }
                        else
                        {
                            @:N/A
                        }
                    </dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-thermometer-half me-1"></i>Temperature:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.Temperature?.ToString("F1") ?? "N/A") °C</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-speedometer2 me-1"></i>pH:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.PH?.ToString("F2") ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>Gallons Pumped:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.GallonsPumped?.ToString("F2") ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-wind me-1"></i>Odor:</dt>
                    <dd class="col-sm-7 mb-2">@(!string.IsNullOrWhiteSpace(Model.Odor) ? Model.Odor : "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-eye me-1"></i>Appearance:</dt>
                    <dd class="col-sm-7 mb-2">@(!string.IsNullOrWhiteSpace(Model.Appearance) ? Model.Appearance : "N/A")</dd>
                </dl>
            </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Physical Parameters</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-lightning-charge me-1"></i>Specific Conductance:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.Conductivity?.ToString("F2") ?? "N/A") μS/cm</dd>

                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Permit Template Parameters</h5>
                <div class="rounded p-3 bg-light">
                    @if (Model.TemplateParameters.Any(p => p.EnteredValue.HasValue))
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead>
                                    <tr>
                                        <th>PCS</th>
                                        <th>Parameter</th>
                                        <th>Units</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var parameter in Model.TemplateParameters.Where(p => p.EnteredValue.HasValue))
                                {
                                    <tr>
                                        <td>@parameter.PcsCode</td>
                                        <td>@parameter.ParameterName</td>
                                        <td>@parameter.Units</td>
                                        <td>@parameter.EnteredValue?.ToString("0.######")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">No permit-template chemistry values were saved for this record.</span>
                    }
                </div>
            </div>
        </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Organics</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-file-earmark-check me-1"></i>VOC Report Attached:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.VOCReportAttached ? "Yes" : "No")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-upc me-1"></i>VOC Method #:</dt>
                    <dd class="col-sm-7 mb-2">@(!string.IsNullOrWhiteSpace(Model.VOCMethodNumber) ? Model.VOCMethodNumber : "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-paperclip me-1"></i>VOC File:</dt>
                    <dd class="col-sm-7 mb-2">@(hasVocFile ? Model.VOCReportFileName : "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-info-circle me-1"></i>VOC File Status:</dt>
                    <dd class="col-sm-7 mb-2">@vocFileStatus</dd>

                    @if (hasVocFile)
                    {
                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-download me-1"></i>VOC File Access:</dt>
                        <dd class="col-sm-7 mb-2">
                            <div class="d-flex gap-2 flex-wrap">
                                <a class="btn btn-outline-secondary btn-sm"
                                   asp-action="GWMonitVocReportPdf"
                                   asp-route-id="@Model.Id"
                                   target="_blank" rel="noopener">
                                    View VOC PDF
                                </a>
                                <a class="btn btn-outline-primary btn-sm"
                                   asp-action="GWMonitVocReportPdf"
                                   asp-route-id="@Model.Id"
                                   asp-route-download="true">
                                    Download VOC PDF
                                </a>
                            </div>
                        </dd>
                    }
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Biological Parameters</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-bug me-1"></i>Fecal Coliform:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.FecalColiform?.ToString("F0") ?? "N/A") CFU/100mL</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-bug me-1"></i>Total Coliform:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.TotalColiform?.ToString("F0") ?? "N/A") CFU/100mL</dd>
                </dl>
            </div>
        </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-12">
                <h5 class="detail-section-label mb-4">Lab Information</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar-event me-1"></i>Lab Date Sample Analyzed:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.LabSampleAnalyzedDate?.ToString("MM/dd/yyyy") ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-building me-1"></i>Laboratory:</dt>
                    <dd class="col-sm-7 mb-2">@(string.IsNullOrEmpty(Model.ResolvedLabName) ? "N/A" : Model.ResolvedLabName)</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-clipboard-check me-1"></i>Lab Certification No.:</dt>
                    <dd class="col-sm-7 mb-2">@(string.IsNullOrEmpty(Model.ResolvedLabCertificationNumber) ? "N/A" : Model.ResolvedLabCertificationNumber)</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-person me-1"></i>Collected By:</dt>
                    <dd class="col-sm-7 mb-2">@(string.IsNullOrEmpty(Model.CollectedBy) ? "N/A" : Model.CollectedBy)</dd>
                </dl>
            </div>
        </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-12">
                <h5 class="detail-section-label mb-4">GW-59A Compliance</h5>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="text-muted small mb-1">Monitoring results due date</div>
                        <div>@(Model.GW59ADueDate?.ToString("MM/dd/yyyy") ?? "N/A")</div>
                    </div>
                </div>

                <div class="gw59a-question">
                    <div class="gw59a-question-text">@Gw59AQuestionText.FormatQuestion1(Model.GW59ADueDate)</div>
                    <span class="badge @YnBadgeClass(Model.GW59AQuestion1Response)">@Yn(Model.GW59AQuestion1Response)</span>
                </div>

                <div class="gw59a-question">
                    <div class="gw59a-question-text">@Gw59AQuestionText.Question2</div>
                    <span class="badge @YnBadgeClass(Model.GW59AQuestion2Response)">@Yn(Model.GW59AQuestion2Response)</span>
                    <div class="gw59a-detail-block">
                        <div class="gw59a-detail-label">@Gw59AQuestionText.Question2DetailsPrompt</div>
                        <div class="gw59a-detail-value">@DetailOrNa(Model.GW59AQuestion2Details)</div>
                    </div>
                </div>

                <div class="gw59a-question">
                    <div class="gw59a-question-text">@Gw59AQuestionText.Question3</div>
                    <span class="badge @YnBadgeClass(Model.GW59AQuestion3Response)">@Yn(Model.GW59AQuestion3Response)</span>
                </div>

                <div class="gw59a-question">
                    <div class="gw59a-question-text">@Gw59AQuestionText.Question4</div>
                    <span class="badge @YnBadgeClass(Model.GW59AQuestion4Response)">@Yn(Model.GW59AQuestion4Response)</span>
                    <div class="gw59a-detail-block">
                        <div class="gw59a-detail-label">@Gw59AQuestionText.Question4DetailsPrompt</div>
                        <div class="gw59a-detail-value">@DetailOrNa(Model.GW59AQuestion4Details)</div>
                    </div>
                </div>

                <div class="gw59a-question">
                    <div class="gw59a-question-text">@Gw59AQuestionText.Question5</div>
                    <span class="badge @YnBadgeClass(Model.GW59AQuestion5Response)">@Yn(Model.GW59AQuestion5Response)</span>
                    <div class="gw59a-detail-block">
                        <div class="gw59a-detail-label">@Gw59AQuestionText.Question5DetailsPrompt</div>
                        <div class="gw59a-detail-value">@DetailOrNa(Model.GW59AQuestion5Details)</div>
                    </div>
                </div>

                <div class="gw59a-question">
                    <div class="gw59a-question-text">@Gw59AQuestionText.Question6</div>
                    <span class="badge @YnBadgeClass(Model.GW59AQuestion6Response)">@Yn(Model.GW59AQuestion6Response)</span>
                </div>

                <div class="gw59a-question">
                    <div class="gw59a-question-text">@Gw59AQuestionText.Question7</div>
                    <span class="badge @YnBadgeClass(Model.GW59AQuestion7Response)">@Yn(Model.GW59AQuestion7Response)</span>
                    <div class="gw59a-detail-block">
                        <div class="gw59a-detail-label">@Gw59AQuestionText.Question7DetailsPrompt</div>
                        <div class="gw59a-detail-value">@DetailOrNa(Model.GW59AQuestion7Details)</div>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-md-4 mb-3">
                        <div class="text-muted small mb-1">GW-59A signer name</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.GW59ASignerName) ? "N/A" : Model.GW59ASignerName)</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="text-muted small mb-1">GW-59A signer title</div>
                        <div>@(string.IsNullOrWhiteSpace(Model.GW59ASignerTitle) ? "N/A" : Model.GW59ASignerTitle)</div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="text-muted small mb-1">GW-59A signed date</div>
                        <div>@(Model.GW59ASignedDate?.ToString("MM/dd/yyyy") ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-12">
                <h5 class="detail-section-label mb-4">Additional Information</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-chat-left-text me-1"></i>Comments:</dt>
                    <dd class="col-sm-7 mb-2 text-break">@(string.IsNullOrEmpty(Model.Comments) ? "N/A" : Model.Comments)</dd>
                </dl>
            </div>
        </div>
        </div>
    </div>
</div>
