@model SAM.ViewModels.OperationalData.GWMonitViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Groundwater Monitoring Details";
    var user = await UserManager.GetUserAsync(User);
    var canEdit = user != null && (await UserManager.IsInRoleAsync(user, "admin") || await UserManager.IsInRoleAsync(user, "company_admin") || await UserManager.IsInRoleAsync(user, "technician"));
    string Yn(bool? v) => !v.HasValue ? "Unanswered" : (v.Value ? "Yes" : "No");
    var hasVocFile = !string.IsNullOrWhiteSpace(Model.VOCReportFileName);
    var vocFileStatus = !hasVocFile
        ? "No VOC PDF uploaded."
        : Model.VOCReportAttached
            ? "VOC PDF is uploaded and attached to the GW-59 report."
            : "VOC PDF is uploaded but not attached to the GW-59 report.";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">View detailed information for groundwater monitoring record</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (canEdit)
        {
            <a asp-action="GWMonitEdit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a asp-action="GWMonits" asp-route-facilityId="@Model.FacilityId" asp-route-monitoringWellId="@Model.MonitoringWellId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                var tooltipContainer = el.closest('.fixed-height-table-wrapper') || el.closest('.card-body') || document.body;
                var existing = bootstrap.Tooltip.getInstance(el);
                if (existing) {
                    existing.dispose();
                }

                new bootstrap.Tooltip(el, {
                    container: tooltipContainer,
                    trigger: 'hover focus',
                    boundary: 'viewport',
                    fallbackPlacements: ['top', 'bottom', 'right', 'left']
                });
            });
        });
    </script>
}

<div class="card">
    <div class="card-body">
        <h4 class="mb-4"><i class="bi bi-water me-2"></i>@(Model.FacilityName ?? "Facility") – @(Model.MonitoringWellName ?? "Well") – @Model.SampleDate.ToString("MM/dd/yyyy")</h4>
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Record Context</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar3 me-1"></i>Sample Date:</dt>
                    <dd class="col-sm-7 mb-2">@Model.SampleDate.ToString("MM/dd/yyyy")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-building me-1"></i>Facility:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.FacilityName ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-geo-alt me-1"></i>Monitoring Well:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.MonitoringWellName ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-briefcase me-1"></i>Company:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.CompanyName ?? "N/A")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Sample Information</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-arrows-vertical me-1"></i>Sample Depth:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.SampleDepth?.ToString("F2") ?? "N/A") feet</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet-half me-1"></i>Water Level:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.WaterLevel?.ToString("F2") ?? "N/A") feet</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-thermometer-half me-1"></i>Temperature:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.Temperature?.ToString("F1") ?? "N/A") °C</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-speedometer2 me-1"></i>pH:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.PH?.ToString("F2") ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>Gallons Pumped:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.GallonsPumped?.ToString("F2") ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-wind me-1"></i>Odor:</dt>
                    <dd class="col-sm-7 mb-2">@(!string.IsNullOrWhiteSpace(Model.Odor) ? Model.Odor : "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-eye me-1"></i>Appearance:</dt>
                    <dd class="col-sm-7 mb-2">@(!string.IsNullOrWhiteSpace(Model.Appearance) ? Model.Appearance : "N/A")</dd>
                </dl>
            </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Physical Parameters</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-lightning-charge me-1"></i>Specific Conductance:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.Conductivity?.ToString("F2") ?? "N/A") μS/cm</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-cloud me-1"></i>Turbidity:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.Turbidity?.ToString("F2") ?? "N/A") NTU</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Chemical Parameters</h5>
                <div class="rounded p-3 bg-light">
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>TSS:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.TSS?.ToString("F2") ?? "N/A") mg/L</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>NH3-N:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.NH3N?.ToString("F2") ?? "N/A") mg/L</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>NO3-N:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.NO3N?.ToString("F2") ?? "N/A") mg/L</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>TKN:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.TKN?.ToString("F2") ?? "N/A") mg/L</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>TDS:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.TDS?.ToString("F2") ?? "N/A") mg/L</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>Chloride:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.Chloride?.ToString("F2") ?? "N/A") mg/L</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>TOC:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.TOC?.ToString("F2") ?? "N/A") mg/L</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>Calcium:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.Calcium?.ToString("F2") ?? "N/A") mg/L</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet me-1"></i>Magnesium:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.Magnesium?.ToString("F2") ?? "N/A") mg/L</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-collection me-1"></i>Metals Unfiltered:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.MetalsSamplesCollectedUnfiltered ? "Yes" : "No")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet-fill me-1"></i>Metal Samples Field Acidified:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.MetalSamplesFieldAcidified ? "Yes" : "No")</dd>
                </dl>
                </div>
            </div>
        </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Organics</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-file-earmark-check me-1"></i>VOC Report Attached:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.VOCReportAttached ? "Yes" : "No")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-upc me-1"></i>VOC Method #:</dt>
                    <dd class="col-sm-7 mb-2">@(!string.IsNullOrWhiteSpace(Model.VOCMethodNumber) ? Model.VOCMethodNumber : "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-paperclip me-1"></i>VOC File:</dt>
                    <dd class="col-sm-7 mb-2">@(hasVocFile ? Model.VOCReportFileName : "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-info-circle me-1"></i>VOC File Status:</dt>
                    <dd class="col-sm-7 mb-2">@vocFileStatus</dd>

                    @if (hasVocFile)
                    {
                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-download me-1"></i>VOC File Access:</dt>
                        <dd class="col-sm-7 mb-2">
                            <div class="d-flex gap-2 flex-wrap">
                                <a class="btn btn-outline-secondary btn-sm"
                                   asp-action="GWMonitVocReportPdf"
                                   asp-route-id="@Model.Id"
                                   target="_blank" rel="noopener">
                                    View VOC PDF
                                </a>
                                <a class="btn btn-outline-primary btn-sm"
                                   asp-action="GWMonitVocReportPdf"
                                   asp-route-id="@Model.Id"
                                   asp-route-download="true">
                                    Download VOC PDF
                                </a>
                            </div>
                        </dd>
                    }
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Biological Parameters</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-bug me-1"></i>Fecal Coliform:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.FecalColiform?.ToString("F0") ?? "N/A") CFU/100mL</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-bug me-1"></i>Total Coliform:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.TotalColiform?.ToString("F0") ?? "N/A") CFU/100mL</dd>
                </dl>
            </div>
        </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-12">
                <h5 class="detail-section-label mb-4">Lab Information</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-clipboard-check me-1"></i>Lab Certification:</dt>
                    <dd class="col-sm-7 mb-2">@(string.IsNullOrEmpty(Model.LabCertification) ? "N/A" : Model.LabCertification)</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-person me-1"></i>Collected By:</dt>
                    <dd class="col-sm-7 mb-2">@(string.IsNullOrEmpty(Model.CollectedBy) ? "N/A" : Model.CollectedBy)</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-person-badge me-1"></i>Analyzed By:</dt>
                    <dd class="col-sm-7 mb-2">@(string.IsNullOrEmpty(Model.AnalyzedBy) ? "N/A" : Model.AnalyzedBy)</dd>
                </dl>
            </div>
        </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-12">
                <h5 class="detail-section-label mb-4">GW-59A Compliance</h5>
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5 mb-2 text-muted">Due Date (Q1):</dt>
                            <dd class="col-sm-7 mb-2">@(Model.GW59ADueDate?.ToString("MM/dd/yyyy") ?? "N/A")</dd>

                            <dt class="col-sm-5 mb-2 text-muted">Q1 Response:</dt>
                            <dd class="col-sm-7 mb-2">@Yn(Model.GW59AQuestion1Response)</dd>

                            <dt class="col-sm-5 mb-2 text-muted">Q2 Response:</dt>
                            <dd class="col-sm-7 mb-2">@Yn(Model.GW59AQuestion2Response)</dd>

                            <dt class="col-sm-5 mb-2 text-muted">Q3 Response:</dt>
                            <dd class="col-sm-7 mb-2">@Yn(Model.GW59AQuestion3Response)</dd>

                            <dt class="col-sm-5 mb-2 text-muted">Q4 Response:</dt>
                            <dd class="col-sm-7 mb-2">@Yn(Model.GW59AQuestion4Response)</dd>

                            <dt class="col-sm-5 mb-2 text-muted">Q5 Response:</dt>
                            <dd class="col-sm-7 mb-2">@Yn(Model.GW59AQuestion5Response)</dd>

                            <dt class="col-sm-5 mb-2 text-muted">Q6 Response:</dt>
                            <dd class="col-sm-7 mb-2">@Yn(Model.GW59AQuestion6Response)</dd>

                            <dt class="col-sm-5 mb-2 text-muted">Q7 Response:</dt>
                            <dd class="col-sm-7 mb-2">@Yn(Model.GW59AQuestion7Response)</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5 mb-2 text-muted">GW-59A Signer Name:</dt>
                            <dd class="col-sm-7 mb-2">@(string.IsNullOrWhiteSpace(Model.GW59ASignerName) ? "N/A" : Model.GW59ASignerName)</dd>

                            <dt class="col-sm-5 mb-2 text-muted">GW-59A Signer Title:</dt>
                            <dd class="col-sm-7 mb-2">@(string.IsNullOrWhiteSpace(Model.GW59ASignerTitle) ? "N/A" : Model.GW59ASignerTitle)</dd>

                            <dt class="col-sm-5 mb-2 text-muted">GW-59A Signed Date:</dt>
                            <dd class="col-sm-7 mb-2">@(Model.GW59ASignedDate?.ToString("MM/dd/yyyy") ?? "N/A")</dd>
                        </dl>
                    </div>
                </div>
                <dl class="row">
                    <dt class="col-sm-2 mb-2 text-muted">Q2 Details:</dt>
                    <dd class="col-sm-10 mb-2 text-break">@(string.IsNullOrWhiteSpace(Model.GW59AQuestion2Details) ? "N/A" : Model.GW59AQuestion2Details)</dd>

                    <dt class="col-sm-2 mb-2 text-muted">Q4 Details:</dt>
                    <dd class="col-sm-10 mb-2 text-break">@(string.IsNullOrWhiteSpace(Model.GW59AQuestion4Details) ? "N/A" : Model.GW59AQuestion4Details)</dd>

                    <dt class="col-sm-2 mb-2 text-muted">Q5 Details:</dt>
                    <dd class="col-sm-10 mb-2 text-break">@(string.IsNullOrWhiteSpace(Model.GW59AQuestion5Details) ? "N/A" : Model.GW59AQuestion5Details)</dd>

                    <dt class="col-sm-2 mb-2 text-muted">Q7 Details:</dt>
                    <dd class="col-sm-10 mb-2 text-break">@(string.IsNullOrWhiteSpace(Model.GW59AQuestion7Details) ? "N/A" : Model.GW59AQuestion7Details)</dd>
                </dl>
            </div>
        </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-12">
                <h5 class="detail-section-label mb-4">Additional Information</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-chat-left-text me-1"></i>Comments:</dt>
                    <dd class="col-sm-7 mb-2 text-break">@(string.IsNullOrEmpty(Model.Comments) ? "N/A" : Model.Comments)</dd>
                </dl>
            </div>
        </div>
        </div>
    </div>
</div>
