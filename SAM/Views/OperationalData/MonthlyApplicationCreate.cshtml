@model SAM.ViewModels.OperationalData.MonthlyApplicationCreateViewModel
@{
    ViewData["Title"] = "Create Monthly Application";
    var facilities = ViewBag.Facilities as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var sprayfields = ViewBag.Sprayfields as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

@section PageTitleInline {
    <span tabindex="0"
          role="button"
          class="text-info"
          data-bs-toggle="tooltip"
          data-bs-html="true"
          data-bs-placement="left"
          title="<strong>Monthly Application Backend Logic</strong><br/>Wastewater PAN formula used here:<br/>PAN (lbs) = {[MR x (TKN - NH3)] + (1 - VR) x NH3 + NO2 + NO3} x 8.34 x Volume (mgal).<br/>PAN Loading (lbs/acre) = PAN (lbs) / acres.<br/>MR/VR are from Facility defaults (40%/50% fallback), chemistry comes from WWChar monthly values.<br/>Annual PAN limit threshold comes from Crop PANLimit (derived at crop save).<br/>System computes 12-month rolling PAN/hydraulic utilization and asks confirmation on threshold warnings.">
        <i class="bi bi-info-circle fs-5"></i>
    </span>
}

<div class="mb-4">
    <p class="text-muted mb-0">Log a sprayfield-level wastewater application entry.</p>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Create Monthly Application</h5>
        <form asp-action="MonthlyApplicationCreate" method="post" novalidate id="monthlyApplicationForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CompanyId" id="companyIdInput" />
            <input type="hidden" asp-for="ConfirmComplianceWarnings" id="confirmComplianceWarningsInput" />
            <input type="hidden" asp-for="ComplianceWarningSummary" id="complianceWarningSummaryInput" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-lg-4 col-md-6">
                    <label asp-for="FacilityId" class="form-label required"></label>
                    <select asp-for="FacilityId" asp-items="facilities" class="form-select" id="facilitySelect">
                        <option value="">-- Select Facility --</option>
                    </select>
                    <span asp-validation-for="FacilityId" class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label asp-for="SprayfieldId" class="form-label required"></label>
                    <select asp-for="SprayfieldId" asp-items="sprayfields" class="form-select" id="sprayfieldSelect">
                        <option value="">-- Select Sprayfield --</option>
                    </select>
                    <span asp-validation-for="SprayfieldId" class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label asp-for="ApplicationDate" class="form-label required"></label>
                    <input asp-for="ApplicationDate" type="date" class="form-control" />
                    <span asp-validation-for="ApplicationDate" class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label asp-for="VolumeGallons" class="form-label required"></label>
                    <input asp-for="VolumeGallons" type="number" step="any" min="0.01" class="form-control" />
                    <span asp-validation-for="VolumeGallons" class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label asp-for="TimeIrrigatedMinutes" class="form-label"></label>
                    <input asp-for="TimeIrrigatedMinutes" type="number" step="any" min="0" class="form-control" />
                    <span asp-validation-for="TimeIrrigatedMinutes" class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6">
                    <label asp-for="NitrogenMgL" class="form-label required"></label>
                    <input asp-for="NitrogenMgL" type="number" step="any" min="0" class="form-control" />
                    <span asp-validation-for="NitrogenMgL" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Comments" class="form-label"></label>
                    <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Comments" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="MonthlyApplications" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Create Application</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            const facilitySelect = document.getElementById('facilitySelect');
            const sprayfieldSelect = document.getElementById('sprayfieldSelect');
            const companyIdInput = document.getElementById('companyIdInput');
            const form = document.getElementById('monthlyApplicationForm');
            const antiForgeryToken = form?.querySelector('input[name="__RequestVerificationToken"]')?.value;

            async function loadSprayfields(facilityId) {
                sprayfieldSelect.innerHTML = '<option value="">-- Select Sprayfield --</option>';
                if (!facilityId) return;

                const res = await fetch('@Url.Action("GetSprayfieldsForFacility", "OperationalData")?facilityId=' + encodeURIComponent(facilityId));
                if (!res.ok) return;
                const data = await res.json();

                if (data.companyId && companyIdInput) companyIdInput.value = data.companyId;

                (data.sprayfields || []).forEach(sf => {
                    const option = document.createElement('option');
                    option.value = sf.id;
                    option.textContent = sf.name;
                    sprayfieldSelect.appendChild(option);
                });
            }

            async function validateComplianceBeforeSubmit() {
                const payload = {
                    facilityId: facilitySelect?.value || null,
                    sprayfieldId: sprayfieldSelect?.value || null,
                    applicationDate: document.getElementById('ApplicationDate')?.value || null,
                    volumeGallons: document.getElementById('VolumeGallons')?.value || 0,
                    nitrogenMgL: document.getElementById('NitrogenMgL')?.value || 0
                };

                const response = await fetch('@Url.Action("ValidateMonthlyApplication", "OperationalData")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) return null;
                return await response.json();
            }

            facilitySelect?.addEventListener('change', () => loadSprayfields(facilitySelect.value));

            form?.addEventListener('submit', async function (event) {
                event.preventDefault();
                if (!form.checkValidity()) return;

                const result = await validateComplianceBeforeSubmit();
                if (result && result.requiresConfirmation && (result.warnings || []).length > 0) {
                    const ok = confirm((result.warnings || []).join('\n'));
                    if (!ok) return;
                    document.getElementById('confirmComplianceWarningsInput').value = 'true';
                    document.getElementById('complianceWarningSummaryInput').value = (result.warnings || []).join(' | ');
                }

                form.submit();
            });

            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (element) {
                bootstrap.Tooltip.getOrCreateInstance(element);
            });
        })();
    </script>
}
