@model IEnumerable<SAM.ViewModels.OperationalData.MonthlyApplicationViewModel>
@{
    ViewData["Title"] = "Monthly Applications";
    var facilities = ViewBag.Facilities as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var sprayfields = ViewBag.Sprayfields as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var selectedFacilityId = ViewBag.SelectedFacilityId as Guid?;
    var selectedSprayfieldId = ViewBag.SelectedSprayfieldId as Guid?;
    var selectedMonth = ViewBag.SelectedMonth as int?;
    var selectedYear = ViewBag.SelectedYear as int?;
}

@section PageTitleInline {
    <span tabindex="0"
          role="button"
          class="text-info"
          data-bs-toggle="tooltip"
          data-bs-html="true"
          data-bs-placement="left"
          title="<strong>Monthly Application Backend Logic</strong><br/>Wastewater PAN formula used here:<br/>PAN (lbs) = {[MR x (TKN - NH3)] + (1 - VR) x NH3 + NO2 + NO3} x 8.34 x Volume (mgal).<br/>PAN Loading (lbs/acre) = PAN (lbs) / acres.<br/>MR/VR come from Facility defaults (40%/50% if missing), chemistry comes from WWChar monthly values.<br/>Annual PAN limit threshold comes from Crop PANLimit (derived at crop save).<br/>12-month rolling PAN and hydraulic utilization are computed; warnings trigger at 85% and 100%.">
        <i class="bi bi-info-circle fs-5"></i>
    </span>
}

<div class="d-flex justify-content-between align-items-center mb-4 page-intro">
    <div>
        <p class="text-muted mb-0">Track and manage monthly spray application records.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-3">
                @* <label for="facilityId" class="form-label"><i class="bi bi-building me-1"></i>Facility</label> *@
                <select name="facilityId" id="facilityId" class="form-select">
                    <option value="">All Facilities</option>
                    @if (facilities != null)
                    {
                        @foreach (var facility in facilities)
                        {
                            <option value="@facility.Value" selected="@(selectedFacilityId.HasValue && selectedFacilityId.Value.ToString() == facility.Value)">
                                @facility.Text
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                @* <label for="sprayfieldId" class="form-label"><i class="bi bi-diagram-3 me-1"></i>Sprayfield</label> *@
                <select name="sprayfieldId" id="sprayfieldId" class="form-select">
                    <option value="">All Sprayfields</option>
                    @if (sprayfields != null)
                    {
                        @foreach (var sprayfield in sprayfields)
                        {
                            <option value="@sprayfield.Value" selected="@(selectedSprayfieldId.HasValue && selectedSprayfieldId.Value.ToString() == sprayfield.Value)">
                                @sprayfield.Text
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                @* <label for="month" class="form-label"><i class="bi bi-calendar-month me-1"></i>Month</label> *@
                <select name="month" id="month" class="form-select">
                    <option value="">All Months</option>
                    @for (var m = 1; m <= 12; m++)
                    {
                        var monthName = new DateTime(2000, m, 1).ToString("MMMM");
                        <option value="@m" selected="@(selectedMonth.HasValue && selectedMonth.Value == m)">@monthName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                @* <label for="year" class="form-label"><i class="bi bi-calendar3 me-1"></i>Year</label> *@
                <input type="number" placeholder="Year" id="year" name="year" min="2000" max="2100" class="form-control" value="@(selectedYear?.ToString() ?? string.Empty)" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> 
                </button>
                <a asp-action="MonthlyApplications" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i> 
                </a>
            </div>
        </form>

        <div class="d-flex align-items-center justify-content-between mb-4 page-section-header">
            <div class="btn-group" role="group" aria-label="View mode toggle">
                <button type="button" class="btn btn-outline-secondary btn-sm active" id="monthlyAppsTableViewBtn">
                    <i class="bi bi-table"></i> Table
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="monthlyAppsCardViewBtn">
                    <i class="bi bi-grid-3x3-gap"></i> Cards
                </button>
            </div>
            <a asp-action="MonthlyApplicationCreate" asp-route-facilityId="@selectedFacilityId" asp-route-sprayfieldId="@selectedSprayfieldId" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle"></i> Add Application
            </a>
        </div>

        @if (Model.Any())
        {
            <div id="monthlyAppsTableView" class="table-responsive responsive-table monthly-apps-table-wrapper fixed-height-table-wrapper">
                <table class="table table-hover monthly-apps-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Sprayfield</th>
                            <th>Daily Loading (in)</th>
                            <th>Volume (gal)</th>
                            <th>Maximum Hourly Loading (inches/acre)</th>
                            <th class="table-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="MonthlyApplicationDetails" asp-route-id="@item.Id">
                                    @item.ApplicationDate.ToString("MM/dd/yyyy")
                                </a>
                            </td>
                            <td>@item.SprayfieldName</td>
                            <td>@(item.DailyLoadingInches?.ToString("F6") ?? "-")</td>
                            <td>@item.VolumeGallons.ToString("F2")</td>
                            <td>@item.MaximumHourlyLoadingInchesPerAcre.ToString("F2")</td>
                            <td class="table-actions">
                                <div class="d-inline-flex flex-nowrap align-items-center gap-1">
                                    <a asp-action="MonthlyApplicationEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal@(item.Id.ToString().Replace("-", ""))">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                                <div class="modal fade" id="deleteModal@(item.Id.ToString().Replace("-", ""))" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Confirm Delete</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete this monthly application?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="MonthlyApplicationDelete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div id="monthlyAppsCardView" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 d-none responsive-card-grid">
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header-light d-flex justify-content-between align-items-start">
                                <h6 class="mb-0">@item.ApplicationDate.ToString("MM/dd/yyyy")</h6>
                                <small class="text-muted">@item.FacilityName</small>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <dl class="row small mb-3">
                                    <dt class="col-5">Sprayfield</dt>
                                    <dd class="col-7 mb-1">@item.SprayfieldName</dd>

                                    <dt class="col-5">Zone</dt>
                                    <dd class="col-7 mb-1">@item.ZoneName</dd>

                                    <dt class="col-5">Zone Acres</dt>
                                    <dd class="col-7 mb-1">@(item.ZoneAcres.HasValue ? $"{item.ZoneAcres.Value:F2} acres" : "-")</dd>

                                    <dt class="col-5">Volume</dt>
                                    <dd class="col-7 mb-1">@item.VolumeGallons.ToString("F2") gal</dd>

                                    <dt class="col-5">Daily Loading</dt>
                                    <dd class="col-7 mb-1">@(item.DailyLoadingInches?.ToString("F6") ?? "-") in</dd>

                                    <dt class="col-5">Time</dt>
                                    <dd class="col-7 mb-1">@(item.TimeIrrigatedMinutes?.ToString("F2") ?? "-") min</dd>

                                    <dt class="col-5">Max Hourly Loading</dt>
                                    <dd class="col-7 mb-1">@item.MaximumHourlyLoadingInchesPerAcre.ToString("F2") inches/acre</dd>

                                    <dt class="col-5">Operator</dt>
                                    <dd class="col-7 mb-1">@item.OperatorSnapshotName</dd>
                                </dl>

                                <div class="mt-auto d-flex justify-content-end">
                                    <div class="btn-group" role="group" aria-label="Monthly application actions">
                                        <a asp-action="MonthlyApplicationEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModalCard@(item.Id.ToString().Replace("-", ""))">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="deleteModalCard@(item.Id.ToString().Replace("-", ""))" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Confirm Delete</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are you sure you want to delete this monthly application?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="MonthlyApplicationDelete" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox ui-empty-icon"></i>
                <p class="text-muted mt-3 mb-1">No monthly applications found.</p>
                <p class="text-muted small mb-3">Create your first monthly application record to get started.</p>
                <a asp-action="MonthlyApplicationCreate" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle"></i> Create First Application
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const tableBtn = document.getElementById('monthlyAppsTableViewBtn');
            const cardBtn = document.getElementById('monthlyAppsCardViewBtn');
            const tableView = document.getElementById('monthlyAppsTableView');
            const cardView = document.getElementById('monthlyAppsCardView');
            const storageKey = 'monthlyApplicationsViewMode';

            function setViewMode(mode) {
                const isTable = mode === 'table';

                if (isTable) {
                    tableView?.classList.remove('d-none');
                    cardView?.classList.add('d-none');
                    tableBtn?.classList.add('active');
                    cardBtn?.classList.remove('active');
                } else {
                    tableView?.classList.add('d-none');
                    cardView?.classList.remove('d-none');
                    tableBtn?.classList.remove('active');
                    cardBtn?.classList.add('active');
                }

                if (window.localStorage) {
                    localStorage.setItem(storageKey, mode);
                }
            }

            const savedMode = window.localStorage ? localStorage.getItem(storageKey) : null;
            setViewMode(savedMode === 'card' ? 'card' : 'table');

            tableBtn?.addEventListener('click', function () { setViewMode('table'); });
            cardBtn?.addEventListener('click', function () { setViewMode('card'); });

            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (element) {
                bootstrap.Tooltip.getOrCreateInstance(element);
            });
        })();
    </script>
}


