@model IEnumerable<SAM.ViewModels.OperationalData.MonthlyApplicationViewModel>
@{
    ViewData["Title"] = "Monthly Applications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">Track and manage monthly spray application records.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="btn-group" role="group" aria-label="View mode toggle">
                <button type="button" class="btn btn-outline-secondary btn-sm active" id="monthlyAppsTableViewBtn">
                    <i class="bi bi-table"></i> Table
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="monthlyAppsCardViewBtn">
                    <i class="bi bi-grid-3x3-gap"></i> Cards
                </button>
            </div>
            <a asp-action="MonthlyApplicationCreate" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle"></i> Add Application
            </a>
        </div>

        @if (Model.Any())
        {
            <div id="monthlyAppsTableView" class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Facility</th>
                            <th>Sprayfield</th>
                            <th>Zone</th>
                            <th>Volume (gal)</th>
                            <th>Nitrogen (mg/L)</th>
                            <th>Operator</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ApplicationDate.ToString("MM/dd/yyyy")</td>
                            <td>@item.FacilityName</td>
                            <td>@item.SprayfieldName</td>
                            <td>@item.ZoneName</td>
                            <td>@item.VolumeGallons.ToString("F2")</td>
                            <td>@item.NitrogenMgL.ToString("F2")</td>
                            <td>@item.OperatorSnapshotName</td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="MonthlyApplicationDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> 
                                    </a>
                                    <a asp-action="MonthlyApplicationEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> 
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal@(item.Id.ToString().Replace("-", ""))">
                                        <i class="bi bi-trash"></i> 
                                    </button>
                                </div>
                                <div class="modal fade" id="deleteModal@(item.Id.ToString().Replace("-", ""))" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Confirm Delete</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Are you sure you want to delete this monthly application?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="MonthlyApplicationDelete" asp-route-id="@item.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div id="monthlyAppsCardView" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 d-none">
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header-light d-flex justify-content-between align-items-start">
                                <h6 class="mb-0">@item.ApplicationDate.ToString("MM/dd/yyyy")</h6>
                                <small class="text-muted">@item.FacilityName</small>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <dl class="row small mb-3">
                                    <dt class="col-5">Sprayfield</dt>
                                    <dd class="col-7 mb-1">@item.SprayfieldName</dd>

                                    <dt class="col-5">Zone</dt>
                                    <dd class="col-7 mb-1">@item.ZoneName</dd>

                                    <dt class="col-5">Volume</dt>
                                    <dd class="col-7 mb-1">@item.VolumeGallons.ToString("F2") gal</dd>

                                    <dt class="col-5">Nitrogen</dt>
                                    <dd class="col-7 mb-1">@item.NitrogenMgL.ToString("F2") mg/L</dd>

                                    <dt class="col-5">Operator</dt>
                                    <dd class="col-7 mb-1">@item.OperatorSnapshotName</dd>
                                </dl>

                                <div class="mt-auto d-flex justify-content-between">
                                    <a asp-action="MonthlyApplicationDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <div class="btn-group">
                                        <a asp-action="MonthlyApplicationEdit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModalCard@(item.Id.ToString().Replace("-", ""))">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modal fade" id="deleteModalCard@(item.Id.ToString().Replace("-", ""))" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Confirm Delete</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        Are you sure you want to delete this monthly application?
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <form asp-action="MonthlyApplicationDelete" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox ui-empty-icon"></i>
                <p class="text-muted mt-3 mb-1">No monthly applications found.</p>
                <p class="text-muted small mb-3">Create your first monthly application record to get started.</p>
                <a asp-action="MonthlyApplicationCreate" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle"></i> Create First Application
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const tableBtn = document.getElementById('monthlyAppsTableViewBtn');
            const cardBtn = document.getElementById('monthlyAppsCardViewBtn');
            const tableView = document.getElementById('monthlyAppsTableView');
            const cardView = document.getElementById('monthlyAppsCardView');
            const storageKey = 'monthlyApplicationsViewMode';

            function setViewMode(mode) {
                const isTable = mode === 'table';

                if (isTable) {
                    tableView?.classList.remove('d-none');
                    cardView?.classList.add('d-none');
                    tableBtn?.classList.add('active');
                    cardBtn?.classList.remove('active');
                } else {
                    tableView?.classList.add('d-none');
                    cardView?.classList.remove('d-none');
                    tableBtn?.classList.remove('active');
                    cardBtn?.classList.add('active');
                }

                if (window.localStorage) {
                    localStorage.setItem(storageKey, mode);
                }
            }

            const savedMode = window.localStorage ? localStorage.getItem(storageKey) : null;
            setViewMode(savedMode === 'card' ? 'card' : 'table');

            tableBtn?.addEventListener('click', function () { setViewMode('table'); });
            cardBtn?.addEventListener('click', function () { setViewMode('card'); });
        })();
    </script>
}
