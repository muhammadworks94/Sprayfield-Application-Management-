@model SAM.ViewModels.Reports.GroundwaterQualityReportsPageViewModel

@{
    ViewData["Title"] = "GW-59";

    string NextSortDir(string col) => Model.Sort.SortBy == col && Model.Sort.SortDir == "asc" ? "desc" : "asc";
    string SortIcon(string col)
    {
        if (Model.Sort.SortBy != col) return "bi-arrow-down-up text-muted";
        return Model.Sort.SortDir == "asc" ? "bi-sort-up" : "bi-sort-down";
    }

    var startRecord = Model.Reports.TotalCount == 0 ? 0 : (Model.Reports.Page - 1) * Model.Filter.PageSize + 1;
    var endRecord = Math.Min(Model.Reports.Page * Model.Filter.PageSize, Model.Reports.TotalCount);
    var totalPages = Math.Max(1, Model.Reports.TotalPages);
}

@section PageTitleExtra {
    <button type="button" class="btn btn-outline-secondary btn-sm" id="toggleGw59Filters" data-bs-toggle="collapse" data-bs-target="#gw59FiltersCollapse" aria-expanded="false" aria-controls="gw59FiltersCollapse">
        <i class="bi bi-funnel"></i> Show Filters
    </button>
}

<div class="d-flex justify-content-between align-items-center mb-4 page-intro">
    <div>
        <p class="text-muted mb-0">Generate and view GW-59 groundwater quality reports</p>
    </div>
</div>

@if (Model.BlockedFacilityNotices.Any())
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        <strong>Some facilities have restricted report access:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var notice in Model.BlockedFacilityNotices)
            {
                <li>@notice</li>
            }
        </ul>
        <small class="text-muted">Rows for these facilities are disabled until the permit is renewed or the report is re-enabled by the administrator.</small>
    </div>
}

<div class="collapse mb-3" id="gw59FiltersCollapse">
    <div class="card">
        <div class="card-body">
            <form method="get" asp-action="GroundwaterQualityReports" class="row g-3 align-items-end">
                <input type="hidden" name="sortBy" value="@Model.Sort.SortBy" />
                <input type="hidden" name="sortDir" value="@Model.Sort.SortDir" />
                <input type="hidden" name="pageSize" value="@Model.Filter.PageSize" />
                <input type="hidden" name="groupByDate" value="@Model.Filter.GroupByDate.ToString().ToLowerInvariant()" />
                <input type="hidden" name="page" value="1" />

                <div class="col-md-3">
                    <label class="form-label">Facility</label>
                    <select name="facilityId" class="form-select" asp-items="Model.Facilities">
                        <option value="">All Facilities</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Monitoring Well</label>
                    <select name="monitoringWellId" class="form-select" asp-items="Model.MonitoringWells">
                        <option value="">All Wells</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Month</label>
                    <select name="month" class="form-select" asp-items="Model.Months">
                        <option value="">All Months</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Year</label>
                    <input type="number" min="2000" max="2100" name="year" class="form-control" value="@Model.Filter.Year" placeholder="Year" />
                </div>
                <div class="col-md-2 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Apply</button>
                    <a asp-action="GroundwaterQualityReports" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Reset</a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card gw-quality-card">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3 page-section-header">
            <h4 class="mb-0">GW-59 Report List</h4>
            <div class="gw-list-toolbar-summary text-muted">
                @if (Model.Reports.TotalCount == 0)
                {
                    <span>No records</span>
                }
                else
                {
                    <span>@startRecord–@endRecord of @Model.Reports.TotalCount</span>
                }
            </div>
        </div>

        <form method="get" asp-action="GroundwaterQualityReports" id="gw59ListToolbarForm" class="gw-list-toolbar mb-3">
            <input type="hidden" name="facilityId" value="@Model.Filter.FacilityId" />
            <input type="hidden" name="monitoringWellId" value="@Model.Filter.MonitoringWellId" />
            <input type="hidden" name="month" value="@Model.Filter.Month" />
            <input type="hidden" name="year" value="@Model.Filter.Year" />
            <input type="hidden" name="sortBy" value="@Model.Sort.SortBy" />
            <input type="hidden" name="sortDir" value="@Model.Sort.SortDir" />
            <input type="hidden" name="page" value="1" />

            <div class="gw-list-toolbar-group">
                <div class="gw-toolbar-item">
                    <input type="hidden" name="groupByDate" id="groupByDateHidden" value="@Model.Filter.GroupByDate.ToString().ToLowerInvariant()" />
                    <div class="form-check form-switch gw-group-toggle mb-0">
                        <input class="form-check-input" type="checkbox" id="groupByDateToggle" checked="@Model.Filter.GroupByDate" role="switch" aria-label="Group records by sample date" />
                        <label class="form-check-label" for="groupByDateToggle">Group by date</label>
                    </div>
                </div>

                <div class="gw-toolbar-divider" aria-hidden="true"></div>

                <div class="gw-toolbar-item gw-toolbar-item--select">
                    <label class="gw-toolbar-label" for="gw59PageSize">Rows per page</label>
                    <select name="pageSize" id="gw59PageSize" class="form-select form-select-sm gw-page-size-select" aria-label="Rows per page">
                        <option value="25" selected="@(Model.Filter.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.Filter.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.Filter.PageSize == 100)">100</option>
                        <option value="200" selected="@(Model.Filter.PageSize == 200)">200</option>
                    </select>
                </div>
            </div>
        </form>

        <div class="table-responsive gw-quality-table">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>
                            <a class="text-decoration-none" asp-action="GroundwaterQualityReports" asp-route-facilityId="@Model.Filter.FacilityId" asp-route-monitoringWellId="@Model.Filter.MonitoringWellId" asp-route-month="@Model.Filter.Month" asp-route-year="@Model.Filter.Year" asp-route-groupByDate="@Model.Filter.GroupByDate" asp-route-page="1" asp-route-pageSize="@Model.Filter.PageSize" asp-route-sortBy="facility" asp-route-sortDir="@NextSortDir("facility")">Facility <i class="bi @SortIcon("facility")"></i></a>
                        </th>
                        <th>
                            <a class="text-decoration-none" asp-action="GroundwaterQualityReports" asp-route-facilityId="@Model.Filter.FacilityId" asp-route-monitoringWellId="@Model.Filter.MonitoringWellId" asp-route-month="@Model.Filter.Month" asp-route-year="@Model.Filter.Year" asp-route-groupByDate="@Model.Filter.GroupByDate" asp-route-page="1" asp-route-pageSize="@Model.Filter.PageSize" asp-route-sortBy="well" asp-route-sortDir="@NextSortDir("well")">Well <i class="bi @SortIcon("well")"></i></a>
                        </th>
                        <th>
                            <a class="text-decoration-none" asp-action="GroundwaterQualityReports" asp-route-facilityId="@Model.Filter.FacilityId" asp-route-monitoringWellId="@Model.Filter.MonitoringWellId" asp-route-month="@Model.Filter.Month" asp-route-year="@Model.Filter.Year" asp-route-groupByDate="@Model.Filter.GroupByDate" asp-route-page="1" asp-route-pageSize="@Model.Filter.PageSize" asp-route-sortBy="sampledate" asp-route-sortDir="@NextSortDir("sampledate")">Sample Date <i class="bi @SortIcon("sampledate")"></i></a>
                        </th>
                        <th>Permit</th>
                        <th>
                            <a class="text-decoration-none" asp-action="GroundwaterQualityReports" asp-route-facilityId="@Model.Filter.FacilityId" asp-route-monitoringWellId="@Model.Filter.MonitoringWellId" asp-route-month="@Model.Filter.Month" asp-route-year="@Model.Filter.Year" asp-route-groupByDate="@Model.Filter.GroupByDate" asp-route-page="1" asp-route-pageSize="@Model.Filter.PageSize" asp-route-sortBy="collectedby" asp-route-sortDir="@NextSortDir("collectedby")">Collected By <i class="bi @SortIcon("collectedby")"></i></a>
                        </th>
                        <th>
                            <a class="text-decoration-none" asp-action="GroundwaterQualityReports" asp-route-facilityId="@Model.Filter.FacilityId" asp-route-monitoringWellId="@Model.Filter.MonitoringWellId" asp-route-month="@Model.Filter.Month" asp-route-year="@Model.Filter.Year" asp-route-groupByDate="@Model.Filter.GroupByDate" asp-route-page="1" asp-route-pageSize="@Model.Filter.PageSize" asp-route-sortBy="analyzedby" asp-route-sortDir="@NextSortDir("analyzedby")">Analyzed By <i class="bi @SortIcon("analyzedby")"></i></a>
                        </th>
                        <th class="text-end table-actions"><i class="bi bi-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Reports.Items.Any())
                    {
                        if (Model.Filter.GroupByDate)
                        {
                            DateTime? previousDate = null;
                            foreach (var row in Model.Reports.Items)
                            {
                                var sampleDate = row.SampleDate.Date;
                                if (previousDate != sampleDate)
                                {
                                    previousDate = sampleDate;
                                    var totalForDate = Model.RecordCountsBySampleDate.TryGetValue(sampleDate, out var count)
                                        ? count
                                        : 1;

                                    <tr class="gw-date-group-header">
                                        <td colspan="7">
                                            <div class="gw-date-band">
                                                <div class="gw-date-band-meta">
                                                    <span class="gw-date-band-label">@sampleDate.ToString("MMMM d, yyyy")</span>
                                                    <span class="gw-date-band-count">@totalForDate record@(totalForDate == 1 ? string.Empty : "s")</span>
                                                </div>
                                                <a class="btn btn-sm btn-outline-primary report-bulk-download-link"
                                                   asp-action="ExportGW59ReportsBySampleDate"
                                                   asp-route-sampleDate="@sampleDate.ToString("yyyy-MM-dd")"
                                                   asp-route-companyId="@Model.SelectedCompanyId"
                                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                                   asp-route-monitoringWellId="@Model.Filter.MonitoringWellId"
                                                   asp-route-month="@Model.Filter.Month"
                                                   asp-route-year="@Model.Filter.Year">
                                                    <i class="bi bi-file-earmark-pdf me-1"></i>Download all
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }

                                @await Html.PartialAsync("_GroundwaterQualityReportRow", row)
                            }
                        }
                        else
                        {
                            foreach (var row in Model.Reports.Items)
                            {
                                @await Html.PartialAsync("_GroundwaterQualityReportRow", row)
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No groundwater monitoring records found for the selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="gw-list-footer d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3 pt-3 border-top">
            <div class="gw-list-footer-summary text-muted small">
                @if (Model.Reports.TotalCount == 0)
                {
                    <span>Page @Model.Reports.Page of @totalPages</span>
                }
                else
                {
                    <span>Page @Model.Reports.Page of @totalPages · @Model.Reports.TotalCount total record@(Model.Reports.TotalCount == 1 ? string.Empty : "s")</span>
                }
            </div>
            <nav aria-label="GW-59 reports pagination" class="mb-0">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Reports.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="GroundwaterQualityReports" asp-route-facilityId="@Model.Filter.FacilityId" asp-route-monitoringWellId="@Model.Filter.MonitoringWellId" asp-route-month="@Model.Filter.Month" asp-route-year="@Model.Filter.Year" asp-route-groupByDate="@Model.Filter.GroupByDate" asp-route-sortBy="@Model.Sort.SortBy" asp-route-sortDir="@Model.Sort.SortDir" asp-route-page="@(Model.Reports.Page - 1)" asp-route-pageSize="@Model.Filter.PageSize">Previous</a>
                    </li>
                    @for (var p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == Model.Reports.Page ? "active" : "")">
                            <a class="page-link" asp-action="GroundwaterQualityReports" asp-route-facilityId="@Model.Filter.FacilityId" asp-route-monitoringWellId="@Model.Filter.MonitoringWellId" asp-route-month="@Model.Filter.Month" asp-route-year="@Model.Filter.Year" asp-route-groupByDate="@Model.Filter.GroupByDate" asp-route-sortBy="@Model.Sort.SortBy" asp-route-sortDir="@Model.Sort.SortDir" asp-route-page="@p" asp-route-pageSize="@Model.Filter.PageSize">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Reports.Page >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="GroundwaterQualityReports" asp-route-facilityId="@Model.Filter.FacilityId" asp-route-monitoringWellId="@Model.Filter.MonitoringWellId" asp-route-month="@Model.Filter.Month" asp-route-year="@Model.Filter.Year" asp-route-groupByDate="@Model.Filter.GroupByDate" asp-route-sortBy="@Model.Sort.SortBy" asp-route-sortDir="@Model.Sort.SortDir" asp-route-page="@(Model.Reports.Page + 1)" asp-route-pageSize="@Model.Filter.PageSize">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .gw-quality-card,
        .gw-quality-card .card-body,
        .gw-quality-card .table-responsive {
            overflow: visible !important;
        }

        .gw-quality-table {
            overflow-x: auto !important;
            overflow-y: visible !important;
        }

        .gw-action-dropdown {
            position: relative;
        }

        .gw-quality-table .dropdown-menu {
            z-index: 1080;
            min-width: 220px;
        }

        .gw-action-btn,
        .gw-action-btn:focus,
        .gw-action-btn.show,
        .gw-action-btn:active {
            color: #1f2937 !important;
            background-color: #f8f9fa !important;
            border-color: #ced4da !important;
            box-shadow: none !important;
        }

        /* Toolbar */
        .gw-list-toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.75rem 1rem;
            padding: 0.625rem 0.875rem;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 0.5rem;
        }

        .gw-list-toolbar-group {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.75rem 1rem;
        }

        .gw-toolbar-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .gw-toolbar-item--select {
            gap: 0.625rem;
        }

        .gw-toolbar-label {
            margin: 0;
            font-size: 0.8125rem;
            font-weight: 500;
            color: #64748b;
            white-space: nowrap;
        }

        .gw-group-toggle .form-check-input {
            width: 2.25em;
            height: 1.125em;
            margin-top: 0;
            cursor: pointer;
        }

        .gw-group-toggle .form-check-label {
            font-size: 0.875rem;
            font-weight: 500;
            color: #334155;
            cursor: pointer;
            padding-left: 0.375rem;
            user-select: none;
        }

        .gw-page-size-select {
            width: auto;
            min-width: 4.25rem;
            font-size: 0.875rem;
            border-color: #cbd5e1;
            background-color: #fff;
        }

        .gw-toolbar-divider {
            width: 1px;
            height: 1.5rem;
            background: #cbd5e1;
            flex-shrink: 0;
        }

        .gw-list-toolbar-summary {
            font-size: 0.875rem;
            font-weight: 500;
            color: #64748b;
        }

        /* Date group band */
        .gw-date-group-header > td {
            padding: 0 !important;
            border-top: none !important;
            background: transparent !important;
        }

        .gw-date-band {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem 1rem;
            margin: 0.75rem 0 0.375rem;
            padding: 0.5rem 0.75rem;
            background: linear-gradient(to right, #f1f5f9 0%, #f8fafc 100%);
            border-left: 3px solid var(--bs-primary, #0d6efd);
            border-radius: 0 0.375rem 0.375rem 0;
        }

        .gw-quality-table tbody .gw-date-group-header:first-child .gw-date-band {
            margin-top: 0.25rem;
        }

        .gw-date-band-meta {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 0.5rem 0.75rem;
            min-width: 0;
        }

        .gw-date-band-label {
            font-size: 0.9375rem;
            font-weight: 600;
            color: #1e293b;
            letter-spacing: -0.01em;
            line-height: 1.3;
        }

        .gw-date-band-count {
            font-size: 0.8125rem;
            font-weight: 500;
            color: #64748b;
        }

        .gw-date-band .btn-outline-primary {
            font-size: 0.8125rem;
            font-weight: 500;
            padding: 0.3125rem 0.75rem;
            white-space: nowrap;
            border-color: #93c5fd;
            color: #2563eb;
            background: #fff;
        }

        .gw-date-band .btn-outline-primary:hover {
            background: #eff6ff;
            border-color: #2563eb;
            color: #1d4ed8;
        }

        /* Footer */
        .gw-list-footer .pagination-sm .page-link {
            padding: 0.3125rem 0.625rem;
            font-size: 0.8125rem;
        }

        .gw-list-footer-summary {
            line-height: 1.5;
        }

        @@media (max-width: 575.98px) {
            .gw-list-toolbar {
                flex-direction: column;
                align-items: stretch;
            }

            .gw-list-toolbar-group {
                flex-direction: column;
                align-items: stretch;
            }

            .gw-toolbar-divider {
                display: none;
            }

            .gw-toolbar-item--select {
                justify-content: space-between;
            }

            .gw-page-size-select {
                flex: 1;
                max-width: 6rem;
            }

            .gw-date-band {
                flex-direction: column;
                align-items: stretch;
            }

            .gw-date-band .btn-outline-primary {
                align-self: flex-start;
            }
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof bootstrap !== 'undefined') {
                document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
                    bootstrap.Tooltip.getOrCreateInstance(el);
                });
            }

            if (window.SAMLoading) {
                window.SAMLoading.bindLinkClicks('.report-download-link', {
                    loadingMessage: 'Generating groundwater quality report...',
                    useFetchDownload: true,
                    autoHideMs: 15000
                });
                window.SAMLoading.bindLinkClicks('.report-bulk-download-link', {
                    loadingMessage: 'Generating combined GW-59 reports for this date...',
                    useFetchDownload: true,
                    autoHideMs: 60000
                });
            }

            const toolbarForm = document.getElementById('gw59ListToolbarForm');
            const groupByDateToggle = document.getElementById('groupByDateToggle');
            const groupByDateHidden = document.getElementById('groupByDateHidden');
            const pageSizeSelect = document.getElementById('gw59PageSize');

            function syncGroupByDateHidden() {
                if (groupByDateHidden && groupByDateToggle) {
                    groupByDateHidden.value = groupByDateToggle.checked ? 'true' : 'false';
                }
            }

            syncGroupByDateHidden();

            groupByDateToggle?.addEventListener('change', function () {
                syncGroupByDateHidden();
                toolbarForm?.submit();
            });
            pageSizeSelect?.addEventListener('change', function () {
                toolbarForm?.submit();
            });

            const filterCollapseEl = document.getElementById('gw59FiltersCollapse');
            const filterToggleBtn = document.getElementById('toggleGw59Filters');
            if (filterCollapseEl && filterToggleBtn) {
                const updateFilterButton = (shown) => {
                    filterToggleBtn.innerHTML = shown
                        ? '<i class="bi bi-funnel-fill"></i> Hide Filters'
                        : '<i class="bi bi-funnel"></i> Show Filters';
                    filterToggleBtn.setAttribute('aria-expanded', shown ? 'true' : 'false');
                };

                updateFilterButton(false);
                filterCollapseEl.addEventListener('shown.bs.collapse', () => updateFilterButton(true));
                filterCollapseEl.addEventListener('hidden.bs.collapse', () => updateFilterButton(false));
            }
        });
    </script>
}
