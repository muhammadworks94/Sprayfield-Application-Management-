@model SAM.ViewModels.Reports.GroundwaterQualityReportsPageViewModel

@{
    ViewData["Title"] = "Groundwater Quality Reports";
    var facilities = ViewBag.Facilities as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var monitoringWells = ViewBag.MonitoringWells as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var months = ViewBag.Months as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var years = ViewBag.Years as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" asp-action="GroundwaterQualityReports" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Facility</label>
                <select name="facilityId" class="form-select" asp-items="facilities">
                    <option value="">All Facilities</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Monitoring Well</label>
                <select name="monitoringWellId" class="form-select" asp-items="monitoringWells">
                    <option value="">All Wells</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Month</label>
                <select name="month" class="form-select" asp-items="months">
                    <option value="">All Months</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Year</label>
                <select name="year" class="form-select">
                    <option value="">All Years</option>
                    @if (years != null)
                    {
                        foreach (var y in years)
                        {
                            <option value="@y.Value" selected="@(Model.SelectedYear?.ToString() == y.Value)">@y.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card gw-quality-card">
    <div class="card-body">
        <div class="table-responsive gw-quality-table">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Facility</th>
                        <th>Well</th>
                        <th>Sample Date</th>
                        <th>Permit</th>
                        <th>Collected By</th>
                        <th>Analyzed By</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Any())
                    {
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.FacilityName</td>
                                <td>@row.MonitoringWellName</td>
                                <td>@row.SampleDate.ToString("MM/dd/yyyy")</td>
                                <td>
                                    @if (row.PermitDisplay == "No active permit")
                                    {
                                        <span class="badge bg-warning">No active permit</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-success border">@row.PermitDisplay</span>
                                    }
                                </td>
                                <td>@row.CollectedBy</td>
                                <td>@row.AnalyzedBy</td>
                                <td class="text-end">
                                    <div class="dropdown gw-action-dropdown">
                                        <button class="btn btn-sm btn-light border dropdown-toggle gw-action-btn" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false">
                                            <i class="bi bi-gear me-1"></i> Actions
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-action="PreviewGW59Report" asp-route-id="@row.Id">
                                                    <i class="bi bi-eye me-2"></i>Preview GW-59
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item report-download-link" asp-action="ExportGW59Report" asp-route-id="@row.Id">
                                                    <i class="bi bi-file-earmark-pdf me-2"></i>Download GW-59
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item report-download-link" asp-action="ExportGW59AReport" asp-route-id="@row.Id">
                                                    <i class="bi bi-file-earmark-arrow-down me-2"></i>Download GW-59A
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No groundwater monitoring records found for the selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .gw-quality-card,
        .gw-quality-card .card-body,
        .gw-quality-card .table-responsive {
            overflow: visible !important;
        }

        .gw-quality-table {
            overflow-x: auto !important;
            overflow-y: visible !important;
        }

        .gw-action-dropdown {
            position: relative;
        }

        .gw-quality-table .dropdown-menu {
            z-index: 1080;
            min-width: 220px;
        }

        .gw-action-btn,
        .gw-action-btn:focus,
        .gw-action-btn.show,
        .gw-action-btn:active {
            color: #1f2937 !important;
            background-color: #f8f9fa !important;
            border-color: #ced4da !important;
            box-shadow: none !important;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (window.SAMLoading) {
                window.SAMLoading.bindLinkClicks('.report-download-link', {
                    loadingMessage: 'Generating groundwater quality report...',
                    useFetchDownload: true,
                    autoHideMs: 15000
                });
            }
        });
    </script>
}
