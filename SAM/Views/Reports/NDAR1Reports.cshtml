@model SAM.ViewModels.Reports.NDAR1ReportsIndexViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Non-Discharge Application Reports";
    var isGlobalAdmin = Model.IsGlobalAdmin;
    var facilities = Model.Facilities;
    var selectedFacilityId = Model.Filter.FacilityId;
    var reports = Model.Reports.Items;
    var totalPages = Model.Reports.TotalPages;
    var currentPage = Model.Reports.Page;
    var user = await UserManager.GetUserAsync(User);
    var canEdit = user != null && (await UserManager.IsInRoleAsync(user, "admin") || await UserManager.IsInRoleAsync(user, "company_admin"));

    string NextSortDir(string column) =>
        string.Equals(Model.Sort.SortBy, column, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(Model.Sort.SortDir, "asc", StringComparison.OrdinalIgnoreCase)
            ? "desc"
            : "asc";

    bool IsActiveSort(string column) => string.Equals(Model.Sort.SortBy, column, StringComparison.OrdinalIgnoreCase);

    var periodNextSortDir = NextSortDir("period");
    var facilityNextSortDir = NextSortDir("facility");
    var operatorNextSortDir = NextSortDir("operator");
    var logDateNextSortDir = NextSortDir("logDate");
}

@section PageTitleExtra {
    <button class="btn btn-sm btn-outline-secondary"
            type="button"
            id="toggleNdar1Filters"
            data-bs-toggle="collapse"
            data-bs-target="#ndar1FiltersCollapse"
            aria-expanded="false"
            aria-controls="ndar1FiltersCollapse">
        <i class="bi bi-funnel me-1"></i><span>Show Filters</span>
    </button>
}

<div class="d-flex justify-content-between align-items-center mb-4 page-intro">
    <div>
        <p class="text-muted mb-0">Generate and view Non-Discharge Application Reports</p>
    </div>
</div>

<div class="collapse mb-3" id="ndar1FiltersCollapse">
    <div class="card">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label for="facilityId" class="form-label"><i class="bi bi-building me-1"></i>Facility:</label>
                    <select name="facilityId" id="facilityId" class="form-select">
                        <option value="">All Facilities</option>
                        @if (facilities != null)
                        {
                            @foreach (var facility in facilities)
                            {
                                <option value="@facility.Value" selected="@(selectedFacilityId.HasValue && selectedFacilityId.Value.ToString() == facility.Value)">
                                    @facility.Text
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="operatorName" class="form-label"><i class="bi bi-person me-1"></i>Operator:</label>
                    <select name="operatorName" id="operatorName" class="form-select" asp-items="Model.Operators">
                        <option value="">All Operators</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="logDate" class="form-label"><i class="bi bi-calendar-event me-1"></i>Log Date:</label>
                    <input type="date" name="logDate" id="logDate" class="form-control" value="@(Model.Filter.LogDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2">
                    <label for="pageSize" class="form-label">Size:</label>
                    <select name="pageSize" id="pageSize" class="form-select">
                        @foreach (var size in new[] { 25, 50, 100, 200 })
                        {
                            if (Model.Filter.PageSize == size)
                            {
                                <option value="@size" selected>@size</option>
                            }
                            else
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <input type="hidden" name="sortBy" value="@Model.Sort.SortBy" />
                    <input type="hidden" name="sortDir" value="@Model.Sort.SortDir" />
                    <input type="hidden" name="page" value="1" />
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Apply</button>
                    <a asp-action="NDAR1Reports" class="btn btn-outline-secondary w-100"><i class="bi bi-x-circle"></i> Reset</a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-5 page-section-header">
            <h4 class="mb-0">Non-Discharge Application Report List</h4>
            <div class="d-flex page-section-actions">
                <div class="btn-group me-2" role="group" aria-label="View mode toggle">
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary active"
                            id="ndar1ReportsTableViewBtn">
                        <i class="bi bi-table"></i> Table
                    </button>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary"
                            id="ndar1ReportsCardViewBtn">
                        <i class="bi bi-grid-3x3-gap"></i> Cards
                    </button>
                </div>
                @if (canEdit)
                {
                    <a asp-action="GenerateNDAR1Report" asp-route-facilityId="@selectedFacilityId" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle"></i> Generate New Report
                    </a>
                }
            </div>
        </div>
        @if (reports.Any())
        {
            <div id="ndar1ReportsTableView" class="table-responsive responsive-table">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>
                                <a asp-action="NDAR1Reports"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-operatorName="@Model.Filter.OperatorName"
                                   asp-route-logDate="@Model.Filter.LogDate?.ToString("yyyy-MM-dd")"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="period"
                                   asp-route-sortDir="@periodNextSortDir">Period
                                    @if (IsActiveSort("period"))
                                    {
                                        <i class="bi @(Model.Sort.SortDir == "asc" ? "bi-sort-up" : "bi-sort-down") ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="NDAR1Reports"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-operatorName="@Model.Filter.OperatorName"
                                   asp-route-logDate="@Model.Filter.LogDate?.ToString("yyyy-MM-dd")"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="facility"
                                   asp-route-sortDir="@facilityNextSortDir">Facility
                                    @if (IsActiveSort("facility"))
                                    {
                                        <i class="bi @(Model.Sort.SortDir == "asc" ? "bi-sort-up" : "bi-sort-down") ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th><i class="bi bi-check-circle"></i> Irrigation Occurred</th>
                            <th>
                                <a asp-action="NDAR1Reports"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-operatorName="@Model.Filter.OperatorName"
                                   asp-route-logDate="@Model.Filter.LogDate?.ToString("yyyy-MM-dd")"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="operator"
                                   asp-route-sortDir="@operatorNextSortDir">Operator
                                    @if (IsActiveSort("operator"))
                                    {
                                        <i class="bi @(Model.Sort.SortDir == "asc" ? "bi-sort-up" : "bi-sort-down") ms-1"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a asp-action="NDAR1Reports"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-operatorName="@Model.Filter.OperatorName"
                                   asp-route-logDate="@Model.Filter.LogDate?.ToString("yyyy-MM-dd")"
                                   asp-route-page="1"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="logDate"
                                   asp-route-sortDir="@logDateNextSortDir">Log Date
                                    @if (IsActiveSort("logDate"))
                                    {
                                        <i class="bi @(Model.Sort.SortDir == "asc" ? "bi-sort-up" : "bi-sort-down") ms-1"></i>
                                    }
                                </a>
                            </th>
                           
                            <th class="table-actions"><i class="bi bi-gear"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in reports)
                        {
                            <tr>
                                <td>
                                    <a asp-action="NDAR1ReportDetails" asp-route-id="@report.Id">
                                        @report.Month @report.Year
                                    </a>
                                </td>
                                <td>@report.FacilityName</td>
                                <td>
                                    @if (report.DidIrrigationOccur)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(report.CreatedBy) ? "-" : report.CreatedBy)</td>
                                <td>@report.CreatedDate.ToString("MM/dd/yyyy")</td>
                                
                                <td class="table-actions">
                                    @if (canEdit)
                                    {
                                        <a asp-action="NDAR1ReportEdit" asp-route-id="@report.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteNDAR1Modal"
                                                data-report-id="@report.Id"
                                                data-report-period="@($"{report.Month} {report.Year}")">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="ndar1ReportsCardView" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 d-none responsive-card-grid">
                @foreach (var report in reports)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header-light d-flex justify-content-between">
                                <div>
                                    <h6 class="mb-0">
                                        <a asp-action="NDAR1ReportDetails" asp-route-id="@report.Id">
                                            @report.Month @report.Year
                                        </a>
                                    </h6>
                                </div>
                                @if (report.DidIrrigationOccur)
                                {
                                    <span class="badge bg-success">Irrigation Occurred</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No Irrigation</span>
                                }
                            </div>
                            <div class="card-body d-flex flex-column">
                                <dl class="row small mb-3 responsive-detail-list">
                                    @if (isGlobalAdmin)
                                    {
                                        <dt class="col-6"><i class="bi bi-briefcase me-1"></i>Company</dt>
                                        <dd class="col-6 mb-1">@report.CompanyName</dd>
                                    }
                                    <dt class="col-6"><i class="bi bi-building me-1"></i>Facility</dt>
                                    <dd class="col-6 mb-1">@report.FacilityName</dd>
                                    <dt class="col-6"><i class="bi bi-person me-1"></i>Operator</dt>
                                    <dd class="col-6 mb-1">@(string.IsNullOrWhiteSpace(report.CreatedBy) ? "-" : report.CreatedBy)</dd>
                                    <dt class="col-6"><i class="bi bi-calendar-event me-1"></i>Log Date</dt>
                                    <dd class="col-6 mb-1">@report.CreatedDate.ToString("MM/dd/yyyy")</dd>
                                </dl>

                                <div class="mt-auto d-flex justify-content-between">
                                    <div class="btn-group" role="group">
                                        <a asp-action="ExportNDAR1Report" asp-route-id="@report.Id" class="btn btn-sm btn-outline-success js-report-export-link">
                                            <i class="bi bi-file-earmark-spreadsheet"></i> Excel
                                        </a>
                                        <a asp-action="ExportNDAR1ReportPdf" asp-route-id="@report.Id" class="btn btn-sm btn-outline-danger js-report-export-link">
                                            <i class="bi bi-file-earmark-pdf"></i> PDF
                                        </a>
                                    </div>
                                    @if (canEdit)
                                    {
                                        <div class="btn-group" role="group">
                                            <a asp-action="NDAR1ReportEdit" asp-route-id="@report.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil"></i> Edit
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteNDAR1Modal"
                                                    data-report-id="@report.Id"
                                                    data-report-period="@($"{report.Month} {report.Year}")">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination">
                        @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="NDAR1Reports"
                                   asp-route-facilityId="@Model.Filter.FacilityId"
                                   asp-route-operatorName="@Model.Filter.OperatorName"
                                   asp-route-logDate="@Model.Filter.LogDate?.ToString("yyyy-MM-dd")"
                                   asp-route-page="@pageNumber"
                                   asp-route-pageSize="@Model.Filter.PageSize"
                                   asp-route-sortBy="@Model.Sort.SortBy"
                                   asp-route-sortDir="@Model.Sort.SortDir">@pageNumber</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox ui-empty-icon"></i>
                <p class="text-muted mt-3">No Non-Discharge Application Reports found.</p>
                @if (canEdit)
                {
                    <a asp-action="GenerateNDAR1Report" asp-route-facilityId="@selectedFacilityId" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Generate First Report
                    </a>
                }
            </div>
        }
    </div>
</div>

<div class="modal fade" id="deleteNDAR1Modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete NDAR-1 report for <strong id="deleteNDAR1Period"></strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteNDAR1Form" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (window.SAMLoading && window.SAMLoading.bindLinkClicks) {
                window.SAMLoading.bindLinkClicks('.js-report-export-link', {
                    loadingMessage: 'Generating export, please wait...',
                    useFetchDownload: true
                });
            }

            const tableBtn = document.getElementById('ndar1ReportsTableViewBtn');
            const cardBtn = document.getElementById('ndar1ReportsCardViewBtn');
            const tableView = document.getElementById('ndar1ReportsTableView');
            const cardView = document.getElementById('ndar1ReportsCardView');
            const storageKey = 'ndar1ReportsViewMode';

            const deleteModal = document.getElementById('deleteNDAR1Modal');

            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) {
                        return;
                    }

                    const reportId = button.getAttribute('data-report-id');
                    const reportPeriod = button.getAttribute('data-report-period');

                    const periodElement = deleteModal.querySelector('#deleteNDAR1Period');
                    if (periodElement) {
                        periodElement.textContent = reportPeriod;
                    }

                    const form = deleteModal.querySelector('#deleteNDAR1Form');
                    if (form) {
                        const baseUrl = '@Url.Action("NDAR1ReportDelete", "Reports")';
                        form.action = baseUrl + '/' + reportId;
                    }
                });
            }

            function setViewMode(mode) {
                const isTable = mode === 'table';

                if (isTable) {
                    tableView?.classList.remove('d-none');
                    cardView?.classList.add('d-none');
                    tableBtn?.classList.add('active');
                    cardBtn?.classList.remove('active');
                } else {
                    tableView?.classList.add('d-none');
                    cardView?.classList.remove('d-none');
                    tableBtn?.classList.remove('active');
                    cardBtn?.classList.add('active');
                }

                if (window.localStorage) {
                    localStorage.setItem(storageKey, mode);
                }
            }

            const savedMode = window.localStorage ? localStorage.getItem(storageKey) : null;
            setViewMode(savedMode === 'card' ? 'card' : 'table');

            tableBtn?.addEventListener('click', function () {
                setViewMode('table');
            });

            cardBtn?.addEventListener('click', function () {
                setViewMode('card');
            });

            const filterToggleBtn = document.getElementById('toggleNdar1Filters');
            const filterCollapseElement = document.getElementById('ndar1FiltersCollapse');
            if (filterToggleBtn && filterCollapseElement && typeof bootstrap !== 'undefined') {
                const filterCollapse = bootstrap.Collapse.getOrCreateInstance(filterCollapseElement, { toggle: false });
                const label = filterToggleBtn.querySelector('span');

                function setFilterToggleState(isExpanded) {
                    filterToggleBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
                    if (label) {
                        label.textContent = isExpanded ? 'Hide Filters' : 'Show Filters';
                    }
                }

                filterCollapse.hide();
                setFilterToggleState(false);

                filterCollapseElement.addEventListener('shown.bs.collapse', function () {
                    setFilterToggleState(true);
                });

                filterCollapseElement.addEventListener('hidden.bs.collapse', function () {
                    setFilterToggleState(false);
                });
            }
        });
    </script>
}
