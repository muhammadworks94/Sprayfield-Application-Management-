@model SAM.ViewModels.Reports.NDAR1ViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@using SAM.Utilities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Non-Discharge Application Report Details";
    var user = await UserManager.GetUserAsync(User);
    var canEdit = user != null && (await UserManager.IsInRoleAsync(user, "admin") || await UserManager.IsInRoleAsync(user, "company_admin"));
    var report = ViewBag.Report as SAM.Domain.Entities.NDAR1;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">View NDAR-1 report details for @Model.Month @Model.Year</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-success js-report-export-link" asp-action="ExportNDAR1ReportPdf" asp-route-id="@Model.Id">
            <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
        </a>
        <div class="dropdown">
            <button class="btn btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                More...
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item js-report-export-link" asp-action="ExportNDAR1Report" asp-route-id="@Model.Id">
                        <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Excel
                    </a>
                </li>
            </ul>
        </div>
        @if (canEdit)
        {
            <a asp-action="NDAR1ReportEdit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a asp-action="NDAR1Reports" asp-route-companyId="@Model.CompanyId" asp-route-facilityId="@Model.FacilityId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            if (!window.SAMLoading || !window.SAMLoading.bindLinkClicks) {
                return;
            }

            window.SAMLoading.bindLinkClicks('.js-report-export-link', {
                loadingMessage: 'Generating export, please wait...',
                useFetchDownload: true
            });
        })();
    </script>
}

<div class="card">
    <div class="card-body">
        <h4 class="mb-4"><i class="bi bi-clipboard-data me-2"></i>@(Model.FacilityName ?? "Facility") – @Model.Month @Model.Year</h4>
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Record Context</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-briefcase me-1"></i>Company:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.CompanyName ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-building me-1"></i>Facility:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.FacilityName ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar3 me-1"></i>Period:</dt>
                    <dd class="col-sm-7 mb-2">@Model.Month @Model.Year</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-check-circle me-1"></i>Did Irrigation Occur:</dt>
                    <dd class="col-sm-7 mb-2">
                        @if (Model.DidIrrigationOccur)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Report Metadata</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar-plus me-1"></i>Created:</dt>
                    <dd class="col-sm-7 mb-2">@Model.CreatedDate.ToString("MM/dd/yyyy HH:mm") UTC</dd>

                    @if (Model.UpdatedDate.HasValue)
                    {
                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar-check me-1"></i>Updated:</dt>
                        <dd class="col-sm-7 mb-2">@Model.UpdatedDate.Value.ToString("MM/dd/yyyy HH:mm") UTC</dd>
                    }
                </dl>
            </div>
        </div>

        @if (report != null)
        {
            var dynamicFields = report.Fields?.OrderBy(f => f.FieldOrder).ToList() ?? new List<SAM.Domain.Entities.NDAR1Field>();
            <div class="border-top pt-3 mt-3">
                <h5 class="detail-section-label mb-4">Field Information</h5>
                @if (dynamicFields.Any())
                {
                    <div class="row">
                        @foreach (var field in dynamicFields)
                        {
                            <div class="col-md-6 mb-4">
                                <h6 class="mb-3 fw-bold"><i class="bi bi-geo-alt me-1"></i>Field: @(field.Sprayfield?.FieldId ?? "N/A")</h6>
                                <dl class="row small">
                                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-rulers me-1"></i>Area:</dt>
                                    <dd class="col-sm-7 mb-2">@((field.Sprayfield != null ? SprayfieldReportHelper.GetReportAcres(field.Sprayfield) : 0m).ToString("F2")) acres</dd>
                                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-flower1 me-1"></i>Cover Crop:</dt>
                                    <dd class="col-sm-7 mb-2">@(field.Sprayfield != null ? SprayfieldZoneSummaryHelper.GetCropSummary(field.Sprayfield) ?? "N/A" : "N/A")</dd>
                                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-speedometer2 me-1"></i>Permitted (Max) Hourly Rate:</dt>
                                    <dd class="col-sm-7 mb-2">@((field.Sprayfield?.HourlyRateInches?.ToString("F2") ?? "0.00")) in/hr</dd>
                                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar-range me-1"></i>Permitted (Max) Annual Rate:</dt>
                                    <dd class="col-sm-7 mb-2">
                                        @(((field.Sprayfield?.AnnualRateInches ?? field.Sprayfield?.HydraulicLoadingLimitInPerYr ?? 0m).ToString("F2"))) in/yr
                                        <div class="small text-muted">
                                            @(field.Sprayfield?.AnnualRateInches.HasValue == true
                                                ? "Source: Sprayfield Annual Rate (provided)."
                                                : "Source: Hydraulic Loading Limit fallback (Annual Rate not provided).")
                                        </div>
                                    </dd>
                                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar-week me-1"></i>Weekly Rate:</dt>
                                    <dd class="col-sm-7 mb-2">
                                        @((field.Sprayfield?.WeeklyRateInches?.ToString("F2") ?? "-")) in/week
                                        <div class="small text-muted">Planning-only value. Not used as annual fallback.</div>
                                    </dd>
                                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-graph-up me-1"></i>Monthly Loading:</dt>
                                    <dd class="col-sm-7 mb-2">@field.MonthlyLoading.ToString("F2") in</dd>
                                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-bar-chart me-1"></i>12-Month Floating Total:</dt>
                                    <dd class="col-sm-7 mb-2">@field.TwelveMonthFloatingTotal.ToString("F2") in</dd>
                                </dl>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        No field information is available for this report yet. Click Edit to add field application data.
                    </div>
                }
            </div>
        }
    </div>
</div>

