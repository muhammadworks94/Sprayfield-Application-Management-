@model SAM.ViewModels.Reports.IrrRprtViewModel
@using Microsoft.AspNetCore.Identity
@using SAM.Domain.Entities
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Non-Discharge Monitoring Report Details";
    var user = await UserManager.GetUserAsync(User);
    var canEdit = user != null && (await UserManager.IsInRoleAsync(user, "admin") || await UserManager.IsInRoleAsync(user, "company_admin"));
    var statusClass = Model.ComplianceStatus == SAM.Domain.Enums.ComplianceStatusEnum.Compliant ? "compliant" :
                     Model.ComplianceStatus == SAM.Domain.Enums.ComplianceStatusEnum.NonCompliant ? "non-compliant" : "under-review";
    var statusIcon = Model.ComplianceStatus == SAM.Domain.Enums.ComplianceStatusEnum.Compliant ? "check-circle" :
                     Model.ComplianceStatus == SAM.Domain.Enums.ComplianceStatusEnum.NonCompliant ? "x-circle" : "hourglass-split";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0">View detailed Non-Discharge Monitoring Report for @Model.Month @Model.Year</p>
    </div>
    <div>
        <a class="btn btn-success js-report-export-link" asp-action="ExportNDMRReport" asp-route-id="@Model.Id">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Excel
        </a>
        @if (canEdit)
        {
            <a asp-action="NDMRReportEdit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Edit
            </a>
        }
        <a asp-action="NDMRReports" asp-route-companyId="@Model.CompanyId" asp-route-facilityId="@Model.FacilityId" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            if (!window.SAMLoading || !window.SAMLoading.bindLinkClicks) {
                return;
            }

            window.SAMLoading.bindLinkClicks('.js-report-export-link', {
                loadingMessage: 'Generating export, please wait...',
                useFetchDownload: true
            });
        })();
    </script>
}

<div class="card">
    <div class="card-body">
        <h4 class="mb-4"><i class="bi bi-file-earmark-bar-graph me-2"></i>@(Model.FacilityName ?? "Facility") – @Model.Month @Model.Year</h4>
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Record Context</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-briefcase me-1"></i>Company:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.CompanyName ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-building me-1"></i>Facility:</dt>
                    <dd class="col-sm-7 mb-2">@(Model.FacilityName ?? "N/A")</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar3 me-1"></i>Period:</dt>
                    <dd class="col-sm-7 mb-2">@Model.Month @Model.Year</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Volume & Application</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-droplet-half me-1"></i>Total Volume Applied:</dt>
                    <dd class="col-sm-7 mb-2">@Model.TotalVolumeApplied.ToString("N2") gallons</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-speedometer2 me-1"></i>Total Application Rate:</dt>
                    <dd class="col-sm-7 mb-2">@Model.TotalApplicationRate.ToString("F2") inches</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-graph-up me-1"></i>Hydraulic Loading Rate:</dt>
                    <dd class="col-sm-7 mb-2">@Model.HydraulicLoadingRate.ToString("F2") inches/year</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-percent me-1"></i>Application Efficiency:</dt>
                    <dd class="col-sm-7 mb-2">@Model.ApplicationEfficiency.ToString("F1")%</dd>
                </dl>
            </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Nitrogen & PAN</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-arrow-up-circle me-1"></i>Nitrogen Loading Rate:</dt>
                    <dd class="col-sm-7 mb-2">@Model.NitrogenLoadingRate.ToString("F2") lbs/acre/year</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-arrow-down-circle me-1"></i>PAN Uptake Rate:</dt>
                    <dd class="col-sm-7 mb-2">@Model.PanUptakeRate.ToString("F2") lbs/acre/year</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Summary & Notes</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-cloud-sun me-1"></i>Weather Summary:</dt>
                    <dd class="col-sm-7 mb-2">@(string.IsNullOrEmpty(Model.WeatherSummary) ? "N/A" : Model.WeatherSummary)</dd>

                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-journal-text me-1"></i>Operational Notes:</dt>
                    <dd class="col-sm-7 mb-2 text-break">@(string.IsNullOrEmpty(Model.OperationalNotes) ? "N/A" : Model.OperationalNotes)</dd>
                </dl>
            </div>
        </div>
        </div>
        <div class="border-top pt-3 mt-3">
        <div class="row">
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Compliance Status</h5>
                <div class="rounded p-3 bg-light text-center">
                    <i class="bi bi-@statusIcon compliance-status-icon text-@statusClass"></i>
                    <h4 class="mt-2 mb-2">
                        <span class="badge badge-@statusClass p-2 fs-5">@Model.ComplianceStatus</span>
                    </h4>
                    <p class="text-muted mb-0">
                        @if (Model.ComplianceStatus == SAM.Domain.Enums.ComplianceStatusEnum.Compliant)
                        {
                            <text>All parameters are within acceptable limits.</text>
                        }
                        else if (Model.ComplianceStatus == SAM.Domain.Enums.ComplianceStatusEnum.NonCompliant)
                        {
                            <text>One or more parameters exceed acceptable limits. Review required.</text>
                        }
                        else
                        {
                            <text>Parameters are close to limits. Review recommended.</text>
                        }
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <h5 class="detail-section-label mb-4">Report Metadata</h5>
                <dl class="row">
                    <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar-plus me-1"></i>Created:</dt>
                    <dd class="col-sm-7 mb-2">@Model.CreatedDate.ToString("MM/dd/yyyy HH:mm") UTC</dd>

                    @if (Model.UpdatedDate.HasValue)
                    {
                        <dt class="col-sm-5 mb-2 text-muted"><i class="bi bi-calendar-check me-1"></i>Updated:</dt>
                        <dd class="col-sm-7 mb-2">@Model.UpdatedDate.Value.ToString("MM/dd/yyyy HH:mm") UTC</dd>
                    }
                </dl>
            </div>
        </div>
        </div>
    </div>
</div>

