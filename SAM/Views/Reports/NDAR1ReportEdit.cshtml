@model SAM.ViewModels.Reports.NDAR1EditGridViewModel
@{
    ViewData["Title"] = "Edit NDAR-1 Report";
    var weatherOptions = new[]
    {
        new { Code = "C", Label = "Clear (C)" },
        new { Code = "CL", Label = "Cloudy (CL)" },
        new { Code = "PC", Label = "Partly Cloudy (PC)" },
        new { Code = "R", Label = "Rain (R)" },
        new { Code = "SL", Label = "Sleet (SL)" },
        new { Code = "SN", Label = "Snow (SN)" }
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 page-intro">
    <div>
        <p class="text-muted mb-0">Edit daily data for @Model.Month @Model.Year. Changes save automatically as you tab through cells.</p>
    </div>
    <a asp-action="NDAR1ReportDetails" asp-route-id="@Model.NDAR1Id" class="btn btn-secondary" id="ndarBackToDetails">
        <i class="bi bi-arrow-left"></i> Back to Details
    </a>
</div>

<div class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <h5 class="mb-3">Daily Grid (Live Source)</h5>
        <p class="text-muted small">Each row updates the same underlying records used in Operations. Tab through a column to enter data quickly.</p>
        <div class="alert alert-info py-2 small mb-3">
            <strong>Lagoon freeboard:</strong>
            Lagoon Berm Height =
            @(Model.LagoonBermHeightFeet.HasValue ? $"{Model.LagoonBermHeightFeet.Value:F2} ft" : "not configured");
            |
            Required Minimum Freeboard =
            @(Model.PermittedMinimumFreeboardFeet.HasValue ? $"{Model.PermittedMinimumFreeboardFeet.Value:F2} ft" : "N/A").
            Enter <strong>Water Depth (ft)</strong>; freeboard is calculated as berm height minus water depth.
        </div>

        <div class="table-responsive responsive-table wide-data-table ndar-daily-table-wrapper fixed-height-table-wrapper">
            <table class="table table-bordered table-sm ndar-daily-table" id="ndarLiveGrid"
                   data-berm-height="@(Model.LagoonBermHeightFeet?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                   data-min-freeboard="@(Model.PermittedMinimumFreeboardFeet?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                <thead>
                    <tr>
                        <th>Day</th>
                        <th>Weather</th>
                        <th>Temp (F)</th>
                        <th>Precip (in)</th>
                        <th>Water Depth (ft)</th>
                        <th>Storage Lagoon Freeboard (ft)</th>
                        <th>5-Day Upset (ft)</th>
                        @foreach (var field in Model.FieldColumns)
                        {
                            <th>Field @field.FieldCode<br /><small>Vol (gal)</small></th>
                            <th>Field @field.FieldCode<br /><small>Time (min)</small></th>
                            <th>Field @field.FieldCode<br /><small>Max Hr (in/ac)</small></th>
                            <th>Field @field.FieldCode<br /><small>Daily Load (in)</small></th>
                        }
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var lockedByOther = !string.IsNullOrWhiteSpace(row.LockedBy) && !row.IsLockedByCurrentUser;
                        var editable = !lockedByOther;
                        <tr data-day="@row.DayNo"
                            data-date="@row.Date.ToString("yyyy-MM-dd")"
                            data-locked-by-other="@(lockedByOther ? "true" : "false")">
                            <td><strong>@row.DayNo</strong></td>
                            <td>
                                <select class="form-select form-select-sm ndar-editable" data-field="weatherCode" @(editable ? null : "disabled")>
                                    <option value=""></option>
                                    @foreach (var weather in weatherOptions)
                                    {
                                        if (string.Equals(row.WeatherCode, weather.Code, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <option value="@weather.Code" selected>@weather.Label</option>
                                        }
                                        else
                                        {
                                            <option value="@weather.Code">@weather.Label</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td><input class="form-control form-control-sm ndar-editable" data-field="temperatureF" type="number" step="0.01" value="@row.TemperatureF" @(editable ? null : "disabled") /></td>
                            <td><input class="form-control form-control-sm ndar-editable" data-field="precipitationIn" type="number" step="0.01" value="@row.PrecipitationIn" @(editable ? null : "disabled") /></td>
                            <td><input class="form-control form-control-sm ndar-editable" data-field="waterDepthFt" type="number" step="0.01" value="@row.WaterDepthFt" @(editable ? null : "disabled") /></td>
                            <td><input class="form-control form-control-sm ndar-readonly" data-field="storageFt" type="number" step="0.01" value="@row.StorageFt" disabled title="Calculated from lagoon berm height minus water depth." /></td>
                            <td><input class="form-control form-control-sm ndar-editable" data-field="fiveDayUpsetFt" type="number" step="0.01" value="@row.FiveDayUpsetFt" @(editable ? null : "disabled") /></td>
                            @foreach (var app in row.Applications)
                            {
                                <td><input class="form-control form-control-sm ndar-readonly" data-app="volumeGallons" data-sprayfield-id="@app.SprayfieldId" type="number" step="1" value="@app.VolumeGallons" disabled title="Calculated field from time irrigated. This value is read-only." /></td>
                                <td><input class="form-control form-control-sm ndar-editable" data-app="timeIrrigatedMinutes" data-sprayfield-id="@app.SprayfieldId" type="number" step="1" value="@app.TimeIrrigatedMinutes" @(editable ? null : "disabled") /></td>
                                <td><input class="form-control form-control-sm ndar-readonly" data-app="maximumHourlyLoadingInchesPerAcre" data-sprayfield-id="@app.SprayfieldId" type="number" step="0.01" value="@app.MaximumHourlyLoadingInchesPerAcre" disabled title="Static value from Sprayfield Actual Hourly Rate. This value is read-only." /></td>
                                <td><input class="form-control form-control-sm ndar-readonly" data-app="dailyLoadingInches" data-sprayfield-id="@app.SprayfieldId" type="number" step="0.01" value="@app.DailyLoadingInches" disabled title="Calculated from time irrigated and actual hourly rate. This value is read-only." /></td>
                            }
                            <td class="text-nowrap row-status-cell">
                                <span class="row-status-icon" data-status="idle" title="Ready">
                                    <i class="bi bi-check-circle text-muted"></i>
                                </span>
                                <span class="badge bg-warning text-dark lock-badge @(lockedByOther ? "" : "d-none")" title="@row.LockedBy">@(lockedByOther ? row.LockedBy : "")</span>
                                <input type="hidden" class="lock-token" value="@(row.LockToken?.ToString() ?? "")" />
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <th colspan="7">Monthly Total - Volume Applied (gal)</th>
                        @foreach (var field in Model.FieldColumns)
                        {
                            <th data-total-volume="@field.SprayfieldId">@field.MonthlyVolumeTotalGallons.ToString("F0")</th>
                            <th></th>
                            <th></th>
                            <th></th>
                        }
                        <th></th>
                    </tr>
                    <tr class="table-light">
                        <th colspan="7">Monthly Total - Daily Loading (in)</th>
                        @foreach (var field in Model.FieldColumns)
                        {
                            <th></th>
                            <th></th>
                            <th></th>
                            <th data-total-loading="@field.SprayfieldId">@field.MonthlyDailyLoadingTotalInches.ToString("F2")</th>
                        }
                        <th></th>
                    </tr>
                    <tr class="table-light">
                        <th colspan="7">12-Month Floating Total (in)</th>
                        @foreach (var field in Model.FieldColumns)
                        {
                            <th></th>
                            <th></th>
                            <th></th>
                            <th data-total-floating="@field.SprayfieldId">@field.TwelveMonthFloatingTotalInches.ToString("F2")</th>
                        }
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<style>
    #ndarLiveGrid select.weather-select-selected {
        background-image: none !important;
        padding-right: 0.5rem;
    }

    #ndarLiveGrid th:first-child,
    #ndarLiveGrid td:first-child {
        position: sticky;
        left: 0;
        z-index: 3;
        background-color: #fff;
        min-width: 72px;
        box-shadow: 1px 0 0 #dee2e6;
    }

    #ndarLiveGrid thead th:first-child {
        z-index: 5;
        background-color: #f8f9fa;
    }

    #ndarLiveGrid tfoot th:first-child,
    #ndarLiveGrid tfoot td:first-child {
        background-color: #f8f9fa;
    }

    #ndarLiveGrid th:last-child,
    #ndarLiveGrid td:last-child {
        position: sticky;
        right: 0;
        z-index: 3;
        background-color: #fff;
        width: 72px;
        min-width: 72px;
        max-width: 72px;
        box-shadow: -1px 0 0 #dee2e6;
    }

    #ndarLiveGrid thead th:last-child {
        z-index: 4;
        background-color: #f8f9fa;
    }

    #ndarLiveGrid tfoot th:last-child,
    #ndarLiveGrid tfoot td:last-child {
        background-color: #f8f9fa;
    }

    #ndarLiveGrid tbody tr:focus-within {
        background-color: #f8fbff;
    }

    #ndarLiveGrid tbody tr[data-locked-by-other="true"] {
        background-color: #fff8e6;
    }

    #ndarLiveGrid .ndar-editable:focus {
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        border-color: #86b7fe;
    }

    #ndarLiveGrid input.ndar-readonly:disabled {
        background-color: #e9ecef;
        color: #6c757d;
        cursor: not-allowed;
        opacity: 1;
    }

    #ndarLiveGrid tbody tr:focus-within input.ndar-readonly:disabled {
        background-color: #e9ecef;
    }

    #ndarLiveGrid td.row-status-cell {
        white-space: nowrap;
        text-align: center;
        vertical-align: middle;
    }

    #ndarLiveGrid .row-status-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
    }

    #ndarLiveGrid .lock-badge {
        font-size: 0.65rem;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        display: block;
        margin-top: 2px;
    }
</style>

@section Scripts {
    <script src="~/js/grid-keyboard-navigation.js" asp-append-version="true"></script>
    <script>
        (() => {
            const ndar1Id = "@Model.NDAR1Id";
            const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const grid = document.getElementById('ndarLiveGrid');
            if (!grid) return;

            const fieldAcresById = {
                @for (var i = 0; i < Model.FieldColumns.Count; i++)
                {
                    var field = Model.FieldColumns[i];
                    @:"@field.SprayfieldId": @(field.Acres.HasValue ? field.Acres.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "null")@(i < Model.FieldColumns.Count - 1 ? "," : "")
                }
            };

            const rowStates = new Map();
            let ndarRefreshTimer = null;
            let storedReportRefreshTimer = null;
            let storedReportRefreshPromise = null;
            let needsStoredReportRefresh = false;
            let isLeavingPage = false;
            let activeEditRow = null;
            const heldLockTokens = new Set();
            const ROW_SAVE_DEBOUNCE_MS = 400;
            const STORED_REPORT_REFRESH_DEBOUNCE_MS = 2500;

            const recalcFooterTotals = () => {
                const volumeTotals = {};
                const loadingTotals = {};

                Object.keys(fieldAcresById).forEach(sf => {
                    volumeTotals[sf] = 0;
                    loadingTotals[sf] = 0;
                });

                grid.querySelectorAll('tbody tr[data-day]').forEach(tr => {
                    Object.keys(fieldAcresById).forEach(sf => {
                        const volumeInput = tr.querySelector(`input[data-app="volumeGallons"][data-sprayfield-id="${sf}"]`);
                        const rawVolume = volumeInput?.value?.trim() ?? '';
                        const volume = rawVolume === '' ? null : Number(rawVolume);
                        if (volume != null && !Number.isNaN(volume)) {
                            volumeTotals[sf] += volume;
                        }

                        const acres = fieldAcresById[sf];
                        if (acres && volume != null && !Number.isNaN(volume) && acres > 0) {
                            loadingTotals[sf] += (volume / (acres * 27154));
                        }
                    });
                });

                Object.keys(fieldAcresById).forEach(sf => {
                    const volumeCell = grid.querySelector(`[data-total-volume="${sf}"]`);
                    const loadingCell = grid.querySelector(`[data-total-loading="${sf}"]`);
                    if (volumeCell) volumeCell.textContent = Math.round(volumeTotals[sf]).toString();
                    if (loadingCell) loadingCell.textContent = loadingTotals[sf].toFixed(2);
                });
            };

            const refreshFloatingTotals = async () => {
                try {
                    const resp = await fetch(`@Url.Action("NDAR1RefreshGridTotals", "Reports")?ndar1Id=${ndar1Id}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': antiForgery }
                    });
                    if (!resp.ok) return;
                    const result = await resp.json();
                    if (!result?.fieldColumns) return;
                    result.fieldColumns.forEach(col => {
                        const sf = col.sprayfieldId;
                        const floatingCell = grid.querySelector(`[data-total-floating="${sf}"]`);
                        if (floatingCell && col.twelveMonthFloatingTotalInches != null) {
                            floatingCell.textContent = Number(col.twelveMonthFloatingTotalInches).toFixed(2);
                        }
                    });
                } catch {
                    // Best-effort refresh.
                }
            };

            const scheduleNdarRefresh = () => {
                if (ndarRefreshTimer) clearTimeout(ndarRefreshTimer);
                ndarRefreshTimer = setTimeout(refreshFloatingTotals, 2500);
            };

            const refreshStoredNdarReport = async () => {
                if (!needsStoredReportRefresh) {
                    return true;
                }

                if (storedReportRefreshPromise) {
                    return storedReportRefreshPromise;
                }

                storedReportRefreshPromise = (async () => {
                    try {
                        const resp = await fetch(`@Url.Action("NDAR1RefreshStoredReport", "Reports")?ndar1Id=${ndar1Id}`, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': antiForgery }
                        });
                        const result = await tryReadJson(resp);
                        if (!resp.ok || !result?.success) {
                            showError(result?.message || 'Unable to refresh the stored NDAR-1 report. NDMLR volume may be stale until you try again.');
                            return false;
                        }

                        needsStoredReportRefresh = false;
                        return true;
                    } catch {
                        showError('Unable to refresh the stored NDAR-1 report. NDMLR volume may be stale until you try again.');
                        return false;
                    } finally {
                        storedReportRefreshPromise = null;
                    }
                })();

                return storedReportRefreshPromise;
            };

            const scheduleStoredReportRefresh = () => {
                needsStoredReportRefresh = true;
                if (storedReportRefreshPromise) {
                    return;
                }
                if (storedReportRefreshTimer) clearTimeout(storedReportRefreshTimer);
                storedReportRefreshTimer = setTimeout(async () => {
                    storedReportRefreshTimer = null;
                    await refreshStoredNdarReport();
                }, STORED_REPORT_REFRESH_DEBOUNCE_MS);
            };

            const cancelScheduledStoredReportRefresh = () => {
                if (storedReportRefreshTimer) {
                    clearTimeout(storedReportRefreshTimer);
                    storedReportRefreshTimer = null;
                }
            };

            const showError = (message) => {
                const safeMessage = message || 'Something went wrong. Please try again.';
                if (window.toastr) {
                    window.toastr.error(safeMessage);
                    return;
                }
                console.error(safeMessage);
            };

            const tryReadJson = async (response) => {
                try {
                    return await response.json();
                } catch {
                    return null;
                }
            };

            const syncWeatherIconState = (selectEl) => {
                if (!selectEl) return;
                const hasValue = !!selectEl.value && selectEl.value.trim() !== '';
                selectEl.classList.toggle('weather-select-selected', hasValue);
            };

            const setRowStatus = (tr, status, title) => {
                const icon = tr.querySelector('.row-status-icon');
                if (!icon) return;
                icon.dataset.status = status;
                icon.title = title || '';
                const icons = {
                    idle: '<i class="bi bi-check-circle text-muted"></i>',
                    dirty: '<i class="bi bi-circle-fill text-warning" style="font-size:0.5rem;"></i>',
                    saving: '<span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>',
                    saved: '<i class="bi bi-check-circle text-success"></i>',
                    error: '<i class="bi bi-exclamation-circle text-danger"></i>',
                    locked: '<i class="bi bi-lock-fill text-warning"></i>'
                };
                icon.innerHTML = icons[status] || icons.idle;
            };

            const collectRowPayload = (tr, options = {}) => {
                const apps = {};
                tr.querySelectorAll('input[data-app]').forEach(i => {
                    const sprayfieldId = i.dataset.sprayfieldId;
                    const key = i.dataset.app;
                    if (!apps[sprayfieldId]) {
                        apps[sprayfieldId] = { sprayfieldId, volumeGallons: null, timeIrrigatedMinutes: null, maximumHourlyLoadingInchesPerAcre: null };
                    }
                    if (key === 'dailyLoadingInches') return;
                    const value = i.value.trim();
                    apps[sprayfieldId][key] = value === '' ? null : Number(value);
                });

                const numOrNull = selector => {
                    const raw = tr.querySelector(selector)?.value?.trim();
                    return raw === '' || raw == null ? null : Number(raw);
                };

                return {
                    dayNo: Number(tr.dataset.day),
                    lockToken: tr.querySelector('.lock-token')?.value || '',
                    weatherCode: tr.querySelector('select[data-field="weatherCode"]').value,
                    temperatureF: numOrNull('input[data-field="temperatureF"]'),
                    precipitationIn: numOrNull('input[data-field="precipitationIn"]'),
                    waterDepthFt: numOrNull('input[data-field="waterDepthFt"]'),
                    fiveDayUpsetFt: numOrNull('input[data-field="fiveDayUpsetFt"]'),
                    applications: Object.values(apps),
                    keepLockAfterSave: true,
                    skipNdarRefresh: options.skipNdarRefresh ?? true
                };
            };

            const payloadSignature = (payload) => JSON.stringify({
                weatherCode: payload.weatherCode,
                temperatureF: payload.temperatureF,
                precipitationIn: payload.precipitationIn,
                waterDepthFt: payload.waterDepthFt,
                fiveDayUpsetFt: payload.fiveDayUpsetFt,
                applications: payload.applications
            });

            const getLagoonBermHeight = () => {
                const raw = grid.dataset.bermHeight;
                return raw === '' || raw == null ? null : Number(raw);
            };

            const getMinFreeboard = () => {
                const raw = grid.dataset.minFreeboard;
                return raw === '' || raw == null ? null : Number(raw);
            };

            const refreshLagoonFreeboard = (tr) => {
                const bermHeight = getLagoonBermHeight();
                const minFreeboard = getMinFreeboard();
                const waterDepthRaw = tr.querySelector('input[data-field="waterDepthFt"]')?.value?.trim();
                const waterDepth = waterDepthRaw === '' || waterDepthRaw == null ? null : Number(waterDepthRaw);
                const freeboardInput = tr.querySelector('input[data-field="storageFt"]');
                if (!freeboardInput) {
                    return;
                }

                if (bermHeight == null || waterDepth == null || Number.isNaN(waterDepth)) {
                    freeboardInput.value = '';
                    freeboardInput.classList.remove('text-danger', 'fw-semibold');
                    return;
                }

                const freeboard = bermHeight - waterDepth;
                freeboardInput.value = Number.isFinite(freeboard) ? freeboard.toFixed(2) : '';
                const belowMinimum = minFreeboard != null && Number.isFinite(freeboard) && freeboard < minFreeboard;
                freeboardInput.classList.toggle('text-danger', belowMinimum);
                freeboardInput.classList.toggle('fw-semibold', belowMinimum);
            };

            const refreshCalculatedFields = (tr, row) => {
                row.applications.forEach(app => {
                    const sf = app.sprayfieldId;
                    const v = tr.querySelector(`input[data-app="volumeGallons"][data-sprayfield-id="${sf}"]`);
                    const h = tr.querySelector(`input[data-app="maximumHourlyLoadingInchesPerAcre"][data-sprayfield-id="${sf}"]`);
                    const d = tr.querySelector(`input[data-app="dailyLoadingInches"][data-sprayfield-id="${sf}"]`);
                    if (v) v.value = app.volumeGallons == null ? '' : Math.round(app.volumeGallons);
                    if (h) h.value = app.maximumHourlyLoadingInchesPerAcre ?? '';
                    if (d) d.value = app.dailyLoadingInches ?? '';
                });
            };

            const refreshRowFromResponse = (tr, row) => {
                tr.querySelector('select[data-field="weatherCode"]').value = row.weatherCode ?? '';
                syncWeatherIconState(tr.querySelector('select[data-field="weatherCode"]'));
                tr.querySelector('input[data-field="temperatureF"]').value = row.temperatureF ?? '';
                tr.querySelector('input[data-field="precipitationIn"]').value = row.precipitationIn ?? '';
                tr.querySelector('input[data-field="waterDepthFt"]').value = row.waterDepthFt ?? '';
                tr.querySelector('input[data-field="storageFt"]').value = row.storageFt ?? '';
                tr.querySelector('input[data-field="fiveDayUpsetFt"]').value = row.fiveDayUpsetFt ?? '';
                refreshLagoonFreeboard(tr);

                row.applications.forEach(app => {
                    const sf = app.sprayfieldId;
                    const v = tr.querySelector(`input[data-app="volumeGallons"][data-sprayfield-id="${sf}"]`);
                    const t = tr.querySelector(`input[data-app="timeIrrigatedMinutes"][data-sprayfield-id="${sf}"]`);
                    const h = tr.querySelector(`input[data-app="maximumHourlyLoadingInchesPerAcre"][data-sprayfield-id="${sf}"]`);
                    const d = tr.querySelector(`input[data-app="dailyLoadingInches"][data-sprayfield-id="${sf}"]`);
                    if (v) v.value = app.volumeGallons == null ? '' : Math.round(app.volumeGallons);
                    if (t) t.value = app.timeIrrigatedMinutes == null ? '' : Math.round(app.timeIrrigatedMinutes);
                    if (h) h.value = app.maximumHourlyLoadingInchesPerAcre ?? '';
                    if (d) d.value = app.dailyLoadingInches ?? '';
                });
            };

            const getRowState = (tr) => {
                const dayNo = Number(tr.dataset.day);
                if (!rowStates.has(dayNo)) {
                    rowStates.set(dayNo, {
                        lastSavedSignature: payloadSignature(collectRowPayload(tr)),
                        saveInFlight: false,
                        rescheduleAfterFlight: false,
                        debounceTimer: null
                    });
                }
                return rowStates.get(dayNo);
            };

            const isRowDirty = (tr) => {
                const state = getRowState(tr);
                return payloadSignature(collectRowPayload(tr)) !== state.lastSavedSignature;
            };

            const ensureRowLock = async (tr) => {
                if (tr.dataset.lockedByOther === 'true') return false;

                const tokenInput = tr.querySelector('.lock-token');
                if (tokenInput?.value) return true;

                const dayNo = Number(tr.dataset.day);
                try {
                    const resp = await fetch(`@Url.Action("NDAR1BeginRowEdit", "Reports")?ndar1Id=${ndar1Id}&dayNo=${dayNo}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': antiForgery }
                    });
                    const result = await tryReadJson(resp);
                    if (!resp.ok || !result?.success) {
                        tr.dataset.lockedByOther = 'true';
                        tr.querySelectorAll('.ndar-editable').forEach(el => { el.disabled = true; });
                        const badge = tr.querySelector('.lock-badge');
                        if (badge) {
                            badge.textContent = result?.message || result?.lockedBy || 'Locked';
                            badge.classList.remove('d-none');
                        }
                        setRowStatus(tr, 'locked', result?.message || 'Locked by another user');
                        if (result?.message) showError(result.message);
                        return false;
                    }
                    tokenInput.value = result.lockToken;
                    heldLockTokens.add(result.lockToken);
                    return true;
                } catch {
                    showError('Unable to acquire edit lock for this row.');
                    return false;
                }
            };

            const saveRow = async (tr, options = {}) => {
                if (tr.dataset.lockedByOther === 'true') return;
                if (!isRowDirty(tr) && !options.force) return;

                const state = getRowState(tr);
                if (state.saveInFlight) {
                    state.rescheduleAfterFlight = true;
                    return;
                }

                const hasLock = await ensureRowLock(tr);
                if (!hasLock) return;

                state.saveInFlight = true;
                setRowStatus(tr, 'saving', 'Saving...');

                const payload = collectRowPayload(tr, options);
                const sentSignature = payloadSignature(payload);
                let saveSucceeded = false;
                try {
                    const resp = await fetch(`@Url.Action("NDAR1UpdateRow", "Reports")?ndar1Id=${ndar1Id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiForgery
                        },
                        body: JSON.stringify(payload)
                    });
                    const result = await tryReadJson(resp);

                    if (!resp.ok || !result?.success) {
                        const message = result?.message || 'Unable to update the row right now. Please try again.';
                        setRowStatus(tr, 'error', message);
                        showError(message);
                        return;
                    }

                    saveSucceeded = true;
                    refreshCalculatedFields(tr, result.row);
                    state.lastSavedSignature = sentSignature;
                    recalcFooterTotals();
                    setRowStatus(tr, 'saved', 'Saved');
                    scheduleNdarRefresh();
                    scheduleStoredReportRefresh();

                    if (payload.lockToken) {
                        heldLockTokens.add(payload.lockToken);
                    }
                } catch {
                    setRowStatus(tr, 'error', 'Save failed');
                    showError('Unable to update the row right now. Please try again.');
                } finally {
                    state.saveInFlight = false;
                    if (saveSucceeded && (state.rescheduleAfterFlight || isRowDirty(tr))) {
                        state.rescheduleAfterFlight = false;
                        await saveRow(tr, options);
                    } else {
                        state.rescheduleAfterFlight = false;
                        if (saveSucceeded && !isRowDirty(tr)) {
                            setTimeout(() => {
                                if (!isRowDirty(tr)) setRowStatus(tr, 'idle', 'Ready');
                            }, 1500);
                        } else if (!saveSucceeded && isRowDirty(tr)) {
                            setRowStatus(tr, 'dirty', 'Unsaved changes');
                        }
                    }
                }
            };

            const cancelScheduledRowSave = (tr) => {
                const state = getRowState(tr);
                if (state.debounceTimer) {
                    clearTimeout(state.debounceTimer);
                    state.debounceTimer = null;
                }
            };

            const scheduleRowSave = (tr, options = {}) => {
                const state = getRowState(tr);
                cancelScheduledRowSave(tr);

                if (options.immediate) {
                    saveRow(tr, options);
                    return;
                }

                state.debounceTimer = setTimeout(() => {
                    state.debounceTimer = null;
                    saveRow(tr, options);
                }, ROW_SAVE_DEBOUNCE_MS);
            };

            const flushScheduledRowSave = async (tr, options = {}) => {
                cancelScheduledRowSave(tr);
                await saveRow(tr, { ...options, force: true });
            };

            const flushDirtyRows = async () => {
                const rows = [...grid.querySelectorAll('tbody tr[data-day]')];
                for (const tr of rows) {
                    cancelScheduledRowSave(tr);
                    if (isRowDirty(tr)) {
                        await saveRow(tr, { skipNdarRefresh: true, force: true });
                    }
                }
            };

            const releaseAllLocks = () => {
                const tokens = [...heldLockTokens];
                if (tokens.length === 0) return;

                fetch(`@Url.Action("NDAR1ReleaseGridEdit", "Reports")?ndar1Id=${ndar1Id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiForgery
                    },
                    body: JSON.stringify({ lockTokens: tokens }),
                    keepalive: true
                }).catch(() => { });

                heldLockTokens.clear();
            };

            const initializeGridLocks = async () => {
                try {
                    const resp = await fetch(`@Url.Action("NDAR1BeginGridEdit", "Reports")?ndar1Id=${ndar1Id}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': antiForgery }
                    });
                    const result = await tryReadJson(resp);
                    if (!resp.ok || !result?.locks) return;

                    result.locks.forEach(lock => {
                        const tr = grid.querySelector(`tr[data-day="${lock.dayNo}"]`);
                        if (!tr) return;

                        if (lock.success && lock.lockToken) {
                            tr.querySelector('.lock-token').value = lock.lockToken;
                            heldLockTokens.add(lock.lockToken);
                            return;
                        }

                        tr.dataset.lockedByOther = 'true';
                        tr.querySelectorAll('.ndar-editable').forEach(el => { el.disabled = true; });
                        const badge = tr.querySelector('.lock-badge');
                        if (badge) {
                            badge.textContent = lock.lockedBy || lock.message || 'Locked';
                            badge.classList.remove('d-none');
                        }
                        setRowStatus(tr, 'locked', lock.message || lock.lockedBy || 'Locked');
                    });
                } catch {
                    // Rows will acquire locks lazily on first edit.
                }
            };

            grid.addEventListener('focusin', (e) => {
                if (!e.target.classList?.contains('ndar-editable')) return;
                const tr = e.target.closest('tr[data-day]');
                if (!tr) return;

                if (activeEditRow && activeEditRow !== tr) {
                    flushScheduledRowSave(activeEditRow);
                }
                activeEditRow = tr;
            });

            grid.querySelectorAll('tbody tr[data-day]').forEach(tr => {
                getRowState(tr);

                tr.querySelectorAll('select[data-field="weatherCode"]').forEach(selectEl => {
                    syncWeatherIconState(selectEl);
                    selectEl.addEventListener('change', () => {
                        syncWeatherIconState(selectEl);
                        if (isRowDirty(tr)) {
                            setRowStatus(tr, 'dirty', 'Unsaved changes');
                            scheduleRowSave(tr);
                        }
                    });
                });

                tr.querySelectorAll('input.ndar-editable').forEach(inputEl => {
                    inputEl.addEventListener('input', () => {
                        if (inputEl.dataset.field === 'waterDepthFt') {
                            refreshLagoonFreeboard(tr);
                        }
                        if (isRowDirty(tr)) {
                            setRowStatus(tr, 'dirty', 'Unsaved changes');
                        }
                    });

                    inputEl.addEventListener('blur', () => {
                        if (isRowDirty(tr)) {
                            scheduleRowSave(tr);
                        }
                    });
                });

                refreshLagoonFreeboard(tr);
            });

            document.getElementById('ndarBackToDetails')?.addEventListener('click', async (e) => {
                if (isLeavingPage) return;
                e.preventDefault();
                isLeavingPage = true;
                cancelScheduledStoredReportRefresh();
                await flushDirtyRows();
                await refreshStoredNdarReport();
                await refreshFloatingTotals();
                releaseAllLocks();
                window.location.href = e.currentTarget.href;
            });

            window.addEventListener('beforeunload', () => {
                if (needsStoredReportRefresh && !storedReportRefreshPromise && !isLeavingPage) {
                    fetch(`@Url.Action("NDAR1RefreshStoredReport", "Reports")?ndar1Id=${ndar1Id}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': antiForgery },
                        keepalive: true
                    }).catch(() => { });
                }
                releaseAllLocks();
            });

            initializeGridLocks();
            recalcFooterTotals();

            SAM.gridKeyboardNavigation.init({
                root: grid,
                cellSelector: '.ndar-editable:not(:disabled)',
                rowSelector: 'tbody tr[data-day]',
                skipRow: (tr) => tr.dataset.lockedByOther === 'true'
            });
        })();
    </script>
}
