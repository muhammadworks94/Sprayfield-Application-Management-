@model SAM.ViewModels.Reports.NDAR1EditGridViewModel
@{
    ViewData["Title"] = "Edit NDAR-1 Report";
}

<div class="d-flex justify-content-between align-items-center mb-4 page-intro">
    <div>
        <p class="text-muted mb-0">Edit daily data for @Model.Month @Model.Year using shared Operator Logs and Monthly Applications records.</p>
    </div>
    <a asp-action="NDAR1ReportDetails" asp-route-id="@Model.NDAR1Id" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to Details
    </a>
</div>

<div class="card">
    <div class="card-body">
        @Html.AntiForgeryToken()
        <h5 class="mb-3">Daily Grid (Live Source)</h5>
        <p class="text-muted small">Each row updates the same underlying records used in Operations.</p>

        <div class="table-responsive responsive-table wide-data-table ndar-daily-table-wrapper fixed-height-table-wrapper">
            <table class="table table-bordered table-sm ndar-daily-table" id="ndarLiveGrid">
                <thead>
                    <tr>
                        <th>Day</th>
                        <th>Weather</th>
                        <th>Temp (F)</th>
                        <th>Precip (in)</th>
                        <th>Storage (ft)</th>
                        <th>5-Day Upset (ft)</th>
                        @foreach (var field in Model.FieldColumns)
                        {
                            <th>Field @field.FieldCode<br /><small>Vol (gal)</small></th>
                            <th>Field @field.FieldCode<br /><small>Time (min)</small></th>
                            <th>Field @field.FieldCode<br /><small>Max Hr (in/ac)</small></th>
                            <th>Field @field.FieldCode<br /><small>Daily Load (in)</small></th>
                        }
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr data-day="@row.DayNo" data-date="@row.Date.ToString("yyyy-MM-dd")">
                            <td><strong>@row.DayNo</strong></td>
                            <td><input class="form-control form-control-sm" data-field="weatherCode" value="@row.WeatherCode" disabled title="Click Edit for this row to modify values." /></td>
                            <td><input class="form-control form-control-sm" data-field="temperatureF" type="number" step="0.01" value="@row.TemperatureF" disabled title="Click Edit for this row to modify values." /></td>
                            <td><input class="form-control form-control-sm" data-field="precipitationIn" type="number" step="0.01" value="@row.PrecipitationIn" disabled title="Click Edit for this row to modify values." /></td>
                            <td><input class="form-control form-control-sm" data-field="storageFt" type="number" step="0.01" value="@row.StorageFt" disabled title="Click Edit for this row to modify values." /></td>
                            <td><input class="form-control form-control-sm" data-field="fiveDayUpsetFt" type="number" step="0.01" value="@row.FiveDayUpsetFt" disabled title="Click Edit for this row to modify values." /></td>
                            @foreach (var app in row.Applications)
                            {
                                <td><input class="form-control form-control-sm" data-app="volumeGallons" data-sprayfield-id="@app.SprayfieldId" type="number" step="0.01" value="@app.VolumeGallons" disabled title="Click Edit for this row to modify values." /></td>
                                <td><input class="form-control form-control-sm" data-app="timeIrrigatedMinutes" data-sprayfield-id="@app.SprayfieldId" type="number" step="0.01" value="@app.TimeIrrigatedMinutes" disabled title="Click Edit for this row to modify values." /></td>
                                <td><input class="form-control form-control-sm" data-app="maximumHourlyLoadingInchesPerAcre" data-sprayfield-id="@app.SprayfieldId" type="number" step="0.01" value="@app.MaximumHourlyLoadingInchesPerAcre" disabled title="Click Edit for this row to modify values." /></td>
                                <td><input class="form-control form-control-sm" data-app="dailyLoadingInches" data-sprayfield-id="@app.SprayfieldId" type="number" step="0.01" value="@app.DailyLoadingInches" disabled title="Calculated field (Volume / Acres). This value is read-only." /></td>
                            }
                            <td class="text-nowrap">
                                <span class="badge bg-warning text-dark d-none lock-badge"></span>
                                <button type="button" class="btn btn-sm btn-outline-primary row-edit-btn">Edit</button>
                                <button type="button" class="btn btn-sm btn-primary row-update-btn d-none">Update</button>
                                <button type="button" class="btn btn-sm btn-secondary row-cancel-btn d-none">Cancel</button>
                                <input type="hidden" class="lock-token" value="" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const ndar1Id = "@Model.NDAR1Id";
            const antiForgery = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const grid = document.getElementById('ndarLiveGrid');
            if (!grid) return;
            const defaultReadOnlyTitle = 'Click Edit for this row to modify values.';
            const calculatedReadOnlyTitle = 'Calculated field (Volume / Acres). This value is read-only.';
            const showError = (message) => {
                const safeMessage = message || 'Something went wrong. Please try again.';
                if (window.toastr) {
                    window.toastr.error(safeMessage);
                    return;
                }
                console.error(safeMessage);
            };
            const tryReadJson = async (response) => {
                try {
                    return await response.json();
                } catch {
                    return null;
                }
            };

            const setEditable = (tr, editable) => {
                tr.querySelectorAll('input[data-field], input[data-app]').forEach(i => {
                    if (i.dataset.app === 'dailyLoadingInches') {
                        i.disabled = true;
                        i.title = calculatedReadOnlyTitle;
                        return;
                    }
                    i.disabled = !editable;
                    i.title = editable ? '' : defaultReadOnlyTitle;
                });
                tr.querySelector('.row-edit-btn')?.classList.toggle('d-none', editable);
                tr.querySelector('.row-update-btn')?.classList.toggle('d-none', !editable);
                tr.querySelector('.row-cancel-btn')?.classList.toggle('d-none', !editable);
            };

            const collectRowPayload = (tr) => {
                const apps = {};
                tr.querySelectorAll('input[data-app]').forEach(i => {
                    const sprayfieldId = i.dataset.sprayfieldId;
                    const key = i.dataset.app;
                    if (!apps[sprayfieldId]) {
                        apps[sprayfieldId] = { sprayfieldId, volumeGallons: null, timeIrrigatedMinutes: null, maximumHourlyLoadingInchesPerAcre: null };
                    }
                    if (key === 'dailyLoadingInches') return;
                    const value = i.value.trim();
                    apps[sprayfieldId][key] = value === '' ? null : Number(value);
                });

                const numOrNull = selector => {
                    const raw = tr.querySelector(selector)?.value?.trim();
                    return raw === '' || raw == null ? null : Number(raw);
                };

                return {
                    dayNo: Number(tr.dataset.day),
                    lockToken: tr.querySelector('.lock-token').value,
                    weatherCode: tr.querySelector('input[data-field="weatherCode"]').value,
                    temperatureF: numOrNull('input[data-field="temperatureF"]'),
                    precipitationIn: numOrNull('input[data-field="precipitationIn"]'),
                    storageFt: numOrNull('input[data-field="storageFt"]'),
                    fiveDayUpsetFt: numOrNull('input[data-field="fiveDayUpsetFt"]'),
                    applications: Object.values(apps)
                };
            };

            const refreshRowFromResponse = (tr, row) => {
                tr.querySelector('input[data-field="weatherCode"]').value = row.weatherCode ?? '';
                tr.querySelector('input[data-field="temperatureF"]').value = row.temperatureF ?? '';
                tr.querySelector('input[data-field="precipitationIn"]').value = row.precipitationIn ?? '';
                tr.querySelector('input[data-field="storageFt"]').value = row.storageFt ?? '';
                tr.querySelector('input[data-field="fiveDayUpsetFt"]').value = row.fiveDayUpsetFt ?? '';

                row.applications.forEach(app => {
                    const sf = app.sprayfieldId;
                    const v = tr.querySelector(`input[data-app="volumeGallons"][data-sprayfield-id="${sf}"]`);
                    const t = tr.querySelector(`input[data-app="timeIrrigatedMinutes"][data-sprayfield-id="${sf}"]`);
                    const h = tr.querySelector(`input[data-app="maximumHourlyLoadingInchesPerAcre"][data-sprayfield-id="${sf}"]`);
                    const d = tr.querySelector(`input[data-app="dailyLoadingInches"][data-sprayfield-id="${sf}"]`);
                    if (v) v.value = app.volumeGallons ?? '';
                    if (t) t.value = app.timeIrrigatedMinutes ?? '';
                    if (h) h.value = app.maximumHourlyLoadingInchesPerAcre ?? '';
                    if (d) d.value = app.dailyLoadingInches ?? '';
                });
            };

            grid.addEventListener('click', async e => {
                const tr = e.target.closest('tr[data-day]');
                if (!tr) return;

                if (e.target.classList.contains('row-edit-btn')) {
                    const dayNo = Number(tr.dataset.day);
                    const resp = await fetch(`@Url.Action("NDAR1BeginRowEdit", "Reports")?ndar1Id=${ndar1Id}&dayNo=${dayNo}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': antiForgery }
                    });
                    const result = await tryReadJson(resp);
                    if (!resp.ok || !result) {
                        showError('Unable to start editing this row right now. Please try again.');
                        return;
                    }
                    if (!result.success) {
                        const badge = tr.querySelector('.lock-badge');
                        badge.textContent = result.message || 'Locked';
                        badge.classList.remove('d-none');
                        const editBtn = tr.querySelector('.row-edit-btn');
                        if (editBtn && result.message) {
                            editBtn.title = result.message;
                        }
                        if (result.message) {
                            showError(result.message);
                        }
                        return;
                    }
                    tr.querySelector('.lock-token').value = result.lockToken;
                    tr.querySelector('.lock-badge').classList.add('d-none');
                    setEditable(tr, true);
                }

                if (e.target.classList.contains('row-update-btn')) {
                    const payload = collectRowPayload(tr);
                    const resp = await fetch(`@Url.Action("NDAR1UpdateRow", "Reports")?ndar1Id=${ndar1Id}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': antiForgery
                        },
                        body: JSON.stringify(payload)
                    });
                    const result = await tryReadJson(resp);
                    if (!resp.ok) {
                        if (resp.status === 409 && result?.message) {
                            showError(result.message);
                        } else {
                            showError('Unable to update the row right now. Please try again.');
                        }
                        return;
                    }
                    if (!result) {
                        showError('Unable to update the row right now. Please try again.');
                        return;
                    }
                    if (!result.success) {
                        showError(result.message || 'Unable to update row.');
                        return;
                    }
                    refreshRowFromResponse(tr, result.row);
                    tr.querySelector('.lock-token').value = '';
                    setEditable(tr, false);
                }

                if (e.target.classList.contains('row-cancel-btn')) {
                    const dayNo = Number(tr.dataset.day);
                    const lockToken = tr.querySelector('.lock-token').value;
                    await fetch(`@Url.Action("NDAR1CancelRowEdit", "Reports")?ndar1Id=${ndar1Id}&dayNo=${dayNo}&lockToken=${lockToken}`, {
                        method: 'POST',
                        headers: { 'RequestVerificationToken': antiForgery }
                    });
                    tr.querySelector('.lock-token').value = '';
                    setEditable(tr, false);
                }
            });
        })();
    </script>
}
